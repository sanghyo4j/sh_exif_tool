    in-out property <string> shift_media_date_days: "0";
    in-out property <string> shift_media_date_hours: "0";
    in-out property <string> shift_media_date_minutes: "0";
    in-out property <string> shift_media_date_seconds: "0";
    in-out property <string> shift_media_date_preview: "";
