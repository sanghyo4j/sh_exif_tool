import { VerticalBox, HorizontalBox, ScrollView, ListView, Button, LineEdit } from "std-widgets.slint";

// --- 공용 컴포넌트 ---
component HDivider inherits Rectangle {
    background: #e0e0e0;
    height: 1px;
    width: 100%;
}

component VDivider inherits Rectangle {
    background: #d0d0d0;
    width: 1px;
    height: 100%;
}

// 섹션 헤더 (그룹 구분용)
component SectionHeader inherits Rectangle {
    in property <string> title;
    height: 35px;
    background: #f9f9f9; // 아주 살짝만 변화를 준 헤더 배경
    HorizontalBox {
        padding-left: 12px;
        Text {
            text: title;
            font-size: 12px;
            font-weight: 800;
            color: #555555; // 헤더는 약간 차분하게
            vertical-alignment: center;
        }
    }
    HDivider { y: parent.height - 1px; }
}

// 정보 행 (Key-Value 쌍)
component InfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 28px;
    HorizontalBox {
        padding-left: 15px;
        padding-right: 15px;
        spacing: 10px;
        Text {
            text: label;
            width: 110px; // 라벨 영역 너비 고정
            color: #777777;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: value;
            horizontal-stretch: 1;
            color: #222222;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Rectangle { // 행 하단 구분선
        y: parent.height - 1px;
        height: 1px;
        background: #f0f0f0;
    }
}

component EditableInfoRow inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    height: 38px;
    background: #ffffff;
    HorizontalBox {
        padding-left: 15px; padding-right: 15px; spacing: 10px;
        Text {
            text: label;
            width: 100px;
            color: #333333; // 화이트 배경에서 잘 보이는 진한 회색
            font-size: 12px;
            vertical-alignment: center;
        }
        LineEdit {
            text: value;
            horizontal-stretch: 1;
            font-size: 13px;
            // LineEdit 내부 텍스트 색상은 Slint 기본(검정 계열)을 따름
        }
    }
    HDivider { y: parent.height - 1px; background: #f0f0f0; } // 행 간의 아주 연한 구분선
}

export struct FileEntry {
    name: string,
    size: string,
    modified: string,
    created: string,
    is_dir: bool,
}

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: #ffffff;
    title: "Rust EXIF Tool";
    
    in-out property <string> current_path: "C:/";
    in-out property <[FileEntry]> files;
    in-out property <int> selected_index: -1;
    in-out property <bool> editing_path: false;

    // EXIF 관련 상태 (임시)
    in property <bool> has_exif: selected_index >= 0 ? true : false; 

    callback open_dir(int);
    callback reload();
    callback go_parent();
    callback change_dir(string);
    callback apply_changes();
    callback cancel_changes();

    // 1. [메인 레이어]
    VerticalBox {
        padding: 0;
        spacing: 0;

        // 메뉴 바
        Rectangle {
            height: 32px;
            background: #ffffff;
            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 20px;
                alignment: start;
                Text { text: "파일(F)"; font-size: 13px; color: #333333; vertical-alignment: center; }
                Text { text: "보기(V)"; font-size: 13px; color: #333333; vertical-alignment: center; }
                Text { text: "도구(T)"; font-size: 13px; color: #333333; vertical-alignment: center; }
                Text { text: "도움말(H)"; font-size: 13px; color: #333333; vertical-alignment: center; }
            }
        }
        HDivider {}

        // 경로바 공간 확보
        Rectangle { height: 40px; }

        // 콘텐츠 영역
        HorizontalBox {
            padding: 0;
            spacing: 0;

            // 왼쪽: 파일 리스트
            VerticalBox {
                width: 750px;
                padding: 0;
                spacing: 0;

                Rectangle {
                    height: 30px;
                    background: #f5f5f5;
                    Text { x: 15px; width: 380px; text: "파일명"; font-weight: 700; color: #666666; vertical-alignment: center; height: 100%; }
                    Text { x: 410px; width: 80px; text: "크기"; font-weight: 700; color: #666666; horizontal-alignment: right; vertical-alignment: center; height: 100%; }
                    Text { x: 510px; text: "수정일"; font-weight: 700; color: #666666; vertical-alignment: center; height: 100%; }
                    HDivider { y: 29px; }
                }

                ListView {
                    for entry[i] in files : Rectangle {
                        height: 32px;
                        background: i == selected_index ? #e3f2fd : #ffffff;
                        TouchArea {
                            width: 100%; height: 100%;
                            clicked => { selected_index = i; }
                            double-clicked => { 
                                if (entry.name == "[..]") { root.go_parent(); } 
                                else if (entry.is_dir) { root.open_dir(i); } 
                            }
                            // ... 텍스트 렌더링 부분 (기존과 동일)
                            HorizontalBox {
                                padding-left: 15px; padding-right: 15px;
                                Text { width: 380px; text: entry.is_dir ? (entry.name == "[..]" ? "⬅ " + entry.name : "📁 " + entry.name) : "📄 " + entry.name; vertical-alignment: center; color: i == selected_index ? #1976d2 : #212121; }
                                Text { width: 80px; text: entry.size; horizontal-alignment: right; vertical-alignment: center; color: #666666; }
                                Rectangle { width: 20px; } // 간격
                                Text { text: entry.modified; vertical-alignment: center; color: #666666; }
                            }
                        }
                    }
                }
            }
            
            // [구분선: 더 확실하게]
            Rectangle {
                width: 2px;
                background: #d0d0d0;
            }

            // [우측: EXIF 에디터 패널]
            Rectangle {
                horizontal-stretch: 1;
                background: #fcfcfc; // 리스트(흰색)와 대비되는 아주 연한 회색
                
                VerticalBox {
                    padding: 0; spacing: 0;
                    
                    // 에디터 타이틀
                    Rectangle {
                        height: 50px;
                        background: #f0f0f0;
                        Text { 
                            x: 20px; 
                            text: selected_index >= 0 ? "태그 편집: " + files[selected_index].name : "파일을 선택하세요";
                            font-size: 14px; font-weight: 800; vertical-alignment: center; 
                        }
                        HDivider { y: parent.height - 1px; }
                    }

                    ScrollView {
                        VerticalBox {
                            padding: 10px; spacing: 0; alignment: start;
                            
                            if (selected_index >= 0) : VerticalBox {
                                padding: 0; spacing: 5px;

                                SectionHeader { title: "파일 기본 정보"; }
                                EditableInfoRow { label: "파일명"; value: files[selected_index].name; }
                                EditableInfoRow { label: "만든 날짜"; value: files[selected_index].created; }
                                EditableInfoRow { label: "수정한 날짜"; value: files[selected_index].modified; }

                                SectionHeader { title: "핵심 EXIF 태그"; }
                                EditableInfoRow { label: "촬영 날짜"; value: "-"; }
                                EditableInfoRow { label: "카메라 모델"; value: "-"; }
                                EditableInfoRow { label: "렌즈 모델"; value: "-"; }
                                EditableInfoRow { label: "작가(Artist)"; value: "-"; }
                                EditableInfoRow { label: "소프트웨어"; value: "-"; }

                                SectionHeader { title: "촬영 파라미터"; }
                                EditableInfoRow { label: "노출 시간"; value: "-"; }
                                EditableInfoRow { label: "조리개"; value: "-"; }
                                EditableInfoRow { label: "ISO"; value: "-"; }
                                EditableInfoRow { label: "초점 거리"; value: "-"; }
                            }
                        }
                    }

                    // [하단 액션 버튼 영역]
                    if (selected_index >= 0) : Rectangle {
                        height: 60px;
                        background: #f0f0f0;

                        HorizontalBox {
                            padding: 15px;
                            spacing: 15px;
                            alignment: end;
                            Button {
                                text: "변경내용 취소";
                                clicked => { root.cancel_changes(); }
                            }
                            Button {
                                text: "변경내용 적용";
                                primary: true; // Slint 기본 테마에서 강조됨
                                clicked => { root.apply_changes(); }
                            }
                        }
                    }
                }
            }

        }
    }

    // 2. [가림막] (생략 - 기존과 동일)
    if (editing_path) : TouchArea {
        clicked => {
            editing_path = false;
        }
    }

    // 3. [상단 경로바] (생략 - 기존과 동일)
    Rectangle {
        y: 33px; 
        height: 40px;
        background: #fcfcfc;
        
        HorizontalBox {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;

            Text { 
                text: "경로:"; 
                vertical-alignment: center; 
                color: #666666; 
                font-weight: 700;
                width: 40px;
            }
            
            Rectangle {
                horizontal-stretch: 1;

                // 보기 모드
                if !editing_path : TouchArea {
                    width: 100%; height: 100%;
                    clicked => { 
                        editing_path = true;
                    }
                    Text {
                        // 핵심 1: Text 위젯 자체를 부모 너비만큼 꽉 채웁니다.
                        width: 100%; 
                        height: 100%;
                        
                        // 핵심 2: 넓어진 너비 안에서 왼쪽 정렬을 수행합니다.
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        
                        text: current_path;
                        font-size: 13px;
                        color: #333333;
                        
                        // 핵심 3: "경로:" 글자와 너무 붙지 않게 왼쪽 여백을 줍니다.
                        x: 5px; 
                    }
                }

                // 편집 모드 (LineEdit은 기본적으로 왼쪽 정렬이므로 그대로 둡니다)
                if editing_path : LineEdit {
                    width: 100%;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    text: current_path;
                    font-size: 13px;
                    init => { self.focus(); }

                    accepted(new_path) => {
                        current_path = new_path; // 1. UI 내부 경로 값 업데이트
                        editing_path = false;    // 2. 편집 모드 종료
                        root.change_dir(new_path); // 3. ★ 핵심: Rust 백엔드에 변경 알림
                    }
                }
            }
        }
        HDivider { y: parent.height - self.height; }
    }
}