import { VerticalBox, HorizontalBox, ListView, Button, LineEdit } from "std-widgets.slint";

component HDivider inherits Rectangle {
    background: #e0e0e0;
    height: 1px;
    width: 100%;
}

component VDivider inherits Rectangle {
    background: #e0e0e0;
    width: 1px;
    height: 100%;
}

export struct FileEntry {
    name: string,
    size: string,
    modified: string,
    created: string,
    is_dir: bool,
}

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: #ffffff;
    title: "Rust EXIF Tool";
    
    in-out property <string> current_path: "C:/";
    in-out property <[FileEntry]> files;
    in-out property <int> selected_index: -1;

    callback open_dir(int);
    callback reload();
    callback go_parent();

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 1. 최상단 메뉴 바
        Rectangle {
            height: 25px;
            background: #ffffff;
            HorizontalBox {
                padding-left: 10px;
                spacing: 15px;
                alignment: start;
                Text { text: "파일(F)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "보기(V)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "도구(T)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "도움말(H)"; font-size: 12px; color: #333333; vertical-alignment: center; }
            }
        }
        HDivider {}

// 2. 경로 표시줄 (초기 텍스트 출력 방식)
        Rectangle {
            height: 40px; 
            background: #fcfcfc;
            
            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                alignment: start;

                Text { 
                    text: "경로:"; 
                    vertical-alignment: center; 
                    color: #666666; 
                    font-weight: 700;
                }
                
                // 단순 텍스트 출력
                Text {
                    text: current_path;
                    vertical-alignment: center;
                    font-size: 13px;
                    color: #333333;
                }
            }
            HDivider { y: 39px; }
        }
        HDivider {}

        // 3. 메인 콘텐츠
        HorizontalBox {
            padding: 0;
            spacing: 0;

            // [좌측] 탐색기 영역
            VerticalBox {
                width: 750px;
                padding: 0;
                spacing: 0;

                // 리스트 헤더
                Rectangle {
                    height: 30px;
                    background: #f5f5f5;
                    Text { x: 15px; width: 380px; text: "파일명"; font-weight: 700; color: #666666; vertical-alignment: center; height: 100%; }
                    Text { x: 410px; width: 80px; text: "크기"; font-weight: 700; color: #666666; horizontal-alignment: right; vertical-alignment: center; height: 100%; }
                    Text { x: 510px; text: "수정일"; font-weight: 700; color: #666666; vertical-alignment: center; height: 100%; }
                    HDivider { y: 29px; }
                }

                // 파일 리스트
                ListView {
                    for entry[i] in files : Rectangle {
                        height: 32px;
                        background: i == selected_index ? #e3f2fd : #ffffff;

                        TouchArea {
                            width: 100%; height: 100%;
                            clicked => { selected_index = i; }
                            double-clicked => { 
                                if (entry.name == "[..]") { root.go_parent(); } 
                                else if (entry.is_dir) { root.open_dir(i); } 
                            }

                            Rectangle {
                                Text { 
                                    x: 15px; width: 380px; 
                                    text: entry.is_dir ? (entry.name == "[..]" ? "⬅ " + entry.name : "📁 " + entry.name) : "📄 " + entry.name;
                                    color: i == selected_index ? #1976d2 : #212121;
                                    vertical-alignment: center; height: 100%;
                                }
                                Text { 
                                    x: 410px; width: 80px; 
                                    text: entry.size; 
                                    horizontal-alignment: right; 
                                    color: #666666; 
                                    vertical-alignment: center; height: 100%;
                                }
                                Text { 
                                    x: 510px; 
                                    text: entry.modified; 
                                    color: #666666; 
                                    vertical-alignment: center; height: 100%;
                                }
                            }
                        }
                    }
                }
            }

            VDivider {}

            // [우측] 상세 정보 영역
            Rectangle {
                background: #ffffff;
                VerticalBox {
                    padding: 30px;
                    spacing: 20px;
                    alignment: start;

                    Text {
                        text: "파일 정보";
                        font-size: 18px;
                        font-weight: 800;
                        color: #333333;
                    }

                    if selected_index >= 0 : VerticalBox {
                        padding: 0;
                        spacing: 10px;
                        Text { text: "파일명: " + files[selected_index].name; font-size: 14px; }
                        Text { text: "크기: " + files[selected_index].size; font-size: 14px; }
                        Text { text: "수정일: " + files[selected_index].modified; font-size: 14px; }
                        
                        Rectangle { height: 20px; } 
                        Text { text: "EXIF 데이터"; font-weight: 700; color: #666666; }
                        Text { text: "촬영 날짜: -"; color: #888888; }
                        Text { text: "카메라: -"; color: #888888; }
                    }

                    if selected_index < 0 : Text {
                        text: "파일을 선택하면 상세 정보가 표시됩니다.";
                        color: #999999;
                    }
                }
            }
        }
    }
}