import { Button, HorizontalBox, Palette } from "std-widgets.slint";
import { FileEntry } from "types.slint";
import { HDivider, StrongVDivider } from "components/dividers.slint";
import { PathBar } from "components/path_bar.slint";
import { FileTable } from "components/file_table.slint";
import { CustomFileTable } from "components/custom_file_table.slint";
import { MetadataPanel } from "components/metadata_panel.slint";
import { FontSettings } from "theme.slint";

export { FileEntry, Palette, FontSettings }

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: #ffffff;
    default-font-family: "Malgun Gothic";
    default-font-size: 10pt;
    title: "Rust EXIF Tool";

    in-out property <string> current_path: "C:/";
    in-out property <[FileEntry]> files;
    in-out property <[[StandardListViewItem]]> table_rows;
    in-out property <int> selected_index: -1;
    in-out property <bool> editing_path: false;
    in-out property <string> selected_name: "N/A";
    in-out property <string> selected_created: "N/A";
    in-out property <string> selected_modified: "N/A";
    in-out property <bool> selected_is_dir: false;
    in-out property <int> item_count: 0;
    in-out property <string> taken_date: "";
    in-out property <string> camera_make: "";
    in-out property <string> camera_model: "";
    in-out property <string> lens_model: "";
    in-out property <string> software: "";
    in-out property <string> artist: "";
    in-out property <string> shutter_speed: "";
    in-out property <string> aperture: "";
    in-out property <string> iso_speed: "";
    in-out property <string> focal_length: "";
    in-out property <string> flash_fired: "";
    in-out property <string> metering_mode: "";
    in-out property <string> image_width: "";
    in-out property <string> image_height: "";
    in-out property <string> orientation: "";
    in-out property <string> color_space: "";
    in-out property <string> gps_latitude: "";
    in-out property <string> gps_longitude: "";
    in-out property <string> gps_altitude: "";
    in-out property <string> original_selected_name: "N/A";
    in-out property <string> original_selected_created: "N/A";
    in-out property <string> original_selected_modified: "N/A";
    in-out property <string> original_taken_date: "";
    in-out property <string> original_camera_make: "";
    in-out property <string> original_camera_model: "";
    in-out property <string> original_lens_model: "";
    in-out property <string> original_software: "";
    in-out property <string> original_artist: "";
    in-out property <string> original_shutter_speed: "";
    in-out property <string> original_aperture: "";
    in-out property <string> original_iso_speed: "";
    in-out property <string> original_focal_length: "";
    in-out property <string> original_flash_fired: "";
    in-out property <string> original_metering_mode: "";
    in-out property <string> original_image_width: "";
    in-out property <string> original_image_height: "";
    in-out property <string> original_orientation: "";
    in-out property <string> original_color_space: "";
    in-out property <string> original_gps_latitude: "";
    in-out property <string> original_gps_longitude: "";
    in-out property <string> original_gps_altitude: "";
    in-out property <bool> exif_available: false;
    in-out property <bool> metadata_dirty: false;
    in-out property <bool> selected_name_dirty: false;
    in-out property <bool> selected_created_dirty: false;
    in-out property <bool> selected_modified_dirty: false;
    in-out property <bool> taken_date_dirty: false;
    in-out property <bool> camera_make_dirty: false;
    in-out property <bool> camera_model_dirty: false;
    in-out property <bool> lens_model_dirty: false;
    in-out property <bool> software_dirty: false;
    in-out property <bool> artist_dirty: false;
    in-out property <bool> shutter_speed_dirty: false;
    in-out property <bool> aperture_dirty: false;
    in-out property <bool> iso_speed_dirty: false;
    in-out property <bool> focal_length_dirty: false;
    in-out property <bool> flash_fired_dirty: false;
    in-out property <bool> metering_mode_dirty: false;
    in-out property <bool> image_width_dirty: false;
    in-out property <bool> image_height_dirty: false;
    in-out property <bool> orientation_dirty: false;
    in-out property <bool> color_space_dirty: false;
    in-out property <bool> gps_latitude_dirty: false;
    in-out property <bool> gps_longitude_dirty: false;
    in-out property <bool> gps_altitude_dirty: false;
    in-out property <bool> message_visible: false;
    in-out property <string> message_title: "Operation Failed";
    in-out property <string> message_text: "";
    in-out property <bool> confirm_delete_visible: false;
    in-out property <bool> file_context_menu_visible: false;

    callback open_dir(int);
    callback reload();
    callback go_parent();
    callback change_dir(string);
    callback save_copy();
    callback duplicate_file();
    callback delete_file();
    callback confirm_delete_file();
    callback open_in_explorer();
    callback exit_app();
    callback apply_changes();
    callback revert_changes();
    callback remove_exif_tags();
    callback fill_taken_date_from_filename();
    callback metadata_value_edited();
    callback table_row_clicked(int);
    callback table_row_selected(int, bool, bool);

    MenuBar {
        Menu {
            title: "&File";

            MenuItem {
                title: "&Save Copy";
                enabled: root.selected_index >= 0 && !root.selected_is_dir;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.save_copy();
                }
            }
            MenuItem {
                title: "&Delete File";
                enabled: root.selected_index >= 0 && !root.selected_is_dir;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.confirm_delete_visible = true;
                    root.message_title = "Delete File";
                    root.message_text = "Move \"" + root.selected_name + "\" to the Recycle Bin?";
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "&Apply (Ctrl+S)";
                enabled: root.metadata_dirty;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.apply_changes();
                }
            }
            MenuItem {
                title: "&Revert (Ctrl+R)";
                enabled: root.metadata_dirty;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.revert_changes();
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Open in Explore&r (Alt+Shift+R)";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.open_in_explorer();
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "E&xit (Ctrl+W)";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.exit_app();
                }
            }
        }

        Menu {
            title: "A&nalyze";

            MenuItem { title: "&Analyze Selected"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "Analyze &Folder"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "Analyze &Missing Metadata"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "&Clear Results"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
        }

        Menu {
            title: "&View";

            MenuItem {
                title: "Increase Font Size";
                enabled: FontSettings.font_size_pt < 15;
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = min(15, FontSettings.font_size_pt + 1);
                    root.editing_path = false;
                }
            }
            MenuItem {
                title: "Decrease Font Size";
                enabled: FontSettings.font_size_pt > 6;
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = max(6, FontSettings.font_size_pt - 1);
                    root.editing_path = false;
                }
            }
            MenuItem {
                title: "Default Font Size";
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = 10;
                    root.editing_path = false;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Font Family: " + FontSettings.font_family;
                enabled: false;
            }
        }

        Menu {
            title: "&Settings";

            MenuItem { title: "&Date Source Priority..."; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "&Filename Patterns..."; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "&Write Software Tag"; checkable: true; checked: true; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "&Rename With _SH148 Suffix"; checkable: true; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "&Backup Before Changes"; checkable: true; checked: true; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
        }

        Menu {
            title: "&Help";

            MenuItem { title: "&About"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
        }
    }

    HDivider { y: 0px; }

    PathBar {
        y: 1px;
        width: 100%;
        current_path: root.current_path;
        editing <=> root.editing_path;
        change_dir(path) => { root.change_dir(path); }
        open_folder() => { root.editing_path = true; }
        reload() => {
            root.editing_path = false;
            root.reload();
        }
    }

    content_focus := FocusScope {
        y: 41px;
        width: 100%;
        height: root.height - 67px;

        init => {
            self.focus();
        }

        key-pressed(event) => {
            if (root.message_visible || root.confirm_delete_visible) {
                return reject;
            }

            if (event.text == Key.F5) {
                root.editing_path = false;
                root.reload();
                return accept;
            }

            if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) {
                root.editing_path = true;
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) {
                root.editing_path = false;
                root.open_in_explorer();
                return accept;
            }

            if ((event.text == "S" || event.text == "s") && event.modifiers.control) {
                root.editing_path = false;
                content_focus.focus();
                root.apply_changes();
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) {
                root.editing_path = false;
                root.revert_changes();
                return accept;
            }

            if ((event.text == "W" || event.text == "w") && event.modifiers.control) {
                root.editing_path = false;
                root.exit_app();
                return accept;
            }

            reject
        }

        Rectangle {
            width: 100%;
            height: 100%;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 750px;
            height: 100%;

            file_table := CustomFileTable {
                width: 100%;
                height: 100%;
                files: root.files;
                selected_index <=> root.selected_index;
                context_menu_visible <=> root.file_context_menu_visible;
                row_selected(index, ctrl, shift) => {
                    root.editing_path = false;
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                    if (index >= 0 && index < root.files.length) {
                        root.selected_name = root.files[index].name;
                        root.selected_created = root.files[index].created;
                        root.selected_modified = root.files[index].modified;
                        root.original_selected_name = root.files[index].name;
                        root.original_selected_created = root.files[index].created;
                        root.original_selected_modified = root.files[index].modified;
                        root.selected_is_dir = root.files[index].is_dir;
                    }
                    root.table_row_selected(index, ctrl, shift);
                }
                row_clicked(index) => {
                    root.table_row_clicked(index);
                }
                row_activated(index) => {
                    root.open_dir(index);
                }
                rename_requested(index) => {
                    root.selected_index = index;
                    metadata_panel.focus_file_name();
                }
                reload_requested() => {
                    root.editing_path = false;
                    root.reload();
                }
                duplicate_requested() => {
                    root.editing_path = false;
                    if (root.selected_index >= 0 && !root.selected_is_dir) {
                        root.duplicate_file();
                    }
                }
                delete_requested() => {
                    root.editing_path = false;
                    if (root.selected_index >= 0 && !root.selected_is_dir) {
                        root.confirm_delete_visible = true;
                        root.message_title = "Delete File";
                        root.message_text = "Move \"" + root.selected_name + "\" to the Recycle Bin?";
                    }
                }
                open_folder_requested() => {
                    root.editing_path = true;
                }
                open_in_file_manager_requested() => {
                    root.editing_path = false;
                    root.open_in_explorer();
                }
                apply_requested() => {
                    root.editing_path = false;
                    content_focus.focus();
                    root.apply_changes();
                }
                revert_requested() => {
                    root.editing_path = false;
                    root.revert_changes();
                }
                exit_requested() => {
                    root.editing_path = false;
                    root.exit_app();
                }
            }
        }

        StrongVDivider {
            x: 750px;
            y: 0px;
            height: 100%;
        }

        metadata_panel := MetadataPanel {
                x: 756px;
                y: 0px;
                width: max(320px, root.width - 756px);
                height: 100%;
                selected_name <=> root.selected_name;
                selected_created <=> root.selected_created;
                selected_modified <=> root.selected_modified;
                taken_date <=> root.taken_date;
                camera_make <=> root.camera_make;
                camera_model <=> root.camera_model;
                lens_model <=> root.lens_model;
                software <=> root.software;
                artist <=> root.artist;
                shutter_speed <=> root.shutter_speed;
                aperture <=> root.aperture;
                iso_speed <=> root.iso_speed;
                focal_length <=> root.focal_length;
                flash_fired <=> root.flash_fired;
                metering_mode <=> root.metering_mode;
                image_width <=> root.image_width;
                image_height <=> root.image_height;
                orientation <=> root.orientation;
                color_space <=> root.color_space;
                gps_latitude <=> root.gps_latitude;
                gps_longitude <=> root.gps_longitude;
                gps_altitude <=> root.gps_altitude;
                exif_available <=> root.exif_available;
                has_pending_changes <=> root.metadata_dirty;
                selected_name_dirty <=> root.selected_name_dirty;
                selected_created_dirty <=> root.selected_created_dirty;
                selected_modified_dirty <=> root.selected_modified_dirty;
                taken_date_dirty <=> root.taken_date_dirty;
                camera_make_dirty <=> root.camera_make_dirty;
                camera_model_dirty <=> root.camera_model_dirty;
                lens_model_dirty <=> root.lens_model_dirty;
                software_dirty <=> root.software_dirty;
                artist_dirty <=> root.artist_dirty;
                shutter_speed_dirty <=> root.shutter_speed_dirty;
                aperture_dirty <=> root.aperture_dirty;
                iso_speed_dirty <=> root.iso_speed_dirty;
                focal_length_dirty <=> root.focal_length_dirty;
                flash_fired_dirty <=> root.flash_fired_dirty;
                metering_mode_dirty <=> root.metering_mode_dirty;
                image_width_dirty <=> root.image_width_dirty;
                image_height_dirty <=> root.image_height_dirty;
                orientation_dirty <=> root.orientation_dirty;
                color_space_dirty <=> root.color_space_dirty;
                gps_latitude_dirty <=> root.gps_latitude_dirty;
                gps_longitude_dirty <=> root.gps_longitude_dirty;
                gps_altitude_dirty <=> root.gps_altitude_dirty;
                apply_changes() => {
                    root.editing_path = false;
                    root.apply_changes();
                }
                revert_changes() => {
                    root.editing_path = false;
                    root.revert_changes();
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                }
                duplicate_file() => {
                    root.editing_path = false;
                    root.duplicate_file();
                }
                fill_taken_date_from_filename() => {
                    root.editing_path = false;
                    root.fill_taken_date_from_filename();
                }
                remove_exif_tags() => {
                    root.editing_path = false;
                    root.remove_exif_tags();
                }
                metadata_edited() => {
                    root.metadata_value_edited();
                }
                shortcut_requested(action) => {
                    if (action == "refresh") {
                        root.editing_path = false;
                        root.reload();
                    } else if (action == "open-folder") {
                        root.editing_path = true;
                    } else if (action == "open-explorer") {
                        root.editing_path = false;
                        root.open_in_explorer();
                    } else if (action == "save") {
                        root.editing_path = false;
                        metadata_panel.clear_editor_focus();
                        root.apply_changes();
                    } else if (action == "revert") {
                        root.editing_path = false;
                        root.revert_changes();
                    } else if (action == "exit") {
                        root.editing_path = false;
                        root.exit_app();
                    }
                }
        }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        y: 1px;
        width: 100%;
        height: 40px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        x: 750px;
        y: 41px;
        width: root.width - 750px;
        height: root.height - 67px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        y: root.height - 26px;
        width: 100%;
        height: 26px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if message_visible || confirm_delete_visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        forward-focus: modal_focus;

        init => {
            modal_focus.focus();
        }

        modal_focus := FocusScope {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;

            capture-key-pressed(event) => {
                if (!root.confirm_delete_visible && (event.text == Key.Return || event.text == " ")) {
                    root.message_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    return accept;
                }

                if (!root.confirm_delete_visible && event.text == Key.Escape) {
                    root.message_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    return accept;
                }

                if (root.confirm_delete_visible && event.text == Key.Escape) {
                    root.confirm_delete_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    return accept;
                }

                if (root.confirm_delete_visible && event.text == Key.Return) {
                    root.confirm_delete_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    root.confirm_delete_file();
                    return accept;
                }

                accept
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(420px, root.width - 48px);
            height: 150px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cfd8dc;
            border-radius: 6px;

            Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                height: 28px;
                text: root.message_title;
                color: #263238;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                x: 20px;
                y: 56px;
                width: parent.width - 40px;
                height: 40px;
                text: root.message_text;
                color: #37474f;
                font-size: FontSettings.font_size_pt * 1pt;
                wrap: word-wrap;
            }

            if !confirm_delete_visible: Rectangle {
                x: parent.width - 92px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: ok_touch.has-hover ? #eaf4ff : #ffffff;
                border-width: 1px;
                border-color: #b8c2cc;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "OK";
                    color: #1f2933;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ok_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.message_visible = false;
                            root.message_title = "Operation Failed";
                            root.message_text = "";
                        }
                    }
                }
            }

            if confirm_delete_visible: Rectangle {
                x: parent.width - 172px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: no_touch.has-hover ? #f3f6f8 : #ffffff;
                border-width: 1px;
                border-color: #b8c2cc;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "No";
                    color: #1f2933;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                no_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.confirm_delete_visible = false;
                            root.message_title = "Operation Failed";
                            root.message_text = "";
                        }
                    }
                }
            }

            if confirm_delete_visible: Rectangle {
                x: parent.width - 92px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: yes_touch.has-hover ? #fff1f1 : #ffffff;
                border-width: 1px;
                border-color: #d99a9a;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "Yes";
                    color: #b42318;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                yes_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.confirm_delete_visible = false;
                            root.message_title = "Operation Failed";
                            root.message_text = "";
                            root.confirm_delete_file();
                        }
                    }
                }
            }
        }
    }

    HDivider { y: root.height - 27px; }

    Rectangle {
        y: root.height - 26px;
        width: 100%;
        height: 26px;
        background: #f7f7f7;

        Text {
            x: 10px;
            width: max(0px, parent.width - font_size_status.width - 24px);
            height: 100%;
            text: "Files: " + item_count;
            font-size: FontSettings.font_size_pt * 1pt;
            color: #666666;
            vertical-alignment: center;
        }

        font_size_status := Text {
            x: parent.width - self.width - 10px;
            width: 110px;
            height: 100%;
            text: "Font: " + FontSettings.font_size_pt + " pt";
            font-size: FontSettings.font_size_pt * 1pt;
            color: #666666;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

}
