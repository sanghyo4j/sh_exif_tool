import { VerticalBox, HorizontalBox, ListView, Button, LineEdit } from "std-widgets.slint"; // LineEdit 추가 확인

component HDivider inherits Rectangle {
    background: #e0e0e0;
    height: 1px;
    width: 100%;
}

component VDivider inherits Rectangle {
    background: #e0e0e0;
    width: 1px;
    height: 100%;
}

export struct FileEntry {
    name: string,
    size: string,
    modified: string,
    created: string,
    is_dir: bool,
}

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: #ffffff;
    title: "Rust EXIF Tool";
    
    in-out property <string> current_path;
    in-out property <[FileEntry]> files;
    in-out property <int> selected_index: -1;

    callback open_dir(int);
    callback reload();
    callback go_parent();

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 1. 최상단 메뉴 바 (Menu Bar)
        Rectangle {
            height: 25px;
            background: #ffffff;
            HorizontalBox {
                padding-left: 10px;
                spacing: 15px;
                alignment: start;
                Text { text: "파일(F)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "보기(V)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "도구(T)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "도움말(H)"; font-size: 12px; color: #333333; vertical-alignment: center; }
            }
        }

        // 2. 도구 모음 및 경로 표시줄 부분
        Rectangle {
            height: 45px;
            background: #fcfcfc;
            HorizontalBox {
                padding: 8px;
                spacing: 12px;
                alignment: start;

                Text { text: "경로"; vertical-alignment: center; color: #666666; font-weight: 700; }
                
                Rectangle {
                    width: 800px;
                    height: 28px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #cccccc;
                    border-radius: 2px;

                    LineEdit {
                        width: 100%;
                        height: 100%;
                        // 단방향(:)이 아닌 양방향(<=>) 바인딩 사용
                        text <=> current_path; 
                        font-size: 13px;
                        
                        accepted => {
                            // 엔터 쳤을 때 바로 로드
                            root.reload();
                        }
                    }
                }
            }
            HDivider { y: 44px; }
        }

        // 3. 메인 콘텐츠
        HorizontalBox {
            padding: 0;
            spacing: 0;

            // [좌측] 탐색기
            VerticalBox {
                width: 750px;
                padding: 0;
                spacing: 0;

                // 2. 도구 모음 아래의 헤더 영역
                Rectangle {
                    height: 30px;
                    background: #f5f5f5;
                    width: 100%; // <-- 이 줄이 누락되면 내부 내용이 안 보일 수 있습니다.
                    
                    // 개별 텍스트들의 위치를 고정
                    Text { 
                        x: 15px; 
                        width: 380px; 
                        text: "파일명"; 
                        font-weight: 700; 
                        color: #666666; 
                        vertical-alignment: center; 
                        height: 100%; // 부모 Rectangle 높이를 꽉 채우도록 설정
                    }
                    Text { 
                        x: 410px; 
                        width: 80px; 
                        text: "크기"; 
                        font-weight: 700; 
                        color: #666666; 
                        horizontal-alignment: right; 
                        vertical-alignment: center; 
                        height: 100%;
                    }
                    Text { 
                        x: 510px; 
                        text: "수정일"; 
                        font-weight: 700; 
                        color: #666666; 
                        vertical-alignment: center; 
                        height: 100%;
                    }
                    
                    HDivider { y: 29px; }
                }

                ListView {
                    // 리스트 아이템 부분
                    for entry[i] in files : Rectangle {
                        height: 32px;
                        background: i == selected_index ? #e3f2fd : #ffffff;

                        TouchArea {
                            width: 100%; height: 100%;
                            clicked => { selected_index = i; }
                            double-clicked => { 
                                if (entry.name == "[..]") { root.go_parent(); } 
                                else if (entry.is_dir) { root.open_dir(i); } 
                            }

                            // 레이아웃을 위해 Rectangle 사용 (Box 대신)
                            Rectangle {
                                // 파일명
                                Text {
                                    x: 15px; // 왼쪽 여백
                                    width: 380px;
                                    text: entry.is_dir ? (entry.name == "[..]" ? "⬅ " + entry.name : "📁 " + entry.name) : "📄 " + entry.name;
                                    color: i == selected_index ? #1976d2 : #212121;
                                    vertical-alignment: center;
                                }
                                // 크기
                                Text {
                                    x: 410px; // 파일명 시작(15) + 파일명 너비(380) + 간격(15)
                                    width: 80px;
                                    text: entry.size;
                                    horizontal-alignment: right;
                                    color: #666666;
                                    vertical-alignment: center;
                                }
                                // 수정일
                                Text {
                                    x: 510px; // 이전 너비 합산
                                    text: entry.modified;
                                    color: #666666;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            VDivider { }

            // [우측] 상세 정보
            Rectangle {
                background: #ffffff;
                VerticalBox {
                    padding: 30px;
                    spacing: 20px;
                    alignment: start;
                    // ... (이전과 동일) ...
                }
            }
        }
    }
}