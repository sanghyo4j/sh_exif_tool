component ShiftNumberInput inherits Rectangle {
    in-out property <string> value: "0";
    callback value_changed(string);
    callback adjusted(string, int) -> string;

    LineEdit {
        x: 0px;
        width: parent.width - 40px;
        height: 30px;
        text <=> root.value;
        edited(value) => { root.value_changed(value); }
    }
    Rectangle {
        x: parent.width - 40px;
        width: 20px;
        height: 30px;
        background: minus_area.has-hover ? NativeColors.hover : NativeColors.surface;
        border-width: 1px;
        border-color: NativeColors.border;
        Text { width: 100%; height: 100%; text: "-"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; font-weight: 600; }
        minus_area := TouchArea { width: 100%; height: 100%; clicked => { root.value = root.adjusted(root.value, -1); root.value_changed(root.value); } }
    }
    Rectangle {
        x: parent.width - 20px;
        width: 20px;
        height: 30px;
        background: plus_area.has-hover ? NativeColors.hover : NativeColors.surface;
        border-width: 1px;
        border-color: NativeColors.border;
        Text { width: 100%; height: 100%; text: "+"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; font-weight: 600; }
        plus_area := TouchArea { width: 100%; height: 100%; clicked => { root.value = root.adjusted(root.value, 1); root.value_changed(root.value); } }
    }
}

export { FileEntry, Palette, FontSettings }

