    in-out property <bool> confirm_trailing_rename_visible: false;
    in-out property <bool> confirm_number_removal_mode: false;
    in-out property <bool> confirm_date_overwrite_visible: false;
    in-out property <bool> confirm_yes_selected: false;
    in-out property <bool> shift_media_date_visible: false;
