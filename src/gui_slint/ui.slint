    in-out property <bool> file_context_menu_visible: false;
    in-out property <bool> exif_context_menu_visible: false;
    in-out property <bool> exif_context_paste_enabled: false;
    in-out property <bool> exif_context_remove_enabled: false;
    in-out property <int> file_filter: 0;
    in-out property <bool> show_only_missing_media_date: false;
    in-out property <bool> backup_before_changes: false;
    in-out property <bool> show_extension_in_file_name: false;
    in-out property <bool> mark_file_date_mismatches: false;
    in-out property <bool> duplicate_results_tab_visible: false;
    in-out property <int> active_right_tab: 0;

    callback open_dir(int);
    callback reload();
    callback go_parent();
    callback change_dir(string);
    callback save_copy();
    callback copy_files();
    callback paste_files();
    callback delete_file();
    callback confirm_delete_file();
    callback open_in_explorer();
    callback reveal_in_explorer(int);
    callback exit_app();
    callback apply_changes();
    callback revert_changes();
    callback remove_exif_tags();
    callback remove_gps_information();
    callback create_exif_structure();
    callback fill_taken_date_from_filename();
    callback fill_taken_date_from_created_date();
    callback fill_taken_date_from_gps();
    callback set_modified_date_from_created_date();
    callback set_file_dates_from_media_date();
    callback set_filename_from_media_date();
    callback metadata_value_edited();
    callback taken_date_input_edited() -> int;
    callback png_creation_time_input_edited() -> int;
    callback png_exif_date_time_original_input_edited() -> int;
    callback table_row_clicked(int);
    callback table_row_selected(int, bool, bool);
    callback select_all_table_rows();
    callback set_file_filter(int);
    callback set_show_only_missing_media_date(bool);
    callback set_show_extension_in_file_name(bool);
    callback select_files_without_exif();
    callback exif_tag_right_clicked(string, string);
    callback exif_section_right_clicked(string);
    callback exif_context_copy();
    callback exif_context_paste();
    callback exif_context_remove();
    callback confirm_metadata_paste(bool);
    callback confirm_date_overwrite(bool);
    callback request_move_trailing_numbers();
    callback confirm_move_trailing_numbers();
    callback request_remove_front_or_rear_numbers();
    callback confirm_remove_front_or_rear_numbers();
    callback extract_embedded_thumbnails();
    callback request_shift_media_date();
    callback request_shift_gps_date_time();
    callback update_shift_media_date_preview(string, string, string, string, bool) -> string;
    callback apply_shift_media_date(string, string, string, string, bool) -> bool;

    MenuBar {
        Menu {
            title: "&File";

            MenuItem {
                title: "&Save Copy";
                enabled: root.selected_index >= 0 && !root.selected_is_dir;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.save_copy();
                }
            }
            MenuItem {
                title: "&Delete";
                enabled: root.selected_recyclable_count > 0;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.confirm_yes_selected = false;
                    root.confirm_delete_visible = true;
                    root.message_title = "Delete";
                    root.message_text = root.selected_delete_message;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "&Apply (Ctrl+S)";
                enabled: root.metadata_dirty;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.apply_changes();
                }
            }
            MenuItem {
                title: "&Revert (Ctrl+R)";
                enabled: root.metadata_dirty;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.revert_changes();
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Open in Explore&r (Alt+Shift+R)";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.open_in_explorer();
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "E&xit (Ctrl+W)";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.exit_app();
                }
            }
        }

        Menu {
            title: "A&nalyze";

            MenuItem { title: "&Analyze Selected"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "Analyze &Folder"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "Analyze &Missing Metadata"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuSeparator {}
            MenuItem {
                title: "Find &Duplicate Files in This Folder...";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.duplicate_results_tab_visible = true;
                    root.active_right_tab = 1;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "&Clear Results";
                enabled: root.duplicate_results_tab_visible;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.duplicate_results_tab_visible = false;
                    root.active_right_tab = 0;
                }
            }
        }

        Menu {
            title: "&Select";

            MenuItem {
                title: "Select Files Without EXIF";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.select_files_without_exif();
                }
            }
        }

        Menu {
            title: "&View";

            MenuItem {
                title: (root.file_filter == 0 ? "● " : "○ ") + "Supported Media";
                activated => {
                    root.file_filter = 0;
                    root.set_file_filter(0);
                }
            }
            MenuItem {
                title: (root.file_filter == 1 ? "● " : "○ ") + "Images";
                activated => {
                    root.file_filter = 1;
                    root.set_file_filter(1);
                }
            }
            MenuItem {
                title: (root.file_filter == 4 ? "● " : "○ ") + "Show Only JPG/JPEG";
                activated => {
                    root.file_filter = 4;
                    root.set_file_filter(4);
                }
            }
            MenuItem {
                title: (root.file_filter == 5 ? "● " : "○ ") + "Show Only PNG";
                activated => {
                    root.file_filter = 5;
                    root.set_file_filter(5);
                }
            }
            MenuItem {
                title: (root.file_filter == 2 ? "● " : "○ ") + "Videos";
                activated => {
                    root.file_filter = 2;
                    root.set_file_filter(2);
                }
            }
            MenuItem {
                title: (root.file_filter == 3 ? "● " : "○ ") + "All Files";
                activated => {
                    root.file_filter = 3;
                    root.set_file_filter(3);
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Show Only Missing Media Date";
                checkable: true;
                checked: root.show_only_missing_media_date;
                activated => {
                    root.show_only_missing_media_date = !root.show_only_missing_media_date;
                    root.set_show_only_missing_media_date(root.show_only_missing_media_date);
                }
            }
            MenuSeparator {}
            Menu {
                title: "File List";

                MenuItem {
                    title: "Mark Created/Modified Differences";
                    checkable: true;
                    checked: root.mark_file_date_mismatches;
                    activated => {
                        root.mark_file_date_mismatches = !root.mark_file_date_mismatches;
                    }
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Show Extension in Metadata File Name";
                checkable: true;
                checked: root.show_extension_in_file_name;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.show_extension_in_file_name = !root.show_extension_in_file_name;
                    root.set_show_extension_in_file_name(root.show_extension_in_file_name);
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Use Monospace Font in Details";
                checkable: true;
                checked: FontSettings.use_monospace_details;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    FontSettings.use_monospace_details = !FontSettings.use_monospace_details;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Increase Font Size";
                enabled: FontSettings.font_size_pt < 15;
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = min(15, FontSettings.font_size_pt + 1);
                    root.editing_path = false;
                }
            }
            MenuItem {
                title: "Decrease Font Size";
                enabled: FontSettings.font_size_pt > 6;
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = max(6, FontSettings.font_size_pt - 1);
                    root.editing_path = false;
                }
            }
            MenuItem {
                title: "Default Font Size";
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = 10;
                    root.editing_path = false;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Font Family: " + FontSettings.font_family;
                enabled: false;
            }
        }

        Menu {
            title: "&Settings";

            MenuItem { title: "&Date Source Priority..."; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "&Filename Patterns..."; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "&Write Software Tag"; checkable: true; checked: true; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "&Rename With _SH148 Suffix"; checkable: true; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem {
                title: "&Backup Before Changes";
                checkable: true;
                checked: root.backup_before_changes;
                activated => {
                    root.backup_before_changes = !root.backup_before_changes;
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                }
            }
        }

        Menu {
            title: "&Advanced";

            MenuItem {
                title: "Move Trailing Number to Front...";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.request_move_trailing_numbers();
                }
            }

            MenuItem {
                title: "Remove Front/Rear Number...";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.request_remove_front_or_rear_numbers();
                }
            }


            MenuItem {
                title: "Extract Embedded Thumbnail";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.extract_embedded_thumbnails();
                }
            }
        }

        Menu {
            title: "&Help";

            MenuItem { title: "&About"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
        }
    }

    HDivider { y: 0px; }

    PathBar {
        y: 1px;
        width: 100%;
        current_path: root.current_path;
        editing <=> root.editing_path;
        change_dir(path) => { root.change_dir(path); }
        go_parent() => {
            root.editing_path = false;
            root.go_parent();
        }
        open_folder() => { root.editing_path = true; }
        reload() => {
            root.editing_path = false;
            root.reload();
        }
    }

    content_focus := FocusScope {
        y: 41px;
        width: 100%;
        height: root.height - 67px;

        init => {
            self.focus();
        }

        key-pressed(event) => {
            if (root.exif_context_menu_visible && event.text == Key.Escape) {
                root.exif_context_menu_visible = false;
                return accept;
            }

            if (root.message_visible || root.confirm_delete_visible || root.confirm_metadata_paste_visible || root.confirm_trailing_rename_visible || root.confirm_date_overwrite_visible || root.shift_media_date_visible) {
                return reject;
            }

            if (event.text == Key.F5) {
                root.editing_path = false;
                root.reload();
                return accept;
            }

            if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) {
                root.editing_path = true;
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) {
                root.editing_path = false;
                root.open_in_explorer();
                return accept;
            }

            if ((event.text == "S" || event.text == "s") && event.modifiers.control) {
                root.editing_path = false;
                content_focus.focus();
                root.apply_changes();
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) {
                root.editing_path = false;
                root.revert_changes();
                return accept;
            }

            if ((event.text == "W" || event.text == "w") && event.modifiers.control) {
                root.editing_path = false;
                root.exit_app();
                return accept;
            }

            reject
        }

        Rectangle {
            width: 100%;
            height: 100%;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 750px;
            height: 100%;

            file_table := CustomFileTable {
                width: 100%;
                height: 100%;
                files: root.files;
                selected_index <=> root.selected_index;
                selected_file_count: root.selected_file_count;
                selected_recyclable_count: root.selected_recyclable_count;
                copied_file_count: root.copied_file_count;
                mark_file_date_mismatches: root.mark_file_date_mismatches;
                context_menu_visible <=> root.file_context_menu_visible;
                row_selected(index, ctrl, shift) => {
                    root.editing_path = false;
                    metadata_panel.close_tools_menu();
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                    root.gps_date_stamp_dirty = false;
                    root.gps_time_stamp_dirty = false;
                    root.png_creation_time_dirty = false;
                    root.png_exif_date_time_original_dirty = false;
                    if (index >= 0 && index < root.files.length) {
                        root.selected_name = root.files[index].name;
                        root.selected_created = root.files[index].created;
                        root.selected_modified = root.files[index].modified;
                        root.original_selected_name = root.files[index].name;
                        root.original_selected_created = root.files[index].created;
                        root.original_selected_modified = root.files[index].modified;
                        root.selected_is_dir = root.files[index].is_dir;
                    }
                    root.table_row_selected(index, ctrl, shift);
                }
                row_clicked(index) => {
                    root.table_row_clicked(index);
                }
                row_activated(index) => {
                    root.open_dir(index);
                }
                select_all_requested() => {
                    root.editing_path = false;
                    metadata_panel.close_tools_menu();
                    root.select_all_table_rows();
                }
                rename_requested(index) => {
                    root.selected_index = index;
                    metadata_panel.focus_file_name();
                }
                reload_requested() => {
                    root.editing_path = false;
                    root.reload();
                }
                copy_requested() => {
                    root.editing_path = false;
                    root.copy_files();
                }
                paste_requested() => {
                    root.editing_path = false;
                    root.paste_files();
                }
                delete_requested() => {
                    root.editing_path = false;
                    if (root.selected_recyclable_count > 0) {
                        root.confirm_yes_selected = false;
                        root.confirm_delete_visible = true;
                        root.message_title = "Delete";
                        root.message_text = root.selected_delete_message;
                    }
                }
                open_folder_requested() => {
                    root.editing_path = true;
                }
                open_in_file_manager_requested(index) => {
                    root.editing_path = false;
                    root.reveal_in_explorer(index);
                }
                apply_requested() => {
                    root.editing_path = false;
                    content_focus.focus();
                    root.apply_changes();
                }
                revert_requested() => {
                    root.editing_path = false;
                    root.revert_changes();
                }
                exit_requested() => {
                    root.editing_path = false;
                    root.exit_app();
                }
            }

        }

        StrongVDivider {
            x: 750px;
            y: 0px;
            height: 100%;
        }

        if root.duplicate_results_tab_visible: Rectangle {
            x: 752px;
            y: 0px;
            width: max(320px, root.width - 752px);
            height: 31px;
            background: NativeColors.subtle_surface;

            details_tab := Rectangle {
                x: 0px;
                width: 92px;
                height: 30px;
                background: root.active_right_tab == 0
                    ? NativeColors.surface
                    : (details_tab_touch.has-hover ? NativeColors.hover : NativeColors.subtle_surface);

                Rectangle {
                    width: 100%;
                    height: 2px;
                    background: root.active_right_tab == 0 ? NativeColors.accent : transparent;
                }

                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: "Details";
                    color: NativeColors.text;
                    font-family: FontSettings.details_font_family;
                    font-size: FontSettings.font_size_pt * 1pt;
                    vertical-alignment: center;
                }

                details_tab_touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.file_context_menu_visible = false;
                        root.active_right_tab = 0;
                    }
                }
            }

            duplicate_tab := Rectangle {
                x: 92px;
                width: 168px;
                height: 30px;
                background: root.active_right_tab == 1
                    ? NativeColors.surface
                    : (duplicate_tab_touch.has-hover ? NativeColors.hover : NativeColors.subtle_surface);

                Rectangle {
                    width: 100%;
                    height: 2px;
                    background: root.active_right_tab == 1 ? NativeColors.accent : transparent;
                }

                Text {
                    x: 12px;
                    width: parent.width - 42px;
                    height: 100%;
                    text: "Duplicate Results";
                    color: NativeColors.text;
                    font-family: FontSettings.details_font_family;
                    font-size: FontSettings.font_size_pt * 1pt;
                    vertical-alignment: center;
                    overflow: elide;
                }

                close_duplicate_tab := Rectangle {
                    x: parent.width - 30px;
                    y: 4px;
                    width: 22px;
                    height: 22px;
                    border-radius: 2px;
                    background: close_duplicate_touch.has-hover ? NativeColors.hover : transparent;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: "×";
                        color: NativeColors.secondary_text;
                        font-size: (FontSettings.font_size_pt + 2) * 1pt;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close_duplicate_touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.duplicate_results_tab_visible = false;
                            root.active_right_tab = 0;
                        }
                    }
                }

                duplicate_tab_touch := TouchArea {
                    width: parent.width - 34px;
                    height: 100%;
                    clicked => {
                        root.file_context_menu_visible = false;
                        root.active_right_tab = 1;
                    }
                }
            }

            HDivider { y: parent.height - 1px; }
        }

        metadata_panel := MetadataPanel {
                x: 752px;
                y: root.duplicate_results_tab_visible ? 31px : 0px;
                width: max(320px, root.width - 752px);
                height: root.duplicate_results_tab_visible ? parent.height - 31px : parent.height;
                visible: !root.duplicate_results_tab_visible || root.active_right_tab == 0;
                header_title: root.duplicate_results_tab_visible ? "Selected File" : "Details";
                selected_file_count: root.selected_file_count;
                selected_name <=> root.selected_name;
                selected_created <=> root.selected_created;
                selected_modified <=> root.selected_modified;
                selected_media_kind <=> root.selected_media_kind;
                selected_media_type <=> root.selected_media_type;
                selected_media_date <=> root.selected_media_date;
                selected_metadata_status <=> root.selected_metadata_status;
                taken_date <=> root.taken_date;
                camera_make <=> root.camera_make;
                camera_model <=> root.camera_model;
                lens_model <=> root.lens_model;
                software <=> root.software;
                artist <=> root.artist;
                image_description <=> root.image_description;
                copyright <=> root.copyright;
                exif_version <=> root.exif_version;
                exposure_program <=> root.exposure_program;
                white_balance <=> root.white_balance;
                focal_length_35mm <=> root.focal_length_35mm;
                shutter_speed <=> root.shutter_speed;
                aperture <=> root.aperture;
                iso_speed <=> root.iso_speed;
                focal_length <=> root.focal_length;
                flash_fired <=> root.flash_fired;
                metering_mode <=> root.metering_mode;
                image_width <=> root.image_width;
                image_height <=> root.image_height;
                orientation <=> root.orientation;
                color_space <=> root.color_space;
                gps_latitude <=> root.gps_latitude;
                gps_longitude <=> root.gps_longitude;
                gps_altitude <=> root.gps_altitude;
                gps_date_stamp <=> root.gps_date_stamp;
                gps_time_stamp <=> root.gps_time_stamp;
                gps_date_time <=> root.gps_date_time;
                date_time_original <=> root.date_time_original;
                date_time_digitized <=> root.date_time_digitized;
                image_date_time <=> root.image_date_time;
                png_creation_time <=> root.png_creation_time;
                png_date_sources_conflict <=> root.png_date_sources_conflict;
                exif_date_sources_visible <=> root.exif_date_sources_visible;
                selected_name_status <=> root.selected_name_status;
                selected_created_status <=> root.selected_created_status;
                selected_modified_status <=> root.selected_modified_status;
                taken_date_status <=> root.taken_date_status;
                camera_make_status <=> root.camera_make_status;
                camera_model_status <=> root.camera_model_status;
                lens_model_status <=> root.lens_model_status;
                software_status <=> root.software_status;
                artist_status <=> root.artist_status;
                shutter_speed_status <=> root.shutter_speed_status;
                aperture_status <=> root.aperture_status;
                iso_speed_status <=> root.iso_speed_status;
                focal_length_status <=> root.focal_length_status;
                flash_fired_status <=> root.flash_fired_status;
                metering_mode_status <=> root.metering_mode_status;
                image_width_status <=> root.image_width_status;
                image_height_status <=> root.image_height_status;
                orientation_status <=> root.orientation_status;
                color_space_status <=> root.color_space_status;
                gps_latitude_status <=> root.gps_latitude_status;
                gps_longitude_status <=> root.gps_longitude_status;
                gps_altitude_status <=> root.gps_altitude_status;
                gps_date_stamp_status <=> root.gps_date_stamp_status;
                gps_time_stamp_status <=> root.gps_time_stamp_status;
                gps_date_time_status <=> root.gps_date_time_status;
                exif_available <=> root.exif_available;
                has_pending_changes <=> root.metadata_dirty;
                selected_name_dirty <=> root.selected_name_dirty;
                selected_created_dirty <=> root.selected_created_dirty;
                selected_modified_dirty <=> root.selected_modified_dirty;
                taken_date_dirty <=> root.taken_date_dirty;
                camera_make_dirty <=> root.camera_make_dirty;
                camera_model_dirty <=> root.camera_model_dirty;
                lens_model_dirty <=> root.lens_model_dirty;
                software_dirty <=> root.software_dirty;
                artist_dirty <=> root.artist_dirty;
                shutter_speed_dirty <=> root.shutter_speed_dirty;
                aperture_dirty <=> root.aperture_dirty;
                iso_speed_dirty <=> root.iso_speed_dirty;
                focal_length_dirty <=> root.focal_length_dirty;
                flash_fired_dirty <=> root.flash_fired_dirty;
                metering_mode_dirty <=> root.metering_mode_dirty;
                image_width_dirty <=> root.image_width_dirty;
                image_height_dirty <=> root.image_height_dirty;
                orientation_dirty <=> root.orientation_dirty;
                color_space_dirty <=> root.color_space_dirty;
                gps_latitude_dirty <=> root.gps_latitude_dirty;
                gps_longitude_dirty <=> root.gps_longitude_dirty;
                gps_altitude_dirty <=> root.gps_altitude_dirty;
                gps_date_stamp_dirty <=> root.gps_date_stamp_dirty;
                gps_time_stamp_dirty <=> root.gps_time_stamp_dirty;
                gps_date_time_dirty <=> root.gps_date_time_dirty;
                png_creation_time_dirty <=> root.png_creation_time_dirty;
                png_exif_date_time_original_dirty <=> root.png_exif_date_time_original_dirty;
                apply_changes() => {
                    root.editing_path = false;
                    root.apply_changes();
                }
                revert_changes() => {
                    root.editing_path = false;
                    root.revert_changes();
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                    root.gps_date_stamp_dirty = false;
                    root.gps_time_stamp_dirty = false;
                    root.gps_date_time_dirty = false;
                    root.png_creation_time_dirty = false;
                    root.png_exif_date_time_original_dirty = false;
                }
                fill_taken_date_from_filename() => {
                    root.editing_path = false;
                    root.fill_taken_date_from_filename();
                    metadata_panel.clear_editor_focus();
                }
                fill_taken_date_from_created_date() => {
                    root.editing_path = false;
                    root.fill_taken_date_from_created_date();
                    metadata_panel.clear_editor_focus();
                }
                shift_media_date() => {
                    root.editing_path = false;
                    metadata_panel.clear_editor_focus();
                    root.request_shift_media_date();
                }
                shift_gps_date_time() => {
                    root.editing_path = false;
                    metadata_panel.clear_editor_focus();
                    root.request_shift_gps_date_time();
                }
                fill_taken_date_from_gps() => {
                    root.editing_path = false;
                    metadata_panel.clear_editor_focus();
                    root.fill_taken_date_from_gps();
                }
                set_modified_date_from_created_date() => {
                    root.editing_path = false;
                    root.set_modified_date_from_created_date();
                    metadata_panel.clear_editor_focus();
                }
                set_file_dates_from_media_date() => {
                    root.editing_path = false;
                    root.set_file_dates_from_media_date();
                    metadata_panel.clear_editor_focus();
                }
                set_filename_from_media_date() => {
                    root.editing_path = false;
                    root.set_filename_from_media_date();
                    metadata_panel.clear_editor_focus();
                }
                taken_date_edited() => {
                    root.taken_date_input_edited()
                }
                png_creation_time_edited() => {
                    root.png_creation_time_input_edited()
                }
                png_exif_date_time_original_edited() => {
                    root.png_exif_date_time_original_input_edited()
                }
                remove_exif_tags() => {
                    root.editing_path = false;
                    root.remove_exif_tags();
                }
                remove_gps_information() => {
                    root.editing_path = false;
                    root.gps_latitude = "";
                    root.gps_longitude = "";
                    root.gps_altitude = "";
                    root.gps_date_stamp = "";
                    root.gps_time_stamp = "";
                    root.gps_date_time = "";
                    root.metadata_value_edited();
                }
                create_exif_structure() => {
                    root.editing_path = false;
                    root.create_exif_structure();
                }
                metadata_edited() => {
                    root.metadata_value_edited();
                }
                shortcut_requested(action) => {
                    if (action == "refresh") {
                        root.editing_path = false;
                        root.reload();
                    } else if (action == "open-folder") {
                        root.editing_path = true;
                    } else if (action == "open-explorer") {
                        root.editing_path = false;
                        root.open_in_explorer();
                    } else if (action == "save") {
                        root.editing_path = false;
                        metadata_panel.clear_editor_focus();
                        root.apply_changes();
                    } else if (action == "revert") {
                        root.editing_path = false;
                        root.revert_changes();
                    } else if (action == "exit") {
                        root.editing_path = false;
                        root.exit_app();
                    }
                }
                exif_tag_right_clicked(key, value) => {
                    root.exif_tag_right_clicked(key, value);
                }
                exif_section_right_clicked(section) => {
                    root.exif_section_right_clicked(section);
                }
        }

        if root.duplicate_results_tab_visible && root.active_right_tab == 1: Rectangle {
            x: 752px;
            y: 31px;
            width: max(320px, root.width - 752px);
            height: parent.height - 31px;
            background: NativeColors.surface;

            Text {
                x: 18px;
                y: 18px;
                width: parent.width - 36px;
                height: 28px;
                text: "Duplicate Files";
                color: NativeColors.text;
                font-family: FontSettings.details_font_family;
                font-size: (FontSettings.font_size_pt + 2) * 1pt;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                x: 18px;
                y: 52px;
                width: parent.width - 36px;
                height: 60px;
                text: "Duplicate groups and actions will appear here. The file list remains visible on the left.";
                color: NativeColors.secondary_text;
                font-family: FontSettings.details_font_family;
                font-size: FontSettings.font_size_pt * 1pt;
                wrap: word-wrap;
                vertical-alignment: top;
            }

            Rectangle {
                x: 18px;
                y: 122px;
                width: parent.width - 36px;
                height: 88px;
                background: NativeColors.subtle_surface;
                border-width: 1px;
                border-color: NativeColors.border;
                border-radius: 3px;

                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: "Prototype only — duplicate scanning and grouped results are not connected yet.";
                    color: NativeColors.secondary_text;
                    font-family: FontSettings.details_font_family;
                    font-size: FontSettings.font_size_pt * 1pt;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
        }
    }

    if root.exif_context_menu_visible: TouchArea {
        width: 100%;
        height: 41px;
        clicked => { root.exif_context_menu_visible = false; }
    }

    if root.exif_context_menu_visible: TouchArea {
        y: 41px;
        width: 752px;
        height: root.height - 41px;
        clicked => {
            root.exif_context_menu_visible = false;
            content_focus.focus();
        }
    }

    if root.exif_context_menu_visible: TouchArea {
        x: 906px;
        y: 71px;
        width: root.width - 906px;
        height: root.height - 97px;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.exif_context_menu_visible = false;
                content_focus.focus();
            }
        }
    }

    if root.exif_context_menu_visible: TouchArea {
        x: 752px;
        y: root.height - 26px;
        width: root.width - 752px;
        height: 26px;
        clicked => {
            root.exif_context_menu_visible = false;
            content_focus.focus();
        }
    }

    if root.exif_context_menu_visible: Rectangle {
        x: min(root.width - 154px, max(2px, MetadataContextMenuState.x));
        y: min(root.height - 112px, max(42px, MetadataContextMenuState.y));
        width: 152px;
        height: 86px;
        background: NativeColors.menu_bg;
        border-width: 1px;
        border-color: #a0a0a0;
        border-radius: 0px;
        forward-focus: exif_context_focus;

        init => { exif_context_focus.focus(); }

        exif_context_focus := FocusScope {
            x: 0px; y: 0px; width: 0px; height: 0px;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.exif_context_menu_visible = false;
                    return accept;
                }
                if (event.text == "C" || event.text == "c") {
                    root.exif_context_menu_visible = false;
                    root.exif_context_copy();
                    return accept;
                }
                if ((event.text == "P" || event.text == "p") && root.exif_context_paste_enabled) {
                    root.exif_context_menu_visible = false;
                    root.exif_context_paste();
                    return accept;
                }
                if ((event.text == "R" || event.text == "r") && root.exif_context_remove_enabled) {
                    root.exif_context_menu_visible = false;
                    root.exif_context_remove();
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: 28px;
            background: copy_area.has-hover ? NativeColors.hover : NativeColors.menu_bg;
            Text { x: 12px; width: parent.width - 24px; height: 100%; text: "Copy (C)"; color: NativeColors.text; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; }
            copy_area := TouchArea { width: 100%; height: 100%; clicked => { root.exif_context_menu_visible = false; root.exif_context_copy(); } }
        }
        Rectangle {
            x: 1px;
            y: 29px;
            width: parent.width - 2px;
            height: 28px;
            background: root.exif_context_paste_enabled && paste_area.has-hover ? NativeColors.hover : NativeColors.menu_bg;
            Text { x: 12px; width: parent.width - 24px; height: 100%; text: "Paste (P)"; color: root.exif_context_paste_enabled ? NativeColors.text : NativeColors.disabled_text; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; }
            paste_area := TouchArea { enabled: root.exif_context_paste_enabled; width: 100%; height: 100%; clicked => { root.exif_context_menu_visible = false; root.exif_context_paste(); } }
        }
        Rectangle {
            x: 1px;
            y: 57px;
            width: parent.width - 2px;
            height: 28px;
            background: root.exif_context_remove_enabled && remove_area.has-hover ? NativeColors.hover : NativeColors.menu_bg;
            Text { x: 12px; width: parent.width - 24px; height: 100%; text: "Remove (R)"; color: root.exif_context_remove_enabled ? NativeColors.text : NativeColors.disabled_text; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; }
            remove_area := TouchArea { enabled: root.exif_context_remove_enabled; width: 100%; height: 100%; clicked => { root.exif_context_menu_visible = false; root.exif_context_remove(); } }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        y: 1px;
        width: 100%;
        height: 40px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        x: 750px;
        y: 41px;
        width: root.width - 750px;
        height: root.height - 67px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        y: root.height - 26px;
        width: 100%;
        height: 26px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if shift_media_date_visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        forward-focus: shift_dialog_focus;

        init => { shift_dialog_focus.focus(); }

        shift_dialog_focus := FocusScope {
            x: 0px; y: 0px; width: 0px; height: 0px;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.shift_media_date_visible = false;
                    return accept;
                }
                reject
            }
        }

        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(610px, root.width - 48px);
            height: 390px;
            background: NativeColors.surface;
            border-width: 1px;
            border-color: NativeColors.border;
            border-radius: 6px;

            Text {
                x: 22px; y: 16px; width: parent.width - 44px; height: 30px;
                text: root.shift_gps_date_time_mode ? "Shift GPS Date/Time (UTC)" : "Shift Media Date";
                color: NativeColors.text; font-size: 15px; font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                x: 22px; y: 54px; width: 72px; height: 28px;
                text: "Operation"; color: NativeColors.secondary_text;
                font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center;
            }

            Rectangle {
                x: 104px; y: 54px; width: 82px; height: 28px;
                background: !root.shift_media_date_subtract ? NativeColors.selection : NativeColors.surface;
                border-width: 1px; border-color: !root.shift_media_date_subtract ? NativeColors.accent : NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Add"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: 100%; height: 100%; clicked => {
                    root.shift_media_date_subtract = false;
                    root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, false);
                } }
            }
            Rectangle {
                x: 194px; y: 54px; width: 82px; height: 28px;
                background: root.shift_media_date_subtract ? NativeColors.selection : NativeColors.surface;
                border-width: 1px; border-color: root.shift_media_date_subtract ? NativeColors.accent : NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Subtract"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: 100%; height: 100%; clicked => {
                    root.shift_media_date_subtract = true;
                    root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, true);
                } }
            }

            Text { x: 22px; y: 102px; width: 70px; height: 22px; text: "Days"; color: NativeColors.secondary_text; vertical-alignment: center; }
            Text { x: 154px; y: 102px; width: 70px; height: 22px; text: "Hours"; color: NativeColors.secondary_text; vertical-alignment: center; }
            Text { x: 286px; y: 102px; width: 70px; height: 22px; text: "Minutes"; color: NativeColors.secondary_text; vertical-alignment: center; }
            Text { x: 418px; y: 102px; width: 70px; height: 22px; text: "Seconds"; color: NativeColors.secondary_text; vertical-alignment: center; }

            LineEdit { x: 22px; y: 126px; width: 110px; height: 30px; text <=> root.shift_media_date_days; edited(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(value, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, root.shift_media_date_subtract); } }
            LineEdit { x: 154px; y: 126px; width: 110px; height: 30px; text <=> root.shift_media_date_hours; edited(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, value, root.shift_media_date_minutes, root.shift_media_date_seconds, root.shift_media_date_subtract); } }
            LineEdit { x: 286px; y: 126px; width: 110px; height: 30px; text <=> root.shift_media_date_minutes; edited(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, value, root.shift_media_date_seconds, root.shift_media_date_subtract); } }
            LineEdit { x: 418px; y: 126px; width: 110px; height: 30px; text <=> root.shift_media_date_seconds; edited(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, value, root.shift_media_date_subtract); } }

            Text { x: 22px; y: 174px; width: parent.width - 44px; height: 22px; text: "Preview"; color: NativeColors.text; font-weight: 700; vertical-alignment: center; }
            Rectangle { x: 22px; y: 200px; width: parent.width - 44px; height: 118px; background: NativeColors.subtle_surface; border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
                Text { x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px; text: root.shift_media_date_preview; color: NativeColors.text; font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt); wrap: word-wrap; }
            }

            Rectangle { x: parent.width - 190px; y: parent.height - 48px; width: 76px; height: 30px; background: cancel_shift.has-hover ? NativeColors.hover : NativeColors.surface; border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Cancel"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; }
                cancel_shift := TouchArea { width: 100%; height: 100%; clicked => { root.shift_media_date_visible = false; } }
            }
            Rectangle { x: parent.width - 102px; y: parent.height - 48px; width: 80px; height: 30px; background: apply_shift.has-hover ? NativeColors.selection : NativeColors.surface; border-width: 1px; border-color: NativeColors.accent; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Apply"; color: NativeColors.text; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                apply_shift := TouchArea { width: 100%; height: 100%; clicked => {
                    if (root.apply_shift_media_date(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, root.shift_media_date_subtract)) {
                        root.shift_media_date_visible = false;
                    }
                } }
            }
        }
    }

    if message_visible || confirm_delete_visible || confirm_metadata_paste_visible || confirm_trailing_rename_visible || confirm_date_overwrite_visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        forward-focus: modal_focus;

        init => {
            modal_focus.focus();
        }

        modal_focus_timer := Timer {
            interval: 1ms;
            running: true;
            triggered => {
                self.running = false;
                modal_focus.focus();
            }
        }

        modal_focus := FocusScope {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;

            capture-key-pressed(event) => {
                if (!root.confirm_delete_visible && !root.confirm_metadata_paste_visible && !root.confirm_trailing_rename_visible && !root.confirm_date_overwrite_visible && (event.text == Key.Return || event.text == " ")) {
                    root.message_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    content_focus.focus();
                    return accept;
                }

                if (!root.confirm_delete_visible && !root.confirm_metadata_paste_visible && !root.confirm_trailing_rename_visible && !root.confirm_date_overwrite_visible && event.text == Key.Escape) {
                    root.message_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    content_focus.focus();
                    return accept;
                }

                if ((root.confirm_delete_visible || root.confirm_metadata_paste_visible || root.confirm_trailing_rename_visible || root.confirm_date_overwrite_visible) && (event.text == Key.LeftArrow || event.text == Key.UpArrow)) {
                    root.confirm_yes_selected = true;
                    return accept;
                }

                if ((root.confirm_delete_visible || root.confirm_metadata_paste_visible || root.confirm_trailing_rename_visible || root.confirm_date_overwrite_visible) && (event.text == Key.RightArrow || event.text == Key.DownArrow)) {
                    root.confirm_yes_selected = false;
                    return accept;
                }

                if (root.confirm_delete_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || (event.text == Key.Return && !root.confirm_yes_selected))) {
                    root.confirm_delete_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_delete_visible && (event.text == "Y" || event.text == "y" || (event.text == Key.Return && root.confirm_yes_selected))) {
                    root.confirm_delete_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    root.confirm_delete_file();
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_metadata_paste_visible && (event.text == "Y" || event.text == "y" || (event.text == Key.Return && root.confirm_yes_selected))) {
                    root.confirm_metadata_paste_visible = false;
                    root.confirm_metadata_paste(true);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_metadata_paste_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || (event.text == Key.Return && !root.confirm_yes_selected))) {
                    root.confirm_metadata_paste_visible = false;
                    root.confirm_metadata_paste(false);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_date_overwrite_visible && (event.text == "Y" || event.text == "y" || (event.text == Key.Return && root.confirm_yes_selected))) {
                    root.confirm_date_overwrite_visible = false;
                    root.confirm_date_overwrite(true);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_date_overwrite_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || (event.text == Key.Return && !root.confirm_yes_selected))) {
                    root.confirm_date_overwrite_visible = false;
                    root.confirm_date_overwrite(false);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_trailing_rename_visible && (event.text == "Y" || event.text == "y" || (event.text == Key.Return && root.confirm_yes_selected))) {
                    root.confirm_trailing_rename_visible = false;
                    if (root.confirm_number_removal_mode) {
                        root.confirm_number_removal_mode = false;
                        root.confirm_remove_front_or_rear_numbers();
                    } else {
                        root.confirm_move_trailing_numbers();
                    }
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_trailing_rename_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || (event.text == Key.Return && !root.confirm_yes_selected))) {
                    root.confirm_trailing_rename_visible = false;
                    root.confirm_number_removal_mode = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    content_focus.focus();
                    return accept;
                }

                accept
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(540px, root.width - 48px);
            height: 190px;
            background: NativeColors.surface;
            border-width: 1px;
            border-color: NativeColors.border;
            border-radius: 6px;

            Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                height: 28px;
                text: root.message_title;
                color: NativeColors.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                x: 20px;
                y: 56px;
                width: parent.width - 40px;
                height: 82px;
                text: root.message_text;
                color: NativeColors.text;
                font-size: FontSettings.font_size_pt * 1pt;
                wrap: word-wrap;
            }

            if !confirm_delete_visible && !confirm_metadata_paste_visible && !confirm_trailing_rename_visible && !confirm_date_overwrite_visible: Rectangle {
                x: parent.width - 92px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: ok_touch.has-hover ? NativeColors.hover : NativeColors.surface;
                border-width: 1px;
                border-color: NativeColors.border;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "OK";
                    color: NativeColors.text;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ok_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.message_visible = false;
                            root.message_title = "Operation Failed";
                            root.message_text = "";
                            content_focus.focus();
                        }
                    }
                }
            }

            if confirm_delete_visible || confirm_metadata_paste_visible || confirm_trailing_rename_visible || confirm_date_overwrite_visible: Rectangle {
                x: parent.width - 92px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: !root.confirm_yes_selected ? NativeColors.selection : no_touch.has-hover ? NativeColors.hover : NativeColors.surface;
                border-width: !root.confirm_yes_selected ? 2px : 1px;
                border-color: !root.confirm_yes_selected ? NativeColors.accent : NativeColors.border;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "No (N)";
                    color: NativeColors.text;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                no_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            if (root.confirm_metadata_paste_visible) {
                                root.confirm_metadata_paste_visible = false;
                                root.confirm_metadata_paste(false);
                                content_focus.focus();
                            } else if (root.confirm_date_overwrite_visible) {
                                root.confirm_date_overwrite_visible = false;
                                root.confirm_date_overwrite(false);
                                content_focus.focus();
                            } else if (root.confirm_trailing_rename_visible) {
                                root.confirm_trailing_rename_visible = false;
                                root.confirm_number_removal_mode = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                content_focus.focus();
                            } else {
                                root.confirm_delete_visible = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                content_focus.focus();
                            }
                        }
                    }
                }
            }

            if confirm_delete_visible || confirm_metadata_paste_visible || confirm_trailing_rename_visible || confirm_date_overwrite_visible: Rectangle {
                x: parent.width - 172px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: root.confirm_yes_selected ? NativeColors.danger_soft : yes_touch.has-hover ? NativeColors.danger_soft : NativeColors.surface;
                border-width: root.confirm_yes_selected ? 2px : 1px;
                border-color: root.confirm_yes_selected ? NativeColors.danger : #e5a4aa;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "Yes (Y)";
                    color: NativeColors.danger;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                yes_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            if (root.confirm_metadata_paste_visible) {
                                root.confirm_metadata_paste_visible = false;
                                root.confirm_metadata_paste(true);
                                content_focus.focus();
                            } else if (root.confirm_date_overwrite_visible) {
                                root.confirm_date_overwrite_visible = false;
                                root.confirm_date_overwrite(true);
                                content_focus.focus();
                            } else if (root.confirm_trailing_rename_visible) {
                                root.confirm_trailing_rename_visible = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                if (root.confirm_number_removal_mode) {
                                    root.confirm_number_removal_mode = false;
                                    root.confirm_remove_front_or_rear_numbers();
                                } else {
                                    root.confirm_move_trailing_numbers();
                                }
                                content_focus.focus();
                            } else {
                                root.confirm_delete_visible = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                root.confirm_delete_file();
                                content_focus.focus();
                            }
                        }
                    }
                }
            }
        }
    }

    HDivider { y: root.height - 27px; }

    Rectangle {
        y: root.height - 26px;
        width: 100%;
        height: 26px;
        background: NativeColors.subtle_surface;

        Text {
            x: 10px;
            width: max(0px, parent.width - file_count_status.width - font_size_status.width - 36px);
            height: 100%;
            text: root.activity_text;
            font-size: FontSettings.font_size_pt * 1pt;
            color: NativeColors.secondary_text;
            vertical-alignment: center;
            overflow: elide;
        }

        file_count_status := Text {
            x: parent.width - font_size_status.width - self.width - 20px;
            width: 220px;
            height: 100%;
            text: root.selected_file_count > 0
                ? root.selected_file_count + " selected / " + root.item_count + (root.item_count == 1 ? " file" : " files")
                : root.item_count + (root.item_count == 1 ? " file" : " files");
            font-size: FontSettings.font_size_pt * 1pt;
            color: NativeColors.secondary_text;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        font_size_status := Text {
            x: parent.width - self.width - 10px;
            width: 110px;
            height: 100%;
            text: "Font: " + FontSettings.font_size_pt + " pt";
            font-size: FontSettings.font_size_pt * 1pt;
            color: NativeColors.secondary_text;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

}
