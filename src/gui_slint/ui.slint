import { VerticalBox, HorizontalBox, ListView, Button } from "std-widgets.slint";

component HDivider inherits Rectangle {
    background: #e0e0e0;
    height: 1px;
    width: 100%;
}

component VDivider inherits Rectangle {
    background: #e0e0e0;
    width: 1px;
    height: 100%;
}

export struct FileEntry {
    name: string,
    size: string,
    modified: string,
    created: string,
    is_dir: bool,
}

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: #ffffff;
    title: "Rust EXIF Tool";
    
    in-out property <string> current_path;
    in-out property <[FileEntry]> files;
    in-out property <int> selected_index: -1;

    callback open_dir(int);
    callback reload();
    callback go_parent();

    VerticalBox {
        padding: 0;
        spacing: 0;

        // 1. 최상단 메뉴 바 (Menu Bar)
        Rectangle {
            height: 25px;
            background: #ffffff;
            HorizontalBox {
                padding-left: 10px;
                spacing: 15px;
                alignment: start;
                Text { text: "파일(F)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "보기(V)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "도구(T)"; font-size: 12px; color: #333333; vertical-alignment: center; }
                Text { text: "도움말(H)"; font-size: 12px; color: #333333; vertical-alignment: center; }
            }
        }

        // 2. 도구 모음 및 경로 표시줄
        Rectangle {
            height: 45px;
            background: #fcfcfc;
            HorizontalBox {
                padding: 8px;
                spacing: 15px;
                alignment: start;
                Button { text: "↻ 새로고침"; clicked => { root.reload(); } }
                Text { text: current_path; vertical-alignment: center; color: #333333; font-weight: 500; }
            }
            HDivider { y: 44px; }
        }

        // 3. 메인 콘텐츠
        HorizontalBox {
            padding: 0;
            spacing: 0;

            // [좌측] 탐색기
            VerticalBox {
                width: 750px;
                padding: 0;
                spacing: 0;

                // 헤더
                Rectangle {
                    height: 30px;
                    background: #f5f5f5;
                    HorizontalBox {
                        padding-left: 15px;
                        spacing: 0;
                        Text { text: "파일명"; width: 380px; font-weight: 700; color: #666666; vertical-alignment: center; }
                        Text { text: "크기"; width: 80px; font-weight: 700; color: #666666; vertical-alignment: center; }
                        Text { text: "수정일"; font-weight: 700; color: #666666; vertical-alignment: center; }
                    }
                    HDivider { y: 29px; }
                }

                ListView {
                    for entry[i] in files : Rectangle {
                        height: 28px;
                        background: i == selected_index ? #e3f2fd : #ffffff;
                        
                        // ui.slint 내부 ListView 안쪽 수정
                        HorizontalBox {
                            padding-left: 15px;
                            spacing: 10px; // 간격을 조금 줍니다

                            Text { 
                                // 아이콘 + 이름 조합 (최대한 단순하게)
                                text: entry.is_dir ? "📁 " + entry.name : "📄 " + entry.name;
                                
                                // 복잡한 설정 없이 기본 출력
                                color: i == selected_index ? #1976d2 : #212121;
                                vertical-alignment: center;
                            }

                            Text { text: entry.size; width: 80px; color: #666666; vertical-alignment: center; }
                            Text { text: entry.modified; color: #666666; vertical-alignment: center; }
                        }

                        TouchArea {
                            clicked => { selected_index = i; }
                            double-clicked => { 
                                if (entry.name == "[..]") {
                                    root.go_parent();
                                } else if (entry.is_dir) { 
                                    root.open_dir(i); 
                                } 
                            }
                        }
                    }
                }
            }

            VDivider { }

            // [우측] 상세 정보
            Rectangle {
                background: #ffffff;
                VerticalBox {
                    padding: 30px;
                    spacing: 20px;
                    alignment: start;
                    // ... (이전과 동일) ...
                }
            }
        }
    }
}