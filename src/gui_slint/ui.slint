    public function focus_file_list() {
        file_table.focus();
        file_selection_reveal_timer.restart();
    }

    public function reveal_file_selection() {
        file_selection_reveal_timer.restart();
    }

    public function report_file_visible_range() {
        file_table.report_visible_range();
    }

    public function begin_rename_selected() {
        // Rename is an operation on the focused row, not on the media-only
        // selected-file count. In particular, a folder has zero selected files
        // even though it is a valid single rename target.
        if (root.selected_index <= 0 || root.selected_index >= root.files.length) {
            return;
        }
        root.editing_path = false;
        root.file_context_menu_visible = false;
        root.exif_context_menu_visible = false;
        root.selected_name = root.files[root.selected_index].name;
        root.original_selected_name = root.selected_name;
        // Set this immediately. Deferring it through a timer could lose the
        // rename request when a folder selection caused another UI refresh in
        // the same event turn.
        root.rename_edit_index = root.selected_index;
    }

    file_selection_reveal_timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            self.running = false;
            file_table.reveal_selected_row();
        }
    }

    MenuBar {
        Menu {
            title: "&File";

            MenuItem {
                title: "&Save Copy";
                enabled: root.selected_index >= 0 && !root.selected_is_dir;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.save_copy();
                }
            }
            MenuItem {
                title: "&Delete";
                enabled: root.selected_recyclable_count > 0;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.confirm_yes_selected = true;
                    root.confirm_delete_visible = true;
                    root.message_title = "Delete";
                    root.message_text = root.selected_delete_message;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "&Apply (Ctrl+S)";
                enabled: root.metadata_dirty;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.apply_changes();
                }
            }
            MenuItem {
                title: "&Revert (Ctrl+R)";
                enabled: root.metadata_dirty;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.revert_changes();
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Open in Explore&r (Alt+Shift+R)";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.open_in_explorer();
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "E&xit (Ctrl+W)";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.exit_app();
                }
            }
        }

        Menu {
            title: "A&nalyze";

            MenuItem { title: "&Analyze Selected"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "Analyze &Folder"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "Analyze &Missing Metadata"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuSeparator {}
            MenuItem {
                title: "Find &Duplicate Files in This Folder...";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.duplicate_results_tab_visible = true;
                    root.active_right_tab = 1;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "&Clear Results";
                enabled: root.duplicate_results_tab_visible;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.duplicate_results_tab_visible = false;
                    root.active_right_tab = 0;
                }
            }
        }

        Menu {
            title: "&Select";

            MenuItem {
                title: "Select Files Without EXIF";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.select_files_without_exif();
                }
            }
        }

        Menu {
            title: "&View";

            MenuItem {
                title: (root.file_filter == 0 ? "● " : "○ ") + "Supported Media";
                activated => {
                    root.file_filter = 0;
                    root.set_file_filter(0);
                }
            }
            MenuItem {
                title: (root.file_filter == 1 ? "● " : "○ ") + "Images";
                activated => {
                    root.file_filter = 1;
                    root.set_file_filter(1);
                }
            }
            MenuItem {
                title: (root.file_filter == 4 ? "● " : "○ ") + "Show Only JPG/JPEG";
                activated => {
                    root.file_filter = 4;
                    root.set_file_filter(4);
                }
            }
            MenuItem {
                title: (root.file_filter == 5 ? "● " : "○ ") + "Show Only PNG";
                activated => {
                    root.file_filter = 5;
                    root.set_file_filter(5);
                }
            }
            MenuItem {
                title: (root.file_filter == 2 ? "● " : "○ ") + "Videos";
                activated => {
                    root.file_filter = 2;
                    root.set_file_filter(2);
                }
            }
            MenuItem {
                title: (root.file_filter == 3 ? "● " : "○ ") + "All Files";
                activated => {
                    root.file_filter = 3;
                    root.set_file_filter(3);
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Show Only Missing Media Date";
                checkable: true;
                checked: root.show_only_missing_media_date;
                activated => {
                    root.toggle_show_only_missing_media_date();
                }
            }
            MenuItem {
                title: "Show Only JPEGs Missing Time Zone Offset";
                checkable: true;
                checked: root.show_only_missing_time_zone_offset;
                activated => {
                    root.toggle_show_only_missing_time_zone_offset();
                }
            }
            MenuItem {
                title: "Show Only Duplicated Files for Media Date";
                checkable: true;
                checked: root.show_only_duplicate_media_date;
                activated => {
                    root.toggle_show_only_duplicate_media_date();
                }
            }
            MenuSeparator {}
            Menu {
                title: "File List";

                MenuItem {
                    title: "Mark Created/Modified Differences";
                    checkable: true;
                    checked: root.mark_file_date_mismatches;
                    activated => {
                        root.mark_file_date_mismatches = !root.mark_file_date_mismatches;
                    }
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Show Extension in Metadata File Name";
                checkable: true;
                checked: root.show_extension_in_file_name;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.show_extension_in_file_name = !root.show_extension_in_file_name;
                    root.set_show_extension_in_file_name(root.show_extension_in_file_name);
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Use Monospace Font in Details";
                checkable: true;
                checked: FontSettings.use_monospace_details;
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    FontSettings.use_monospace_details = !FontSettings.use_monospace_details;
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Increase Font Size";
                enabled: FontSettings.font_size_pt < 15;
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = min(15, FontSettings.font_size_pt + 1);
                    root.editing_path = false;
                    root.font_size_changed(FontSettings.font_size_pt);
                }
            }
            MenuItem {
                title: "Decrease Font Size";
                enabled: FontSettings.font_size_pt > 6;
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = max(6, FontSettings.font_size_pt - 1);
                    root.editing_path = false;
                    root.font_size_changed(FontSettings.font_size_pt);
                }
            }
            MenuItem {
                title: "Default Font Size";
                activated => {
                    root.file_context_menu_visible = false;
                    FontSettings.font_size_pt = 10;
                    root.editing_path = false;
                    root.font_size_changed(FontSettings.font_size_pt);
                }
            }
            MenuSeparator {}
            MenuItem {
                title: "Font Family: " + FontSettings.font_family;
                enabled: false;
            }
        }

        Menu {
            title: "&Settings";

            Menu {
                title: "Media Date Display";
                enabled: !root.metadata_dirty;

                MenuItem {
                    title: (root.time_display_mode == 2 ? "● " : "○ ") + "KST (+09:00)";
                    activated => { root.set_time_display_mode(2); }
                }
                MenuItem {
                    title: (root.time_display_mode == 1 ? "● " : "○ ") + "UTC (+00:00)";
                    activated => { root.set_time_display_mode(1); }
                }
            }
            MenuSeparator {}

            MenuItem { title: "&Date Source Priority..."; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "&Filename Patterns..."; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "&Write Software Tag"; checkable: true; checked: true; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem { title: "&Rename With _SH148 Suffix"; checkable: true; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
            MenuItem {
                title: "&Backup Before Changes";
                checkable: true;
                checked: root.backup_before_changes;
                activated => {
                    root.backup_before_changes = !root.backup_before_changes;
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                }
            }
        }

        Menu {
            title: "&Advanced";

            MenuItem {
                title: "Move Trailing Number to Front...";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.request_move_trailing_numbers();
                }
            }

            MenuItem {
                title: "Remove Front/Rear Number...";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.request_remove_front_or_rear_numbers();
                }
            }

            MenuItem {
                title: "Remove IMG_/VID_ Prefix...";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.request_remove_img_vid_prefixes();
                }
            }

            MenuItem {
                title: "Extract Embedded Thumbnail";
                activated => {
                    root.file_context_menu_visible = false;
                    root.editing_path = false;
                    root.extract_embedded_thumbnails();
                }
            }
        }

        Menu {
            title: "&Help";

            MenuItem { title: "&About"; activated => { root.file_context_menu_visible = false; root.editing_path = false; } }
        }
    }

    Toolbar {
        y: 0px;
        z: 10;
        width: 100%;
        save_enabled: root.metadata_dirty;
        save => {
            root.file_context_menu_visible = false;
            root.exif_context_menu_visible = false;
            root.editing_path = false;
            root.apply_changes();
        }
        revert => {
            root.file_context_menu_visible = false;
            root.exif_context_menu_visible = false;
            root.editing_path = false;
            root.revert_changes();
        }
        open_folder => {
            root.file_context_menu_visible = false;
            root.exif_context_menu_visible = false;
            root.editing_path = false;
            root.choose_folder();
        }
        reload => {
            root.file_context_menu_visible = false;
            root.exif_context_menu_visible = false;
            root.editing_path = false;
            root.reload();
        }
    }

    PathBar {
        y: 30px;
        width: 100%;
        current_path: root.current_path;
        editing <=> root.editing_path;
        change_dir(path) => { root.change_dir(path); }
        go_parent() => {
            root.editing_path = false;
            root.go_parent();
        }
    }

    content_focus := FocusScope {
        y: 70px;
        width: 100%;
        height: root.height - 96px - (root.log_visible ? 116px : 0px);

        init => {
            self.focus();
        }

        capture-key-pressed(event) => {
            if (root.exif_context_menu_visible && event.text == Key.Escape) {
                root.exif_context_menu_visible = false;
                return accept;
            }

            if (root.message_visible || root.confirm_delete_visible || root.confirm_metadata_paste_visible || root.confirm_trailing_rename_visible || root.confirm_date_overwrite_visible || root.shift_media_date_visible || root.time_zone_offset_visible) {
                return reject;
            }

            if (event.text == Key.F5) {
                root.editing_path = false;
                root.reload();
                return accept;
            }

            if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) {
                root.editing_path = true;
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) {
                root.editing_path = false;
                root.open_in_explorer();
                return accept;
            }

            if (event.text == Key.F2) {
                root.begin_rename_selected();
                return accept;
            }

            if ((event.text == "D" || event.text == "d") && event.modifiers.control && root.selected_recyclable_count > 0) {
                root.editing_path = false;
                root.file_context_menu_visible = false;
                root.confirm_yes_selected = true;
                root.confirm_delete_visible = true;
                root.message_title = "Delete";
                root.message_text = root.selected_delete_message;
                return accept;
            }

            if ((event.text == "S" || event.text == "s") && event.modifiers.control) {
                root.editing_path = false;
                content_focus.focus();
                root.apply_changes();
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) {
                root.editing_path = false;
                root.revert_changes();
                return accept;
            }

            if ((event.text == "W" || event.text == "w") && event.modifiers.control) {
                root.editing_path = false;
                root.exit_app();
                return accept;
            }

            reject
        }

        Rectangle {
            width: 100%;
            height: 100%;

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.panel_split_x;
            height: 100%;

            file_table := CustomFileTable {
                width: 100%;
                height: 100%;
                files: root.files;
                selected_index <=> root.selected_index;
                rename_edit_index <=> root.rename_edit_index;
                rename_text <=> root.selected_name;
                rename_pending: root.selected_name_dirty;
                visible_range_changed(first, last) => {
                    root.table_visible_range_changed(first, last);
                }
                selected_file_count: root.selected_file_count;
                selected_recyclable_count: root.selected_recyclable_count;
                copied_file_count: root.copied_file_count;
                mark_file_date_mismatches: root.mark_file_date_mismatches;
                sort_column: root.sort_column;
                sort_direction: root.sort_direction;
                context_menu_visible <=> root.file_context_menu_visible;
                sort_requested(column) => {
                    root.file_context_menu_visible = false;
                    root.sort_file_list(column);
                }
                type_ahead_requested(key) => {
                    return root.find_file_by_prefix(key);
                }
                row_selected(index, ctrl, shift) => {
                    if (!root.table_row_selected(index, ctrl, shift)) {
                        return false;
                    }
                    root.rename_edit_index = -1;
                    file_table.focus();
                    root.editing_path = false;
                    metadata_panel.close_tools_menu();
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                    root.gps_date_stamp_dirty = false;
                    root.gps_time_stamp_dirty = false;
                    root.png_creation_time_dirty = false;
                    root.png_exif_date_time_original_dirty = false;
                    if (index >= 0 && index < root.files.length) {
                        root.selected_name = root.files[index].name;
                        root.selected_created = root.files[index].created;
                        root.selected_modified = root.files[index].modified;
                        root.original_selected_name = root.files[index].name;
                        root.original_selected_created = root.files[index].created;
                        root.original_selected_modified = root.files[index].modified;
                        root.selected_is_dir = root.files[index].is_dir;
                    }
                    return true;
                }
                row_clicked(index) => {
                    root.table_row_clicked(index);
                }
                row_activated(index) => {
                    if (index >= 0 && index < root.files.length && root.files[index].is_dir) {
                        root.open_dir(index);
                    } else {
                        root.open_file(index);
                    }
                }
                select_all_requested() => {
                    root.editing_path = false;
                    metadata_panel.close_tools_menu();
                    root.select_all_table_rows();
                }
                rename_requested(index) => {
                    root.selected_index = index;
                    root.begin_rename_selected();
                }
                rename_value_edited() => {
                    // Inline rename is committed directly with Enter and is
                    // intentionally separate from staged metadata changes.
                }
                rename_finished(index, name) => {
                    return root.commit_inline_rename(index, name);
                }
                rename_cancelled() => {
                    root.selected_name = root.original_selected_name;
                    root.rename_edit_index = -1;
                    file_table.focus();
                }
                reload_requested() => {
                    root.editing_path = false;
                    root.reload();
                }
                copy_requested() => {
                    root.editing_path = false;
                    root.copy_files();
                }
                paste_requested() => {
                    root.editing_path = false;
                    root.paste_files();
                }
                delete_requested() => {
                    root.editing_path = false;
                    if (root.selected_recyclable_count > 0) {
                        root.confirm_yes_selected = true;
                        root.confirm_delete_visible = true;
                        root.message_title = "Delete";
                        root.message_text = root.selected_delete_message;
                    }
                }
                open_folder_requested() => {
                    root.editing_path = false;
                    root.choose_folder();
                }
                open_in_file_manager_requested(index) => {
                    root.editing_path = false;
                    root.reveal_in_explorer(index);
                }
                apply_requested() => {
                    root.editing_path = false;
                    content_focus.focus();
                    root.apply_changes();
                }
                revert_requested() => {
                    root.editing_path = false;
                    root.revert_changes();
                }
                exit_requested() => {
                    root.editing_path = false;
                    root.exit_app();
                }
            }

        }

        StrongVDivider {
            x: root.panel_split_x;
            y: 0px;
            height: 100%;
        }

        splitter_drag := TouchArea {
            x: root.panel_split_x - 3px;
            y: 0px;
            width: 8px;
            height: 100%;
            mouse-cursor: ew-resize;

            moved => {
                if (self.pressed) {
                    root.panel_split_x = min(
                        root.width - 322px,
                        max(
                            480px,
                            self.absolute-position.x - content_focus.absolute-position.x + self.mouse-x
                        )
                    );
                    root.file_context_menu_visible = false;
                    root.exif_context_menu_visible = false;
                }
            }
        }

        if root.duplicate_results_tab_visible: Rectangle {
            x: root.right_panel_x;
            y: 0px;
            width: root.right_panel_width;
            height: 31px;
            background: NativeColors.subtle_surface;

            details_tab := Rectangle {
                x: 0px;
                width: 92px;
                height: 30px;
                background: root.active_right_tab == 0
                    ? NativeColors.surface
                    : (details_tab_touch.has-hover ? NativeColors.hover : NativeColors.subtle_surface);

                Rectangle {
                    width: 100%;
                    height: 2px;
                    background: root.active_right_tab == 0 ? NativeColors.accent : transparent;
                }

                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: "Details";
                    color: NativeColors.text;
                    font-family: FontSettings.details_font_family;
                    font-size: FontSettings.font_size_pt * 1pt;
                    vertical-alignment: center;
                }

                details_tab_touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.file_context_menu_visible = false;
                        root.active_right_tab = 0;
                    }
                }
            }

            duplicate_tab := Rectangle {
                x: 92px;
                width: 168px;
                height: 30px;
                background: root.active_right_tab == 1
                    ? NativeColors.surface
                    : (duplicate_tab_touch.has-hover ? NativeColors.hover : NativeColors.subtle_surface);

                Rectangle {
                    width: 100%;
                    height: 2px;
                    background: root.active_right_tab == 1 ? NativeColors.accent : transparent;
                }

                Text {
                    x: 12px;
                    width: parent.width - 42px;
                    height: 100%;
                    text: "Duplicate Results";
                    color: NativeColors.text;
                    font-family: FontSettings.details_font_family;
                    font-size: FontSettings.font_size_pt * 1pt;
                    vertical-alignment: center;
                    overflow: elide;
                }

                close_duplicate_tab := Rectangle {
                    x: parent.width - 30px;
                    y: 4px;
                    width: 22px;
                    height: 22px;
                    border-radius: 2px;
                    background: close_duplicate_touch.has-hover ? NativeColors.hover : transparent;

                    Text {
                        width: 100%;
                        height: 100%;
                        text: "×";
                        color: NativeColors.secondary_text;
                        font-size: (FontSettings.font_size_pt + 2) * 1pt;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close_duplicate_touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.duplicate_results_tab_visible = false;
                            root.active_right_tab = 0;
                        }
                    }
                }

                duplicate_tab_touch := TouchArea {
                    width: parent.width - 34px;
                    height: 100%;
                    clicked => {
                        root.file_context_menu_visible = false;
                        root.active_right_tab = 1;
                    }
                }
            }

            HDivider { y: parent.height - 1px; }
        }

        if root.preview_shown: Rectangle {
            x: root.right_panel_x;
            y: root.right_content_y;
            width: root.right_panel_width;
            height: root.preview_height;
            background: #eef0f2;

            if root.preview_ready: Image {
                width: parent.width;
                height: parent.height;
                source: root.preview_image;
                image-fit: contain;
            }

            if root.preview_status != "": Rectangle {
                x: 8px;
                y: parent.height - (root.preview_info != "" ? 54px : 28px);
                width: min(parent.width - 16px, status_text.preferred-width + 16px);
                height: 22px;
                background: #f5f5f5e8;
                border-width: 1px;
                border-color: NativeColors.border;
                border-radius: 2px;

                status_text := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text: root.preview_status;
                    color: NativeColors.secondary_text;
                    font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if root.preview_info != "": Rectangle {
                x: 8px;
                y: parent.height - 28px;
                width: min(parent.width - 16px, preview_info_text.preferred-width + 16px);
                height: 22px;
                background: #20202099;
                border-radius: 2px;

                preview_info_text := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: 100%;
                    text: root.preview_info;
                    color: white;
                    font-family: FontSettings.font_family;
                    font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HDivider { y: parent.height - 1px; }
        }

        metadata_panel := MetadataPanel {
                x: root.right_panel_x;
                y: root.right_content_y + (root.preview_shown ? root.preview_height + 1px : 0px);
                width: root.right_panel_width;
                height: parent.height - self.y;
                visible: !root.duplicate_results_tab_visible || root.active_right_tab == 0;
                header_title: root.duplicate_results_tab_visible ? "Selected File" : "Details";
                selected_file_count: root.selected_file_count;
                selected_name <=> root.selected_name;
                selected_size <=> root.selected_size;
                selected_created <=> root.selected_created;
                selected_modified <=> root.selected_modified;
                selected_media_kind <=> root.selected_media_kind;
                selected_media_type <=> root.selected_media_type;
                selected_media_date <=> root.selected_media_date;
                selected_time_interpretation <=> root.selected_time_interpretation;
                selected_metadata_status <=> root.selected_metadata_status;
                taken_date <=> root.taken_date;
                camera_make <=> root.camera_make;
                camera_model <=> root.camera_model;
                lens_model <=> root.lens_model;
                software <=> root.software;
                artist <=> root.artist;
                image_description <=> root.image_description;
                copyright <=> root.copyright;
                exif_version <=> root.exif_version;
                exposure_program <=> root.exposure_program;
                white_balance <=> root.white_balance;
                focal_length_35mm <=> root.focal_length_35mm;
                shutter_speed <=> root.shutter_speed;
                aperture <=> root.aperture;
                iso_speed <=> root.iso_speed;
                focal_length <=> root.focal_length;
                flash_fired <=> root.flash_fired;
                metering_mode <=> root.metering_mode;
                image_width <=> root.image_width;
                image_height <=> root.image_height;
                orientation <=> root.orientation;
                color_space <=> root.color_space;
                gps_latitude <=> root.gps_latitude;
                gps_longitude <=> root.gps_longitude;
                gps_altitude <=> root.gps_altitude;
                gps_date_stamp <=> root.gps_date_stamp;
                gps_time_stamp <=> root.gps_time_stamp;
                gps_date_time <=> root.gps_date_time;
                date_time_original <=> root.date_time_original;
                date_time_digitized <=> root.date_time_digitized;
                image_date_time <=> root.image_date_time;
                png_creation_time <=> root.png_creation_time;
                png_date_sources_conflict <=> root.png_date_sources_conflict;
                exif_date_sources_visible <=> root.exif_date_sources_visible;
                selected_name_status <=> root.selected_name_status;
                selected_created_status <=> root.selected_created_status;
                selected_modified_status <=> root.selected_modified_status;
                taken_date_status <=> root.taken_date_status;
                camera_make_status <=> root.camera_make_status;
                camera_model_status <=> root.camera_model_status;
                lens_model_status <=> root.lens_model_status;
                software_status <=> root.software_status;
                artist_status <=> root.artist_status;
                shutter_speed_status <=> root.shutter_speed_status;
                aperture_status <=> root.aperture_status;
                iso_speed_status <=> root.iso_speed_status;
                focal_length_status <=> root.focal_length_status;
                flash_fired_status <=> root.flash_fired_status;
                metering_mode_status <=> root.metering_mode_status;
                image_width_status <=> root.image_width_status;
                image_height_status <=> root.image_height_status;
                orientation_status <=> root.orientation_status;
                color_space_status <=> root.color_space_status;
                gps_latitude_status <=> root.gps_latitude_status;
                gps_longitude_status <=> root.gps_longitude_status;
                gps_altitude_status <=> root.gps_altitude_status;
                gps_date_stamp_status <=> root.gps_date_stamp_status;
                gps_time_stamp_status <=> root.gps_time_stamp_status;
                gps_date_time_status <=> root.gps_date_time_status;
                exif_available <=> root.exif_available;
                has_pending_changes <=> root.metadata_dirty;
                selected_name_dirty <=> root.selected_name_dirty;
                selected_created_dirty <=> root.selected_created_dirty;
                selected_modified_dirty <=> root.selected_modified_dirty;
                taken_date_dirty <=> root.taken_date_dirty;
                camera_make_dirty <=> root.camera_make_dirty;
                camera_model_dirty <=> root.camera_model_dirty;
                lens_model_dirty <=> root.lens_model_dirty;
                software_dirty <=> root.software_dirty;
                artist_dirty <=> root.artist_dirty;
                shutter_speed_dirty <=> root.shutter_speed_dirty;
                aperture_dirty <=> root.aperture_dirty;
                iso_speed_dirty <=> root.iso_speed_dirty;
                focal_length_dirty <=> root.focal_length_dirty;
                flash_fired_dirty <=> root.flash_fired_dirty;
                metering_mode_dirty <=> root.metering_mode_dirty;
                image_width_dirty <=> root.image_width_dirty;
                image_height_dirty <=> root.image_height_dirty;
                orientation_dirty <=> root.orientation_dirty;
                color_space_dirty <=> root.color_space_dirty;
                gps_latitude_dirty <=> root.gps_latitude_dirty;
                gps_longitude_dirty <=> root.gps_longitude_dirty;
                gps_altitude_dirty <=> root.gps_altitude_dirty;
                gps_date_stamp_dirty <=> root.gps_date_stamp_dirty;
                gps_time_stamp_dirty <=> root.gps_time_stamp_dirty;
                gps_date_time_dirty <=> root.gps_date_time_dirty;
                png_creation_time_dirty <=> root.png_creation_time_dirty;
                png_exif_date_time_original_dirty <=> root.png_exif_date_time_original_dirty;
                date_value_adjusted(value, cursor, delta) => {
                    return root.adjust_date_value(value, cursor, delta);
                }
                apply_changes() => {
                    root.editing_path = false;
                    root.apply_changes();
                }
                revert_changes() => {
                    root.editing_path = false;
                    root.revert_changes();
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                    root.gps_date_stamp_dirty = false;
                    root.gps_time_stamp_dirty = false;
                    root.gps_date_time_dirty = false;
                    root.png_creation_time_dirty = false;
                    root.png_exif_date_time_original_dirty = false;
                }
                fill_taken_date_from_filename() => {
                    root.editing_path = false;
                    root.fill_taken_date_from_filename();
                    metadata_panel.clear_editor_focus();
                }
                fill_taken_date_from_created_date() => {
                    root.editing_path = false;
                    root.fill_taken_date_from_created_date();
                    metadata_panel.clear_editor_focus();
                }
                shift_media_date() => {
                    root.editing_path = false;
                    metadata_panel.clear_editor_focus();
                    root.request_shift_media_date();
                }
                set_time_zone_offset() => {
                    root.editing_path = false;
                    metadata_panel.clear_editor_focus();
                    root.request_set_time_zone_offset();
                }
                shift_gps_date_time() => {
                    root.editing_path = false;
                    metadata_panel.clear_editor_focus();
                    root.request_shift_gps_date_time();
                }
                fill_taken_date_from_gps() => {
                    root.editing_path = false;
                    metadata_panel.clear_editor_focus();
                    root.fill_taken_date_from_gps();
                }
                set_modified_date_from_created_date() => {
                    root.editing_path = false;
                    root.set_modified_date_from_created_date();
                    metadata_panel.clear_editor_focus();
                }
                set_file_dates_from_media_date() => {
                    root.editing_path = false;
                    root.set_file_dates_from_media_date();
                    metadata_panel.clear_editor_focus();
                }
                set_filename_from_media_date() => {
                    root.editing_path = false;
                    root.set_filename_from_media_date();
                    metadata_panel.clear_editor_focus();
                }
                taken_date_edited() => {
                    root.taken_date_input_edited()
                }
                png_creation_time_edited() => {
                    root.png_creation_time_input_edited()
                }
                png_exif_date_time_original_edited() => {
                    root.png_exif_date_time_original_input_edited()
                }
                remove_exif_tags() => {
                    root.editing_path = false;
                    root.remove_exif_tags();
                }
                remove_gps_information() => {
                    root.editing_path = false;
                    root.gps_latitude = "";
                    root.gps_longitude = "";
                    root.gps_altitude = "";
                    root.gps_date_stamp = "";
                    root.gps_time_stamp = "";
                    root.gps_date_time = "";
                    root.metadata_value_edited();
                }
                create_exif_structure() => {
                    root.editing_path = false;
                    root.create_exif_structure();
                }
                metadata_edited() => {
                    root.metadata_value_edited();
                }
                shortcut_requested(action) => {
                    if (action == "refresh") {
                        root.editing_path = false;
                        root.reload();
                    } else if (action == "open-folder") {
                        root.editing_path = true;
                    } else if (action == "open-explorer") {
                        root.editing_path = false;
                        root.open_in_explorer();
                    } else if (action == "save") {
                        root.editing_path = false;
                        metadata_panel.clear_editor_focus();
                        root.apply_changes();
                    } else if (action == "revert") {
                        root.editing_path = false;
                        root.revert_changes();
                    } else if (action == "exit") {
                        root.editing_path = false;
                        root.exit_app();
                    }
                }
                exif_tag_right_clicked(key, value) => {
                    root.exif_tag_right_clicked(key, value);
                }
                exif_section_right_clicked(section) => {
                    root.exif_section_right_clicked(section);
                }
        }

        if root.duplicate_results_tab_visible && root.active_right_tab == 1: Rectangle {
            x: root.right_panel_x;
            y: 31px;
            width: root.right_panel_width;
            height: parent.height - 31px;
            background: NativeColors.surface;

            Text {
                x: 18px;
                y: 18px;
                width: parent.width - 36px;
                height: 28px;
                text: "Duplicate Files";
                color: NativeColors.text;
                font-family: FontSettings.details_font_family;
                font-size: (FontSettings.font_size_pt + 2) * 1pt;
                font-weight: 600;
                vertical-alignment: center;
            }

            Text {
                x: 18px;
                y: 52px;
                width: parent.width - 36px;
                height: 60px;
                text: "Duplicate groups and actions will appear here. The file list remains visible on the left.";
                color: NativeColors.secondary_text;
                font-family: FontSettings.details_font_family;
                font-size: FontSettings.font_size_pt * 1pt;
                wrap: word-wrap;
                vertical-alignment: top;
            }

            Rectangle {
                x: 18px;
                y: 122px;
                width: parent.width - 36px;
                height: 88px;
                background: NativeColors.subtle_surface;
                border-width: 1px;
                border-color: NativeColors.border;
                border-radius: 3px;

                Text {
                    x: 12px;
                    width: parent.width - 24px;
                    height: 100%;
                    text: "Prototype only — duplicate scanning and grouped results are not connected yet.";
                    color: NativeColors.secondary_text;
                    font-family: FontSettings.details_font_family;
                    font-size: FontSettings.font_size_pt * 1pt;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }
        }
    }

    if root.exif_context_menu_visible: TouchArea {
        width: 100%;
        height: 41px;
        clicked => { root.exif_context_menu_visible = false; }
    }

    if root.exif_context_menu_visible: TouchArea {
        y: 41px;
        width: root.right_panel_x;
        height: root.height - 41px;
        clicked => {
            root.exif_context_menu_visible = false;
            content_focus.focus();
        }
    }

    if root.exif_context_menu_visible: TouchArea {
        x: root.right_panel_x + 154px;
        y: 71px;
        width: root.width - root.right_panel_x - 154px;
        height: root.height - 97px;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.exif_context_menu_visible = false;
                content_focus.focus();
            }
        }
    }

    if root.exif_context_menu_visible: TouchArea {
        x: root.right_panel_x;
        y: root.height - 26px;
        width: root.width - root.right_panel_x;
        height: 26px;
        clicked => {
            root.exif_context_menu_visible = false;
            content_focus.focus();
        }
    }

    if root.exif_context_menu_visible: Rectangle {
        x: min(root.width - 154px, max(2px, MetadataContextMenuState.x));
        y: min(root.height - 112px, max(42px, MetadataContextMenuState.y));
        width: 152px;
        height: 86px;
        background: NativeColors.menu_bg;
        border-width: 1px;
        border-color: #a0a0a0;
        border-radius: 0px;
        forward-focus: exif_context_focus;

        init => { exif_context_focus.focus(); }

        exif_context_focus := FocusScope {
            x: 0px; y: 0px; width: 0px; height: 0px;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.exif_context_menu_visible = false;
                    return accept;
                }
                if (event.text == "C" || event.text == "c") {
                    root.exif_context_menu_visible = false;
                    root.exif_context_copy();
                    return accept;
                }
                if ((event.text == "P" || event.text == "p") && root.exif_context_paste_enabled) {
                    root.exif_context_menu_visible = false;
                    root.exif_context_paste();
                    return accept;
                }
                if ((event.text == "R" || event.text == "r") && root.exif_context_remove_enabled) {
                    root.exif_context_menu_visible = false;
                    root.exif_context_remove();
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: 28px;
            background: copy_area.has-hover ? NativeColors.hover : NativeColors.menu_bg;
            Text { x: 12px; width: parent.width - 24px; height: 100%; text: "Copy (C)"; color: NativeColors.text; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; }
            copy_area := TouchArea { width: 100%; height: 100%; clicked => { root.exif_context_menu_visible = false; root.exif_context_copy(); } }
        }
        Rectangle {
            x: 1px;
            y: 29px;
            width: parent.width - 2px;
            height: 28px;
            background: root.exif_context_paste_enabled && paste_area.has-hover ? NativeColors.hover : NativeColors.menu_bg;
            Text { x: 12px; width: parent.width - 24px; height: 100%; text: "Paste (P)"; color: root.exif_context_paste_enabled ? NativeColors.text : NativeColors.disabled_text; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; }
            paste_area := TouchArea { enabled: root.exif_context_paste_enabled; width: 100%; height: 100%; clicked => { root.exif_context_menu_visible = false; root.exif_context_paste(); } }
        }
        Rectangle {
            x: 1px;
            y: 57px;
            width: parent.width - 2px;
            height: 28px;
            background: root.exif_context_remove_enabled && remove_area.has-hover ? NativeColors.hover : NativeColors.menu_bg;
            Text { x: 12px; width: parent.width - 24px; height: 100%; text: "Remove (R)"; color: root.exif_context_remove_enabled ? NativeColors.text : NativeColors.disabled_text; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; }
            remove_area := TouchArea { enabled: root.exif_context_remove_enabled; width: 100%; height: 100%; clicked => { root.exif_context_menu_visible = false; root.exif_context_remove(); } }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        y: 1px;
        width: 100%;
        height: 40px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        x: root.panel_split_x;
        y: 41px;
        width: root.width - root.panel_split_x;
        height: root.height - 67px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if root.file_context_menu_visible: TouchArea {
        y: root.height - 26px;
        width: 100%;
        height: 26px;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.file_context_menu_visible = false;
            }
        }
    }

    if shift_media_date_visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        forward-focus: shift_dialog_focus;

        init => { shift_dialog_focus.focus(); }

        shift_dialog_focus := FocusScope {
            x: 0px; y: 0px; width: 0px; height: 0px;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.shift_media_date_visible = false;
                    return accept;
                }
                if (event.text == Key.Return || event.text == " ") {
                    if (root.apply_shift_media_date(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, root.shift_media_date_subtract)) {
                        root.shift_media_date_visible = false;
                    }
                    return accept;
                }
                reject
            }
        }

        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(610px, root.width - 48px);
            height: 390px;
            background: NativeColors.surface;
            border-width: 1px;
            border-color: NativeColors.border;
            border-radius: 6px;

            Text {
                x: 22px; y: 16px; width: parent.width - 44px; height: 30px;
                text: root.shift_gps_date_time_mode ? "Shift GPS Date/Time (UTC)" : "Shift Media Date";
                color: NativeColors.text; font-size: 15px; font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                x: 22px; y: 54px; width: 72px; height: 28px;
                text: "Operation"; color: NativeColors.secondary_text;
                font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center;
            }

            Rectangle {
                x: 104px; y: 54px; width: 82px; height: 28px;
                background: !root.shift_media_date_subtract ? NativeColors.selection : NativeColors.surface;
                border-width: 1px; border-color: !root.shift_media_date_subtract ? NativeColors.accent : NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Add"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: 100%; height: 100%; clicked => {
                    root.shift_media_date_subtract = false;
                    root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, false);
                } }
            }
            Rectangle {
                x: 194px; y: 54px; width: 82px; height: 28px;
                background: root.shift_media_date_subtract ? NativeColors.selection : NativeColors.surface;
                border-width: 1px; border-color: root.shift_media_date_subtract ? NativeColors.accent : NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Subtract"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: 100%; height: 100%; clicked => {
                    root.shift_media_date_subtract = true;
                    root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, true);
                } }
            }

            Text { x: 22px; y: 102px; width: 70px; height: 22px; text: "Days"; color: NativeColors.secondary_text; vertical-alignment: center; }
            Text { x: 154px; y: 102px; width: 70px; height: 22px; text: "Hours"; color: NativeColors.secondary_text; vertical-alignment: center; }
            Text { x: 286px; y: 102px; width: 70px; height: 22px; text: "Minutes"; color: NativeColors.secondary_text; vertical-alignment: center; }
            Text { x: 418px; y: 102px; width: 70px; height: 22px; text: "Seconds"; color: NativeColors.secondary_text; vertical-alignment: center; }

            ShiftNumberInput { x: 22px; y: 126px; width: 110px; height: 30px; value <=> root.shift_media_date_days; adjusted(value, delta) => { root.adjust_shift_value(value, delta) } value_changed(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(value, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, root.shift_media_date_subtract); } }
            ShiftNumberInput { x: 154px; y: 126px; width: 110px; height: 30px; value <=> root.shift_media_date_hours; adjusted(value, delta) => { root.adjust_shift_value(value, delta) } value_changed(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, value, root.shift_media_date_minutes, root.shift_media_date_seconds, root.shift_media_date_subtract); } }
            ShiftNumberInput { x: 286px; y: 126px; width: 110px; height: 30px; value <=> root.shift_media_date_minutes; adjusted(value, delta) => { root.adjust_shift_value(value, delta) } value_changed(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, value, root.shift_media_date_seconds, root.shift_media_date_subtract); } }
            ShiftNumberInput { x: 418px; y: 126px; width: 110px; height: 30px; value <=> root.shift_media_date_seconds; adjusted(value, delta) => { root.adjust_shift_value(value, delta) } value_changed(value) => { root.shift_media_date_preview = root.update_shift_media_date_preview(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, value, root.shift_media_date_subtract); } }

            Text { x: 22px; y: 174px; width: parent.width - 44px; height: 22px; text: "Preview"; color: NativeColors.text; font-weight: 700; vertical-alignment: center; }
            Rectangle { x: 22px; y: 200px; width: parent.width - 44px; height: 118px; background: NativeColors.subtle_surface; border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
                Text { x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px; text: root.shift_media_date_preview; color: NativeColors.text; font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt); wrap: word-wrap; }
            }

            Rectangle { x: parent.width - 190px; y: parent.height - 48px; width: 76px; height: 30px; background: cancel_shift.has-hover ? NativeColors.hover : NativeColors.surface; border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Cancel"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; }
                cancel_shift := TouchArea { width: 100%; height: 100%; clicked => { root.shift_media_date_visible = false; } }
            }
            Rectangle { x: parent.width - 102px; y: parent.height - 48px; width: 80px; height: 30px; background: apply_shift.has-hover ? NativeColors.selection : NativeColors.surface; border-width: 1px; border-color: NativeColors.accent; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Apply"; color: NativeColors.text; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                apply_shift := TouchArea { width: 100%; height: 100%; clicked => {
                    if (root.apply_shift_media_date(root.shift_media_date_days, root.shift_media_date_hours, root.shift_media_date_minutes, root.shift_media_date_seconds, root.shift_media_date_subtract)) {
                        root.shift_media_date_visible = false;
                    }
                } }
            }
        }
    }

    if time_zone_offset_visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        forward-focus: time_zone_dialog_focus;

        init => { time_zone_dialog_focus.focus(); }

        time_zone_dialog_focus := FocusScope {
            x: 0px; y: 0px; width: 0px; height: 0px;
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.time_zone_offset_visible = false;
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.stage_time_zone_offset(root.time_zone_offset_value, root.time_zone_offset_only_missing)) {
                        root.time_zone_offset_visible = false;
                    }
                    return accept;
                }
                reject
            }
        }

        TouchArea { width: 100%; height: 100%; }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(560px, root.width - 48px);
            height: 390px;
            background: NativeColors.surface;
            border-width: 1px;
            border-color: NativeColors.border;
            border-radius: 6px;

            Text { x: 22px; y: 16px; width: parent.width - 44px; height: 30px; text: "Set Time Zone Offset"; color: NativeColors.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
            Text { x: 22px; y: 48px; width: parent.width - 44px; height: 40px; text: "Assign an offset without changing the recorded date or time. EXIF stores only the numeric UTC offset; zone names below are common examples."; color: NativeColors.secondary_text; wrap: word-wrap; vertical-alignment: center; }
            Text { x: 22px; y: 94px; width: 74px; height: 30px; text: "Offset"; color: NativeColors.secondary_text; vertical-alignment: center; }
            LineEdit {
                x: 100px; y: 94px; width: 112px; height: 30px;
                text <=> root.time_zone_offset_value;
                edited(value) => { root.time_zone_offset_preview = root.update_time_zone_offset_preview(value, root.time_zone_offset_only_missing); }
            }
            Text {
                x: 224px; y: 94px; width: parent.width - 246px; height: 30px;
                text: root.time_zone_offset_value == "+09:00" ? "KST (UTC+09:00)"
                    : (root.time_zone_offset_value == "+00:00" || root.time_zone_offset_value == "-00:00") ? "UTC (+00:00)"
                    : "Numeric UTC offset";
                color: NativeColors.secondary_text;
                vertical-alignment: center;
                overflow: elide;
            }

            for preset[index] in ["KST (+09)", "CET (+01)", "UTC (+00)", "PDT (-07)", "PST (-08)"]: Rectangle {
                x: 22px + index * 94px; y: 134px; width: 86px; height: 28px;
                background: preset_area.has-hover ? NativeColors.hover : NativeColors.surface;
                border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: preset; color: NativeColors.text; font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt); horizontal-alignment: center; vertical-alignment: center; }
                preset_area := TouchArea { width: 100%; height: 100%; clicked => {
                    let offset = index == 0 ? "+09:00" : index == 1 ? "+01:00" : index == 2 ? "+00:00" : index == 3 ? "-07:00" : "-08:00";
                    root.time_zone_offset_value = offset;
                    root.time_zone_offset_preview = root.update_time_zone_offset_preview(offset, root.time_zone_offset_only_missing);
                } }
            }

            Rectangle {
                x: 22px; y: 174px; width: 18px; height: 18px;
                background: NativeColors.surface; border-width: 1px; border-color: NativeColors.border; border-radius: 2px;
                Text { width: 100%; height: 100%; text: root.time_zone_offset_only_missing ? "✓" : ""; color: NativeColors.accent; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { width: 100%; height: 100%; clicked => {
                    root.time_zone_offset_only_missing = !root.time_zone_offset_only_missing;
                    root.time_zone_offset_preview = root.update_time_zone_offset_preview(root.time_zone_offset_value, root.time_zone_offset_only_missing);
                } }
            }
            Text { x: 48px; y: 169px; width: parent.width - 70px; height: 28px; text: "Only set missing offsets"; color: NativeColors.text; vertical-alignment: center; }

            Rectangle { x: 22px; y: 207px; width: parent.width - 44px; height: 124px; background: NativeColors.subtle_surface; border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
                Text { x: 10px; y: 7px; width: parent.width - 20px; height: parent.height - 14px; text: root.time_zone_offset_preview; color: NativeColors.text; font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt); wrap: word-wrap; }
            }

            Rectangle { x: parent.width - 220px; y: parent.height - 48px; width: 76px; height: 30px; background: cancel_zone.has-hover ? NativeColors.hover : NativeColors.surface; border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Cancel"; color: NativeColors.text; horizontal-alignment: center; vertical-alignment: center; }
                cancel_zone := TouchArea { width: 100%; height: 100%; clicked => { root.time_zone_offset_visible = false; } }
            }
            Rectangle { x: parent.width - 132px; y: parent.height - 48px; width: 110px; height: 30px; background: apply_zone.has-hover ? NativeColors.selection : NativeColors.surface; border-width: 1px; border-color: NativeColors.accent; border-radius: 3px;
                Text { width: 100%; height: 100%; text: "Stage for Save"; color: NativeColors.text; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                apply_zone := TouchArea { width: 100%; height: 100%; clicked => {
                    if (root.stage_time_zone_offset(root.time_zone_offset_value, root.time_zone_offset_only_missing)) {
                        root.time_zone_offset_visible = false;
                    }
                } }
            }
        }
    }

    if message_visible || confirm_delete_visible || confirm_metadata_paste_visible || confirm_trailing_rename_visible || confirm_date_overwrite_visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        forward-focus: modal_focus;

        init => {
            modal_focus.focus();
        }

        modal_focus_timer := Timer {
            interval: 1ms;
            running: true;
            triggered => {
                self.running = false;
                modal_focus.focus();
            }
        }

        modal_focus := FocusScope {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;

            capture-key-pressed(event) => {
                if (!root.confirm_delete_visible && !root.confirm_metadata_paste_visible && !root.confirm_trailing_rename_visible && !root.confirm_date_overwrite_visible && (event.text == Key.Return || event.text == " ")) {
                    root.message_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    content_focus.focus();
                    return accept;
                }

                if (!root.confirm_delete_visible && !root.confirm_metadata_paste_visible && !root.confirm_trailing_rename_visible && !root.confirm_date_overwrite_visible && event.text == Key.Escape) {
                    root.message_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    content_focus.focus();
                    return accept;
                }

                if ((root.confirm_delete_visible || root.confirm_metadata_paste_visible || root.confirm_trailing_rename_visible || root.confirm_date_overwrite_visible) && (event.text == Key.LeftArrow || event.text == Key.UpArrow)) {
                    root.confirm_yes_selected = true;
                    return accept;
                }

                if ((root.confirm_delete_visible || root.confirm_metadata_paste_visible || root.confirm_trailing_rename_visible || root.confirm_date_overwrite_visible) && (event.text == Key.RightArrow || event.text == Key.DownArrow)) {
                    root.confirm_yes_selected = false;
                    return accept;
                }

                if (root.confirm_delete_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || ((event.text == Key.Return || event.text == " ") && !root.confirm_yes_selected))) {
                    root.confirm_delete_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    root.focus_file_list();
                    return accept;
                }

                if (root.confirm_delete_visible && (event.text == "Y" || event.text == "y" || ((event.text == Key.Return || event.text == " ") && root.confirm_yes_selected))) {
                    root.confirm_delete_visible = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    root.confirm_delete_file();
                    root.focus_file_list();
                    return accept;
                }

                if (root.confirm_metadata_paste_visible && (event.text == "Y" || event.text == "y" || ((event.text == Key.Return || event.text == " ") && root.confirm_yes_selected))) {
                    root.confirm_metadata_paste_visible = false;
                    root.confirm_metadata_paste(true);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_metadata_paste_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || ((event.text == Key.Return || event.text == " ") && !root.confirm_yes_selected))) {
                    root.confirm_metadata_paste_visible = false;
                    root.confirm_metadata_paste(false);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_date_overwrite_visible && (event.text == "Y" || event.text == "y" || ((event.text == Key.Return || event.text == " ") && root.confirm_yes_selected))) {
                    root.confirm_date_overwrite_visible = false;
                    root.confirm_date_overwrite(true);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_date_overwrite_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || ((event.text == Key.Return || event.text == " ") && !root.confirm_yes_selected))) {
                    root.confirm_date_overwrite_visible = false;
                    root.confirm_date_overwrite(false);
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_trailing_rename_visible && (event.text == "Y" || event.text == "y" || ((event.text == Key.Return || event.text == " ") && root.confirm_yes_selected))) {
                    root.confirm_trailing_rename_visible = false;
                    if (root.confirm_media_prefix_removal_mode) {
                        root.confirm_media_prefix_removal_mode = false;
                        root.confirm_remove_img_vid_prefixes();
                    } else if (root.confirm_number_removal_mode) {
                        root.confirm_number_removal_mode = false;
                        root.confirm_remove_front_or_rear_numbers();
                    } else {
                        root.confirm_move_trailing_numbers();
                    }
                    content_focus.focus();
                    return accept;
                }

                if (root.confirm_trailing_rename_visible && (event.text == "N" || event.text == "n" || event.text == Key.Escape || ((event.text == Key.Return || event.text == " ") && !root.confirm_yes_selected))) {
                    root.confirm_trailing_rename_visible = false;
                    root.confirm_number_removal_mode = false;
                    root.confirm_media_prefix_removal_mode = false;
                    root.message_title = "Operation Failed";
                    root.message_text = "";
                    content_focus.focus();
                    return accept;
                }

                accept
            }
        }

        TouchArea {
            width: 100%;
            height: 100%;
        }

        Rectangle {
            property <length> delete_dialog_height: min(
                root.height - 48px,
                max(210px, 174px + root.delete_message_line_count * 20px)
            );
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.confirm_delete_visible ? 480px : 540px, root.width - 48px);
            height: root.confirm_delete_visible ? self.delete_dialog_height : 190px;
            background: NativeColors.surface;
            border-width: 1px;
            border-color: NativeColors.border;
            border-radius: 8px;
            drop-shadow-color: #00000042;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;

            Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                height: 28px;
                text: root.message_title;
                color: NativeColors.text;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.confirm_delete_visible: Rectangle {
                x: 20px;
                y: 61px;
                width: 40px;
                height: 40px;
                background: NativeColors.danger_soft;
                border-radius: 20px;

                Image {
                    x: 8px;
                    y: 8px;
                    width: 24px;
                    height: 24px;
                    source: @image-url("assets/delete-warning.svg");
                    image-fit: contain;
                }
            }

            if root.confirm_delete_visible: Text {
                x: 76px;
                y: 60px;
                width: parent.width - 96px;
                height: 26px;
                text: root.delete_prompt_text;
                color: NativeColors.text;
                font-size: FontSettings.font_size_pt * 1pt;
                vertical-alignment: center;
            }

            if root.confirm_delete_visible: Rectangle {
                x: 76px;
                y: 94px;
                width: parent.width - 96px;
                height: 16px + root.delete_message_line_count * 20px;
                background: NativeColors.subtle_surface;
                border-width: 1px;
                border-color: NativeColors.divider;
                border-radius: 3px;

                Text {
                    x: 10px;
                    y: 7px;
                    width: parent.width - 20px;
                    height: parent.height - 14px;
                    text: root.delete_names_text
                        + (root.delete_more_text == "" ? "" : "\n" + root.delete_more_text);
                    color: NativeColors.text;
                    font-size: FontSettings.font_size_pt * 1pt;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }

            if !root.confirm_delete_visible: Text {
                x: 20px;
                y: 56px;
                width: parent.width - 40px;
                height: parent.height - 108px;
                text: root.message_text;
                color: NativeColors.text;
                font-size: FontSettings.font_size_pt * 1pt;
                wrap: word-wrap;
            }

            Rectangle {
                y: parent.height - 56px;
                width: 100%;
                height: 56px;
                background: NativeColors.subtle_surface;
                border-radius: 7px;
                Rectangle { width: 100%; height: 12px; background: NativeColors.subtle_surface; }
                HDivider { y: 0px; }
            }

            if !confirm_delete_visible && !confirm_metadata_paste_visible && !confirm_trailing_rename_visible && !confirm_date_overwrite_visible: Rectangle {
                x: parent.width - 92px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: ok_touch.has-hover ? NativeColors.hover : NativeColors.surface;
                border-width: 1px;
                border-color: NativeColors.border;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "OK";
                    color: NativeColors.text;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ok_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.message_visible = false;
                            root.message_title = "Operation Failed";
                            root.message_text = "";
                            content_focus.focus();
                        }
                    }
                }
            }

            if confirm_delete_visible || confirm_metadata_paste_visible || confirm_trailing_rename_visible || confirm_date_overwrite_visible: Rectangle {
                x: parent.width - 92px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: !root.confirm_yes_selected ? NativeColors.selection : no_touch.has-hover ? NativeColors.hover : NativeColors.surface;
                border-width: !root.confirm_yes_selected ? 2px : 1px;
                border-color: !root.confirm_yes_selected ? NativeColors.accent : NativeColors.border;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "No (N)";
                    color: NativeColors.text;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                no_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            if (root.confirm_metadata_paste_visible) {
                                root.confirm_metadata_paste_visible = false;
                                root.confirm_metadata_paste(false);
                                content_focus.focus();
                            } else if (root.confirm_date_overwrite_visible) {
                                root.confirm_date_overwrite_visible = false;
                                root.confirm_date_overwrite(false);
                                content_focus.focus();
                            } else if (root.confirm_trailing_rename_visible) {
                                root.confirm_trailing_rename_visible = false;
                                root.confirm_number_removal_mode = false;
                                root.confirm_media_prefix_removal_mode = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                content_focus.focus();
                            } else {
                                root.confirm_delete_visible = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                root.focus_file_list();
                            }
                        }
                    }
                }
            }

            if confirm_delete_visible || confirm_metadata_paste_visible || confirm_trailing_rename_visible || confirm_date_overwrite_visible: Rectangle {
                x: parent.width - 172px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                background: root.confirm_yes_selected ? NativeColors.danger_soft : yes_touch.has-hover ? NativeColors.danger_soft : NativeColors.surface;
                border-width: root.confirm_yes_selected ? 2px : 1px;
                border-color: root.confirm_yes_selected ? NativeColors.danger : #e5a4aa;
                border-radius: 3px;

                Text {
                    width: 100%;
                    height: 100%;
                    text: "Yes (Y)";
                    color: NativeColors.danger;
                    font-size: FontSettings.font_size_pt * 1pt;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                yes_touch := TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            if (root.confirm_metadata_paste_visible) {
                                root.confirm_metadata_paste_visible = false;
                                root.confirm_metadata_paste(true);
                                content_focus.focus();
                            } else if (root.confirm_date_overwrite_visible) {
                                root.confirm_date_overwrite_visible = false;
                                root.confirm_date_overwrite(true);
                                content_focus.focus();
                            } else if (root.confirm_trailing_rename_visible) {
                                root.confirm_trailing_rename_visible = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                if (root.confirm_media_prefix_removal_mode) {
                                    root.confirm_media_prefix_removal_mode = false;
                                    root.confirm_remove_img_vid_prefixes();
                                } else if (root.confirm_number_removal_mode) {
                                    root.confirm_number_removal_mode = false;
                                    root.confirm_remove_front_or_rear_numbers();
                                } else {
                                    root.confirm_move_trailing_numbers();
                                }
                                content_focus.focus();
                            } else {
                                root.confirm_delete_visible = false;
                                root.message_title = "Operation Failed";
                                root.message_text = "";
                                root.confirm_delete_file();
                                root.focus_file_list();
                            }
                        }
                    }
                }
            }
        }
    }

    if root.log_visible: Rectangle {
        y: root.height - 142px;
        width: 100%;
        height: 116px;
        background: NativeColors.surface;
        border-width: 1px;
        border-color: NativeColors.border;

        log_scroll := ScrollView {
            x: 5px;
            y: 2px;
            width: parent.width - 17px;
            height: parent.height - 4px;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            viewport-width: self.visible-width;
            viewport-height: max(self.visible-height, log_input.preferred-height);

            log_input := TextInput {
                width: log_scroll.visible-width;
                height: max(log_scroll.visible-height, self.preferred-height);
                text: root.log_text;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                color: NativeColors.text;
                selection-background-color: NativeColors.selection;
                selection-foreground-color: NativeColors.text;
                font-family: FontSettings.font_family;
                font-size: FontSettings.font_size_pt * 1pt;
            }
        }

        if log_scroll.viewport-height > log_scroll.visible-height: Rectangle {
            x: parent.width - 12px;
            y: 1px;
            width: 11px;
            height: parent.height - 2px;
            background: #eef2f5;

            log_scroll_area := TouchArea {
                width: 100%;
                height: 100%;

                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        log_scroll.viewport-y = -max(
                            0px,
                            min(
                                log_scroll.viewport-height - log_scroll.visible-height,
                                self.mouse-y * log_scroll.viewport-height / parent.height - log_scroll.visible-height / 2
                            )
                        );
                    }
                }

                moved => {
                    if (self.pressed) {
                        log_scroll.viewport-y = -max(
                            0px,
                            min(
                                log_scroll.viewport-height - log_scroll.visible-height,
                                self.mouse-y * log_scroll.viewport-height / parent.height - log_scroll.visible-height / 2
                            )
                        );
                    }
                }
            }

            Rectangle {
                x: 2px;
                y: 3px + (-log_scroll.viewport-y)
                    * (parent.height - 6px - self.height)
                    / (log_scroll.viewport-height - log_scroll.visible-height);
                width: 7px;
                height: max(24px, (parent.height - 6px) * log_scroll.visible-height / log_scroll.viewport-height);
                border-radius: 2px;
                background: log_scroll_area.has-hover ? #7f8f9a : #9aa8b2;
            }
        }
    }

    HDivider { y: root.height - 27px; }

    Rectangle {
        y: root.height - 26px;
        width: 100%;
        height: 26px;
        background: NativeColors.subtle_surface;

        property <length> count_width: min(440px, max(280px, parent.width * 0.39));
        property <length> right_width: min(250px, max(150px, parent.width * 0.22));

        Text {
            x: 10px;
            width: max(0px, parent.width - parent.count_width - parent.right_width - 32px);
            height: 100%;
            text: root.activity_text;
            font-size: FontSettings.font_size_pt * 1pt;
            color: NativeColors.secondary_text;
            vertical-alignment: center;
            overflow: elide;
        }

        file_count_status := Text {
            x: parent.width - parent.count_width - parent.right_width - 12px;
            width: parent.count_width;
            height: 100%;
            text: root.selected_file_count + " selected | "
                + (root.item_count != root.total_file_count
                    ? root.item_count + " shown / " + root.total_file_count + " files"
                    : root.total_file_count + " files")
                + (root.unsupported_file_count > 0
                    ? " (" + root.unsupported_file_count + " unsupported)"
                    : "");
            font-size: FontSettings.font_size_pt * 1pt;
            color: NativeColors.secondary_text;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle { x: file_count_status.x - 6px; width: 1px; height: 100%; background: NativeColors.divider; }
        Rectangle { x: parent.width - parent.right_width - 6px; width: 1px; height: 100%; background: NativeColors.divider; }

        right_status := Text {
            x: parent.width - parent.right_width;
            width: parent.right_width - 58px;
            height: 100%;
            text: root.scan_status != "" && root.metadata_dirty
                ? root.scan_status + " | Unsaved"
                : (root.scan_status != "" ? root.scan_status : (root.metadata_dirty ? "Unsaved" : ""));
            font-size: FontSettings.font_size_pt * 1pt;
            color: NativeColors.secondary_text;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            x: parent.width - 54px;
            width: 54px;
            height: 100%;
            background: log_button_area.has-hover ? NativeColors.hover : #00000000;
            Text {
                width: 100%;
                height: 100%;
                text: root.log_visible ? "Log -" : "Log +";
                font-size: FontSettings.font_size_pt * 1pt;
                color: NativeColors.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            log_button_area := TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.log_visible = !root.log_visible; }
            }
        }
    }

}
