import { Button, HorizontalBox, Palette } from "std-widgets.slint";
import { FileEntry } from "types.slint";
import { HDivider, StrongVDivider } from "components/dividers.slint";
import { PathBar } from "components/path_bar.slint";
import { FileTable } from "components/file_table.slint";
import { CustomFileTable } from "components/custom_file_table.slint";
import { MetadataPanel } from "components/metadata_panel.slint";

export { FileEntry, Palette }

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: #ffffff;
    default-font-family: "Segoe UI";
    title: "Rust EXIF Tool";

    in-out property <string> current_path: "C:/";
    in-out property <[FileEntry]> files;
    in-out property <[[StandardListViewItem]]> table_rows;
    in-out property <int> selected_index: -1;
    in-out property <bool> editing_path: false;
    in-out property <string> selected_name: "N/A";
    in-out property <string> selected_created: "N/A";
    in-out property <string> selected_modified: "N/A";
    in-out property <bool> selected_is_dir: false;
    in-out property <int> item_count: 0;
    in-out property <string> taken_date: "";
    in-out property <string> camera_make: "";
    in-out property <string> camera_model: "";
    in-out property <string> lens_model: "";
    in-out property <string> software: "";
    in-out property <string> artist: "";
    in-out property <string> shutter_speed: "";
    in-out property <string> aperture: "";
    in-out property <string> iso_speed: "";
    in-out property <string> focal_length: "";
    in-out property <string> flash_fired: "";
    in-out property <string> metering_mode: "";
    in-out property <string> image_width: "";
    in-out property <string> image_height: "";
    in-out property <string> orientation: "";
    in-out property <string> color_space: "";
    in-out property <string> gps_latitude: "";
    in-out property <string> gps_longitude: "";
    in-out property <string> gps_altitude: "";
    in-out property <string> original_selected_name: "N/A";
    in-out property <string> original_selected_created: "N/A";
    in-out property <string> original_selected_modified: "N/A";
    in-out property <string> original_taken_date: "";
    in-out property <string> original_camera_make: "";
    in-out property <string> original_camera_model: "";
    in-out property <string> original_lens_model: "";
    in-out property <string> original_software: "";
    in-out property <string> original_artist: "";
    in-out property <string> original_shutter_speed: "";
    in-out property <string> original_aperture: "";
    in-out property <string> original_iso_speed: "";
    in-out property <string> original_focal_length: "";
    in-out property <string> original_flash_fired: "";
    in-out property <string> original_metering_mode: "";
    in-out property <string> original_image_width: "";
    in-out property <string> original_image_height: "";
    in-out property <string> original_orientation: "";
    in-out property <string> original_color_space: "";
    in-out property <string> original_gps_latitude: "";
    in-out property <string> original_gps_longitude: "";
    in-out property <string> original_gps_altitude: "";
    in-out property <bool> exif_available: false;
    in-out property <bool> metadata_dirty: false;
    in-out property <bool> selected_name_dirty: false;
    in-out property <bool> selected_created_dirty: false;
    in-out property <bool> selected_modified_dirty: false;
    in-out property <bool> taken_date_dirty: false;
    in-out property <bool> camera_make_dirty: false;
    in-out property <bool> camera_model_dirty: false;
    in-out property <bool> lens_model_dirty: false;
    in-out property <bool> software_dirty: false;
    in-out property <bool> artist_dirty: false;
    in-out property <bool> shutter_speed_dirty: false;
    in-out property <bool> aperture_dirty: false;
    in-out property <bool> iso_speed_dirty: false;
    in-out property <bool> focal_length_dirty: false;
    in-out property <bool> flash_fired_dirty: false;
    in-out property <bool> metering_mode_dirty: false;
    in-out property <bool> image_width_dirty: false;
    in-out property <bool> image_height_dirty: false;
    in-out property <bool> orientation_dirty: false;
    in-out property <bool> color_space_dirty: false;
    in-out property <bool> gps_latitude_dirty: false;
    in-out property <bool> gps_longitude_dirty: false;
    in-out property <bool> gps_altitude_dirty: false;
    in-out property <bool> message_visible: false;
    in-out property <string> message_text: "";

    callback open_dir(int);
    callback reload();
    callback go_parent();
    callback change_dir(string);
    callback apply_changes();
    callback revert_changes();
    callback remove_exif_tags();
    callback fill_taken_date_from_filename();
    callback metadata_value_edited();
    callback table_row_clicked(int);
    callback table_row_selected(int);

    MenuBar {
        Menu {
            title: "File";

            MenuItem { title: "Open Folder..."; activated => { root.editing_path = false; } }
            MenuItem { title: "Reload"; activated => { root.editing_path = false; } }
            MenuItem { title: "Go to Parent Folder"; activated => { root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "Open in Explorer"; activated => { root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "Exit"; activated => { root.editing_path = false; } }
        }

        Menu {
            title: "Advanced";

            MenuItem {
                title: "Fill Taken date from Filename";
                activated => {
                    root.editing_path = false;
                    root.fill_taken_date_from_filename();
                }
            }
            MenuItem {
                title: "Remove EXIF Tags";
                activated => {
                    root.editing_path = false;
                    root.remove_exif_tags();
                }
            }
        }

        Menu {
            title: "Analyze";

            MenuItem { title: "Analyze Selected"; activated => { root.editing_path = false; } }
            MenuItem { title: "Analyze Folder"; activated => { root.editing_path = false; } }
            MenuItem { title: "Analyze Missing Metadata"; activated => { root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "Clear Results"; activated => { root.editing_path = false; } }
        }

        Menu {
            title: "Settings";

            MenuItem { title: "Date Source Priority..."; activated => { root.editing_path = false; } }
            MenuItem { title: "Filename Patterns..."; activated => { root.editing_path = false; } }
            MenuSeparator {}
            MenuItem { title: "Write Software Tag"; checkable: true; checked: true; activated => { root.editing_path = false; } }
            MenuItem { title: "Rename With _SH148 Suffix"; checkable: true; activated => { root.editing_path = false; } }
            MenuItem { title: "Backup Before Changes"; checkable: true; checked: true; activated => { root.editing_path = false; } }
        }

        Menu {
            title: "Help";

            MenuItem { title: "About"; activated => { root.editing_path = false; } }
        }
    }

    HDivider { y: 0px; }

    PathBar {
        y: 1px;
        width: 100%;
        current_path: root.current_path;
        editing <=> root.editing_path;
        change_dir(path) => { root.change_dir(path); }
    }

    Rectangle {
        y: 41px;
        width: 100%;
        height: root.height - 67px;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 750px;
            height: 100%;

            CustomFileTable {
                width: 100%;
                height: 100%;
                files: root.files;
                selected_index <=> root.selected_index;
                row_selected(index) => {
                    root.editing_path = false;
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                    if (index >= 0 && index < root.files.length) {
                        root.selected_name = root.files[index].name;
                        root.selected_created = root.files[index].created;
                        root.selected_modified = root.files[index].modified;
                        root.original_selected_name = root.files[index].name;
                        root.original_selected_created = root.files[index].created;
                        root.original_selected_modified = root.files[index].modified;
                        root.selected_is_dir = root.files[index].is_dir;
                    }
                    root.table_row_selected(index);
                }
                row_clicked(index) => {
                    root.table_row_clicked(index);
                }
            }
        }

        StrongVDivider {
            x: 750px;
            y: 0px;
            height: 100%;
        }

        MetadataPanel {
                x: 756px;
                y: 0px;
                width: max(320px, root.width - 756px);
                height: 100%;
                selected_name <=> root.selected_name;
                selected_created <=> root.selected_created;
                selected_modified <=> root.selected_modified;
                taken_date <=> root.taken_date;
                camera_make <=> root.camera_make;
                camera_model <=> root.camera_model;
                lens_model <=> root.lens_model;
                software <=> root.software;
                artist <=> root.artist;
                shutter_speed <=> root.shutter_speed;
                aperture <=> root.aperture;
                iso_speed <=> root.iso_speed;
                focal_length <=> root.focal_length;
                flash_fired <=> root.flash_fired;
                metering_mode <=> root.metering_mode;
                image_width <=> root.image_width;
                image_height <=> root.image_height;
                orientation <=> root.orientation;
                color_space <=> root.color_space;
                gps_latitude <=> root.gps_latitude;
                gps_longitude <=> root.gps_longitude;
                gps_altitude <=> root.gps_altitude;
                exif_available <=> root.exif_available;
                has_pending_changes <=> root.metadata_dirty;
                selected_name_dirty <=> root.selected_name_dirty;
                selected_created_dirty <=> root.selected_created_dirty;
                selected_modified_dirty <=> root.selected_modified_dirty;
                taken_date_dirty <=> root.taken_date_dirty;
                camera_make_dirty <=> root.camera_make_dirty;
                camera_model_dirty <=> root.camera_model_dirty;
                lens_model_dirty <=> root.lens_model_dirty;
                software_dirty <=> root.software_dirty;
                artist_dirty <=> root.artist_dirty;
                shutter_speed_dirty <=> root.shutter_speed_dirty;
                aperture_dirty <=> root.aperture_dirty;
                iso_speed_dirty <=> root.iso_speed_dirty;
                focal_length_dirty <=> root.focal_length_dirty;
                flash_fired_dirty <=> root.flash_fired_dirty;
                metering_mode_dirty <=> root.metering_mode_dirty;
                image_width_dirty <=> root.image_width_dirty;
                image_height_dirty <=> root.image_height_dirty;
                orientation_dirty <=> root.orientation_dirty;
                color_space_dirty <=> root.color_space_dirty;
                gps_latitude_dirty <=> root.gps_latitude_dirty;
                gps_longitude_dirty <=> root.gps_longitude_dirty;
                gps_altitude_dirty <=> root.gps_altitude_dirty;
                apply_changes() => {
                    root.editing_path = false;
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                    root.apply_changes();
                }
                revert_changes() => {
                    root.editing_path = false;
                    root.revert_changes();
                    root.metadata_dirty = false;
                    root.selected_name_dirty = false;
                    root.selected_created_dirty = false;
                    root.selected_modified_dirty = false;
                    root.taken_date_dirty = false;
                    root.camera_make_dirty = false;
                    root.camera_model_dirty = false;
                    root.lens_model_dirty = false;
                    root.software_dirty = false;
                    root.artist_dirty = false;
                    root.shutter_speed_dirty = false;
                    root.aperture_dirty = false;
                    root.iso_speed_dirty = false;
                    root.focal_length_dirty = false;
                    root.flash_fired_dirty = false;
                    root.metering_mode_dirty = false;
                    root.image_width_dirty = false;
                    root.image_height_dirty = false;
                    root.orientation_dirty = false;
                    root.color_space_dirty = false;
                    root.gps_latitude_dirty = false;
                    root.gps_longitude_dirty = false;
                    root.gps_altitude_dirty = false;
                }
                metadata_edited() => {
                    root.metadata_value_edited();
                }
        }
    }

    if message_visible: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea {
            width: 100%;
            height: 100%;
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(420px, root.width - 48px);
            height: 150px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cfd8dc;
            border-radius: 6px;

            Text {
                x: 20px;
                y: 18px;
                width: parent.width - 40px;
                height: 28px;
                text: "Unable to Fill Taken Date";
                color: #263238;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                x: 20px;
                y: 56px;
                width: parent.width - 40px;
                height: 40px;
                text: root.message_text;
                color: #37474f;
                font-size: 12px;
                wrap: word-wrap;
            }

            Button {
                x: parent.width - 92px;
                y: parent.height - 44px;
                width: 72px;
                height: 28px;
                text: "OK";
                clicked => {
                    root.message_visible = false;
                    root.message_text = "";
                }
            }
        }
    }

    HDivider { y: root.height - 27px; }

    Rectangle {
        y: root.height - 26px;
        width: 100%;
        height: 26px;
        background: #f7f7f7;

        Text {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            text: "Files: " + item_count;
            font-size: 12px;
            color: #666666;
            vertical-alignment: center;
        }
    }

}
