import { HorizontalBox } from "std-widgets.slint";
import { FileEntry } from "types.slint";
import { HDivider, StrongVDivider } from "components/dividers.slint";
import { PathBar } from "components/path_bar.slint";
import { FileList } from "components/file_list.slint";
import { MetadataPanel } from "components/metadata_panel.slint";

export { FileEntry }

export component MainWindow inherits Window {
    width: 1200px;
    height: 800px;
    background: #ffffff;
    title: "Rust EXIF Tool";

    in-out property <string> current_path: "C:/";
    in-out property <[FileEntry]> files;
    in-out property <int> selected_index: -1;
    in-out property <bool> editing_path: false;
    in-out property <string> selected_name: "N/A";
    in-out property <string> selected_created: "N/A";
    in-out property <string> selected_modified: "N/A";
    in-out property <bool> selected_is_dir: false;
    in-out property <int> item_count: 0;

    callback open_dir(int);
    callback reload();
    callback go_parent();
    callback change_dir(string);
    callback apply_changes();
    callback cancel_changes();

    Rectangle {
        y: 0px;
        width: 100%;
        height: 32px;
        background: #ffffff;

        HorizontalBox {
            width: 100%;
            height: 100%;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 20px;
            alignment: start;

            Text { text: "파일(F)"; font-size: 13px; color: #333333; vertical-alignment: center; }
            Text { text: "보기(V)"; font-size: 13px; color: #333333; vertical-alignment: center; }
            Text { text: "도구(T)"; font-size: 13px; color: #333333; vertical-alignment: center; }
            Text { text: "도움말(H)"; font-size: 13px; color: #333333; vertical-alignment: center; }
        }
    }

    HDivider { y: 32px; }

    PathBar {
        y: 33px;
        width: 100%;
        current_path: root.current_path;
        editing: root.editing_path;
        change_dir(path) => { root.change_dir(path); }
    }

    Rectangle {
        y: 73px;
        width: 100%;
        height: root.height - 99px;

        HorizontalBox {
            width: 100%;
            height: 100%;
            padding: 0;
            spacing: 0;

            FileList {
                files: root.files;
                selected_index: root.selected_index;
                open_dir(index) => { root.open_dir(index); }
                go_parent() => { root.go_parent(); }
                select_file(name, created, modified, is_dir) => {
                    root.selected_name = name;
                    root.selected_created = created;
                    root.selected_modified = modified;
                    root.selected_is_dir = is_dir;
                }
            }

            StrongVDivider {}

            MetadataPanel {
                selected_name: root.selected_name;
                selected_created: root.selected_created;
                selected_modified: root.selected_modified;
                apply_changes() => { root.apply_changes(); }
                cancel_changes() => { root.cancel_changes(); }
            }
        }
    }

    HDivider { y: root.height - 27px; }

    Rectangle {
        y: root.height - 26px;
        width: 100%;
        height: 26px;
        background: #f7f7f7;

        Text {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            text: "파일 " + item_count + "개";
            font-size: 12px;
            color: #666666;
            vertical-alignment: center;
        }
    }

    if (editing_path) : TouchArea {
        clicked => {
            editing_path = false;
        }
    }
}
