import { StandardTableView } from "std-widgets.slint";

export component FileTable inherits Rectangle {
    in property <[[StandardListViewItem]]> rows;
    in-out property <int> selected_index;
    property <length> header_height: 42px;
    property <length> selected_row_height: rows.length > 0 ? table.viewport-height / rows.length : 0px;
    property <length> selected_row_y: header_height + table.viewport-y + selected_index * selected_row_height;

    callback row_selected(int);
    callback row_clicked(int);

    width: 750px;
    height: 100%;
    background: #ffffff;

    table := StandardTableView {
        width: 100%;
        height: 100%;
        rows: root.rows;
        current-row <=> root.selected_index;
        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
        horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;
        columns: [
            { title: "File Name", min_width: 260px, width: 380px, horizontal_stretch: 1 },
            { title: "Size", min_width: 84px, width: 100px },
            { title: "Modified", min_width: 150px, width: 180px },
        ];

        current-row-changed(row) => {
            root.selected_index = row;
            root.row_selected(row);
        }

        row-pointer-event(row, event, position) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.row_clicked(row);
            }
        }
    }

    if selected_index >= 0 && selected_index < rows.length
        && selected_row_y + selected_row_height >= header_height
        && selected_row_y <= root.height : Rectangle {
        x: 0px;
        y: max(root.header_height, root.selected_row_y);
        width: root.width;
        height: min(root.selected_row_height, root.height - self.y);
        background: #dbeafe66;
    }

    if selected_index >= 0 && selected_index < rows.length
        && selected_row_y + selected_row_height >= header_height
        && selected_row_y <= root.height : Rectangle {
        x: 0px;
        y: max(root.header_height, root.selected_row_y + 4px);
        width: 4px;
        height: max(0px, min(root.selected_row_height - 8px, root.height - self.y));
        background: #2563eb;
        border-radius: 2px;
    }
}
