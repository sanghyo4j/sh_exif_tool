import { VerticalBox, HorizontalBox, ListView } from "std-widgets.slint";
import { FileEntry } from "../types.slint";
import { HDivider } from "dividers.slint";

export component FileList inherits VerticalBox {
    in property <[FileEntry]> files;
    in-out property <int> selected_index;

    callback open_dir(int);
    callback go_parent();
    callback select_file(string, string, string, bool);

    width: 750px;
    height: 100%;
    padding: 0;
    spacing: 0;

    Rectangle {
        height: 30px;
        background: #f5f5f5;

        HorizontalBox {
            width: 100%;
            height: 100%;
            padding-left: 15px;
            padding-right: 15px;

            Text {
                width: 380px;
                text: "파일명";
                font-weight: 700;
                color: #666666;
                vertical-alignment: center;
            }

            Text {
                width: 80px;
                text: "크기";
                font-weight: 700;
                color: #666666;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            Rectangle { width: 20px; }

            Text {
                text: "수정일";
                font-weight: 700;
                color: #666666;
                vertical-alignment: center;
            }
        }

        HDivider { y: 29px; }
    }

    ListView {
        for entry[i] in files : Rectangle {
            height: 32px;
            background: i == root.selected_index ? #e3f2fd : #ffffff;

            TouchArea {
                width: 100%;
                height: 100%;

                clicked => {
                    root.selected_index = i;
                    root.select_file(entry.name, entry.created, entry.modified, entry.is_dir);
                }

                double-clicked => {
                    if (entry.name == "[..]") {
                        root.go_parent();
                    } else if (entry.is_dir) {
                        root.open_dir(i);
                    }
                }

                HorizontalBox {
                    width: 100%;
                    height: 100%;
                    padding-left: 15px;
                    padding-right: 15px;

                    Text {
                        width: 380px;
                        text: entry.is_dir ? (entry.name == "[..]" ? "[..]" : "[" + entry.name + "]") : entry.name;
                        vertical-alignment: center;
                        color: i == root.selected_index ? #1976d2 : #212121;
                        overflow: elide;
                    }

                    Text {
                        width: 80px;
                        text: entry.size;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        color: #666666;
                    }

                    Rectangle { width: 20px; }

                    Text {
                        text: entry.modified;
                        vertical-alignment: center;
                        color: #666666;
                    }
                }
            }
        }
    }
}
