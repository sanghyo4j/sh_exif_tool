export component HDivider inherits Rectangle {
    background: #e0e0e0;
    height: 1px;
    width: 100%;
}

export component StrongVDivider inherits Rectangle {
    width: 6px;
    background: #f5f5f5;

    Rectangle {
        x: 2px;
        width: 1px;
        height: 100%;
        background: #e0e0e0;
    }
}
