import { VerticalBox, HorizontalBox, ScrollView, Button } from "std-widgets.slint";
import { SectionHeader, EditableInfoRow } from "info_row.slint";

export component MetadataPanel inherits Rectangle {
    in-out property <string> selected_name;
    in-out property <string> selected_created;
    in-out property <string> selected_modified;

    callback apply_changes();
    callback cancel_changes();

    horizontal-stretch: 1;
    height: 100%;
    background: #fcfcfc;

    VerticalBox {
        width: 100%;
        height: 100%;
        padding: 0;
        spacing: 0;

        Rectangle {
            height: 42px;
            background: #ffffff;

            Text {
                x: 16px;
                y: 0px;
                width: parent.width - 32px;
                height: 100%;
                text: "Image Metadata";
                font-size: 15px;
                color: #263238;
                font-weight: 700;
                horizontal-alignment: left;
                vertical-alignment: center;
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #eeeeee;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #fcfcfc;

            ScrollView {
                width: 100%;
                height: 100%;
                viewport-height: info_container.preferred-height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-on;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                info_container := VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 4px;
                    padding-right: 14px;
                    spacing: 0px;

                    SectionHeader { title: "FILE"; }
                    EditableInfoRow { label: "Name"; value: selected_name; }
                    EditableInfoRow { label: "Created"; value: selected_created; }
                    EditableInfoRow { label: "Modified"; value: selected_modified; }

                    SectionHeader { title: "CAMERA"; }
                    EditableInfoRow { label: "Taken"; value: "N/A"; }
                    EditableInfoRow { label: "Make"; value: "N/A"; }
                    EditableInfoRow { label: "Model"; value: "N/A"; }
                    EditableInfoRow { label: "Lens"; value: "N/A"; }
                    EditableInfoRow { label: "Software"; value: "N/A"; }
                    EditableInfoRow { label: "Artist"; value: "N/A"; }

                    SectionHeader { title: "EXPOSURE"; }
                    EditableInfoRow { label: "Shutter"; value: "N/A"; }
                    EditableInfoRow { label: "Aperture"; value: "N/A"; }
                    EditableInfoRow { label: "ISO"; value: "N/A"; }
                    EditableInfoRow { label: "Focal Length"; value: "N/A"; }
                    EditableInfoRow { label: "Flash"; value: "N/A"; }
                    EditableInfoRow { label: "Metering"; value: "N/A"; }

                    SectionHeader { title: "IMAGE"; }
                    EditableInfoRow { label: "Width"; value: "N/A"; }
                    EditableInfoRow { label: "Height"; value: "N/A"; }
                    EditableInfoRow { label: "Orientation"; value: "N/A"; }
                    EditableInfoRow { label: "Color Space"; value: "N/A"; }

                    SectionHeader { title: "LOCATION"; }
                    EditableInfoRow { label: "Latitude"; value: "N/A"; }
                    EditableInfoRow { label: "Longitude"; value: "N/A"; }
                    EditableInfoRow { label: "Altitude"; value: "N/A"; }
                }
            }
        }

        Rectangle {
            height: 56px;
            background: #f5f5f5;

            HorizontalBox {
                width: 100%;
                height: 100%;
                padding: 12px;
                spacing: 12px;
                alignment: end;

                Button {
                    text: "Cancel";
                    clicked => { root.cancel_changes(); }
                }

                Button {
                    text: "Apply";
                    primary: true;
                    clicked => { root.apply_changes(); }
                }
            }
        }
    }
}
