import { VerticalBox, HorizontalBox, ScrollView, Button } from "std-widgets.slint";
import { SectionHeader, EditableInfoRow, ReadOnlyCheckRow } from "info_row.slint";
import { FontSettings } from "../theme.slint";

component TabButton inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback clicked();

    width: 88px;
    height: 24px;
    background: active ? #ffffff : area.has-hover ? #e8f0f5 : #edf3f7;
    border-width: 1px;
    border-color: active ? #b8c6cf : #cbd6dd;
    border-radius: 2px;

    if active: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 3px;
        background: #315a72;
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.title;
        font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt);
        color: root.active ? #1f3440 : #667781;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    callback clicked();

    width: 96px;
    height: 30px;
    background: !enabled ? #f6f7f8 : area.has-hover ? #eef4f8 : #ffffff;
    border-width: 1px;
    border-color: !enabled ? #d9dee2 : area.has-hover ? #8aa8ba : #9aa5ad;
    border-radius: 3px;

    Text {
        width: 100%;
        height: 100%;
        text: root.title;
        font-size: FontSettings.font_size_pt * 1pt;
        color: root.enabled ? #34434c : #9aa1a6;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component MetadataPanel inherits Rectangle {
    in-out property <string> selected_name;
    in-out property <string> selected_created;
    in-out property <string> selected_modified;
    in-out property <string> taken_date;
    in-out property <string> camera_make;
    in-out property <string> camera_model;
    in-out property <string> lens_model;
    in-out property <string> software;
    in-out property <string> artist;
    in-out property <string> shutter_speed;
    in-out property <string> aperture;
    in-out property <string> iso_speed;
    in-out property <string> focal_length;
    in-out property <string> flash_fired;
    in-out property <string> metering_mode;
    in-out property <string> image_width;
    in-out property <string> image_height;
    in-out property <string> orientation;
    in-out property <string> color_space;
    in-out property <string> gps_latitude;
    in-out property <string> gps_longitude;
    in-out property <string> gps_altitude;
    in-out property <bool> exif_available: false;
    in-out property <bool> has_pending_changes: false;
    in-out property <bool> selected_name_dirty: false;
    in-out property <bool> selected_created_dirty: false;
    in-out property <bool> selected_modified_dirty: false;
    in-out property <bool> taken_date_dirty: false;
    in-out property <bool> camera_make_dirty: false;
    in-out property <bool> camera_model_dirty: false;
    in-out property <bool> lens_model_dirty: false;
    in-out property <bool> software_dirty: false;
    in-out property <bool> artist_dirty: false;
    in-out property <bool> shutter_speed_dirty: false;
    in-out property <bool> aperture_dirty: false;
    in-out property <bool> iso_speed_dirty: false;
    in-out property <bool> focal_length_dirty: false;
    in-out property <bool> flash_fired_dirty: false;
    in-out property <bool> metering_mode_dirty: false;
    in-out property <bool> image_width_dirty: false;
    in-out property <bool> image_height_dirty: false;
    in-out property <bool> orientation_dirty: false;
    in-out property <bool> color_space_dirty: false;
    in-out property <bool> gps_latitude_dirty: false;
    in-out property <bool> gps_longitude_dirty: false;
    in-out property <bool> gps_altitude_dirty: false;

    callback apply_changes();
    callback revert_changes();
    callback duplicate_file();
    callback fill_taken_date_from_filename();
    callback remove_exif_tags();
    callback metadata_edited();
    callback shortcut_requested(string);

    property <int> selected_tab: 0;

    public function focus_file_name() {
        root.selected_tab = 0;
    }

    public function clear_editor_focus() {
        focus_sink.focus();
    }

    background: #fcfcfc;

    focus_sink := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
    }

    VerticalBox {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 32px;
            background: #edf3f7;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: #cfdbe2;
            }

            HorizontalBox {
                x: 8px;
                y: 4px;
                width: parent.width - 16px;
                height: 24px;
                spacing: 4px;

                TabButton { title: "Metadata"; active: root.selected_tab == 0; clicked => { root.selected_tab = 0; } }
                TabButton { title: "Advanced"; active: root.selected_tab == 1; clicked => { root.selected_tab = 1; } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #fcfcfc;

            if root.selected_tab == 0: ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    width: parent.viewport-width;
                    padding-top: 10px;
                    padding-bottom: 18px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 0px;

                    SectionHeader { title: "FILE"; }
                    EditableInfoRow { label: "File Name"; value <=> root.selected_name; dirty <=> root.selected_name_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "File Created"; value <=> root.selected_created; dirty <=> root.selected_created_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "File Modified"; value <=> root.selected_modified; dirty <=> root.selected_modified_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    ReadOnlyCheckRow { label: "EXIF Tag Available"; checked: root.exif_available; }

                    SectionHeader { title: "CAMERA"; }
                    EditableInfoRow { label: "Taken Date"; value <=> root.taken_date; dirty <=> root.taken_date_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Camera Make"; value <=> root.camera_make; dirty <=> root.camera_make_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Camera Model"; value <=> root.camera_model; dirty <=> root.camera_model_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Lens Model"; value <=> root.lens_model; dirty <=> root.lens_model_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Software"; value <=> root.software; dirty <=> root.software_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Artist"; value <=> root.artist; dirty <=> root.artist_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }

                    SectionHeader { title: "EXPOSURE"; }
                    EditableInfoRow { label: "Shutter Speed"; value <=> root.shutter_speed; dirty <=> root.shutter_speed_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Aperture"; value <=> root.aperture; dirty <=> root.aperture_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "ISO Speed"; value <=> root.iso_speed; dirty <=> root.iso_speed_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Focal Length"; value <=> root.focal_length; dirty <=> root.focal_length_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Flash Fired"; value <=> root.flash_fired; dirty <=> root.flash_fired_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Metering Mode"; value <=> root.metering_mode; dirty <=> root.metering_mode_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }

                    SectionHeader { title: "IMAGE"; }
                    EditableInfoRow { label: "Image Width"; value <=> root.image_width; dirty <=> root.image_width_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Image Height"; value <=> root.image_height; dirty <=> root.image_height_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Orientation"; value <=> root.orientation; dirty <=> root.orientation_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "Color Space"; value <=> root.color_space; dirty <=> root.color_space_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }

                    SectionHeader { title: "LOCATION"; }
                    EditableInfoRow { label: "GPS Latitude"; value <=> root.gps_latitude; dirty <=> root.gps_latitude_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "GPS Longitude"; value <=> root.gps_longitude; dirty <=> root.gps_longitude_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "GPS Altitude"; value <=> root.gps_altitude; dirty <=> root.gps_altitude_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                }
            }

            if root.selected_tab == 1: VerticalLayout {
                width: 100%;
                padding-top: 10px;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                SectionHeader { title: "BATCH"; }
                Button { height: 30px; text: "Rename"; clicked => { root.selected_tab = 0; } }
                Button { height: 30px; text: "Extract Taken Date from Filename"; clicked => { root.fill_taken_date_from_filename(); } }

                SectionHeader { title: "FILE"; }
                Button { height: 30px; text: "Duplicate"; clicked => { root.duplicate_file(); } }
                Button { height: 30px; text: "Remove EXIF Tags"; clicked => { root.remove_exif_tags(); } }
            }
        }

        Rectangle {
            height: 48px;
            background: #ffffff;

            ActionButton {
                x: parent.width - 212px;
                y: 9px;
                width: 96px;
                height: 30px;
                title: "Revert";
                enabled: root.has_pending_changes;
                clicked => { root.revert_changes(); }
            }

            ActionButton {
                x: parent.width - 108px;
                y: 9px;
                width: 96px;
                height: 30px;
                title: "Save";
                enabled: root.has_pending_changes;
                clicked => {
                    focus_sink.focus();
                    root.apply_changes();
                }
            }
        }
    }
}
