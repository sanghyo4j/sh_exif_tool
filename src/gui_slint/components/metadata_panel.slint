import { VerticalBox, HorizontalBox, ScrollView, Button, StandardButton } from "std-widgets.slint";
import { SectionHeader, EditableInfoRow, ReadOnlyCheckRow } from "info_row.slint";

export component MetadataPanel inherits Rectangle {
    in-out property <string> selected_name;
    in-out property <string> selected_created;
    in-out property <string> selected_modified;
    in-out property <string> taken_date;
    in-out property <string> camera_make;
    in-out property <string> camera_model;
    in-out property <string> lens_model;
    in-out property <string> software;
    in-out property <string> artist;
    in-out property <string> shutter_speed;
    in-out property <string> aperture;
    in-out property <string> iso_speed;
    in-out property <string> focal_length;
    in-out property <string> flash_fired;
    in-out property <string> metering_mode;
    in-out property <string> image_width;
    in-out property <string> image_height;
    in-out property <string> orientation;
    in-out property <string> color_space;
    in-out property <string> gps_latitude;
    in-out property <string> gps_longitude;
    in-out property <string> gps_altitude;
    in-out property <bool> exif_available: false;
    in-out property <bool> has_pending_changes: false;

    callback apply_changes();
    callback revert_changes();

    horizontal-stretch: 1;
    height: 100%;
    background: #fcfcfc;

    VerticalBox {
        width: 100%;
        height: 100%;
        padding: 0;
        spacing: 0;

        Rectangle {
            height: 42px;
            background: #ffffff;

            HorizontalBox {
                width: 100%;
                height: 100%;
                padding-left: 16px;
                padding-right: 12px;
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    text: "Image Metadata";
                    font-size: 15px;
                    color: #263238;
                    font-weight: 700;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                Button {
                    text: "Revert";
                    enabled: root.has_pending_changes;
                    clicked => { root.revert_changes(); }
                }

                StandardButton {
                    kind: StandardButtonKind.apply;
                    enabled: root.has_pending_changes;
                    clicked => { root.apply_changes(); }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: #eeeeee;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #fcfcfc;

            metadata_scroll := ScrollView {
                width: parent.width - 12px;
                height: 100%;
                viewport-width: self.width - 4px;
                viewport-height: info_container.preferred-height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                info_container := VerticalLayout {
                    width: parent.viewport-width;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 4px;
                    padding-right: 8px;
                    spacing: 0px;

                    SectionHeader { title: "FILE"; }
                    EditableInfoRow { label: "File Name"; value <=> root.selected_name; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "File Created"; value <=> root.selected_created; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "File Modified"; value <=> root.selected_modified; value_edited => { root.has_pending_changes = true; } }
                    ReadOnlyCheckRow { label: "EXIF Tag Available"; checked: root.exif_available; }

                    SectionHeader { title: "CAMERA"; }
                    EditableInfoRow { label: "Taken Date"; value <=> root.taken_date; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Camera Make"; value <=> root.camera_make; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Camera Model"; value <=> root.camera_model; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Lens Model"; value <=> root.lens_model; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Software"; value <=> root.software; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Artist"; value <=> root.artist; value_edited => { root.has_pending_changes = true; } }

                    SectionHeader { title: "EXPOSURE"; }
                    EditableInfoRow { label: "Shutter Speed"; value <=> root.shutter_speed; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Aperture"; value <=> root.aperture; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "ISO Speed"; value <=> root.iso_speed; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Focal Length"; value <=> root.focal_length; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Flash Fired"; value <=> root.flash_fired; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Metering Mode"; value <=> root.metering_mode; value_edited => { root.has_pending_changes = true; } }

                    SectionHeader { title: "IMAGE"; }
                    EditableInfoRow { label: "Image Width"; value <=> root.image_width; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Image Height"; value <=> root.image_height; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Orientation"; value <=> root.orientation; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "Color Space"; value <=> root.color_space; value_edited => { root.has_pending_changes = true; } }

                    SectionHeader { title: "LOCATION"; }
                    EditableInfoRow { label: "GPS Latitude"; value <=> root.gps_latitude; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "GPS Longitude"; value <=> root.gps_longitude; value_edited => { root.has_pending_changes = true; } }
                    EditableInfoRow { label: "GPS Altitude"; value <=> root.gps_altitude; value_edited => { root.has_pending_changes = true; } }
                }
            }

            metadata_rail := Rectangle {
                x: parent.width - 12px;
                y: 0px;
                width: 12px;
                height: parent.height;
                background: #eef2f5;

                TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            if (metadata_scroll.viewport-height > metadata_scroll.visible-height) {
                                metadata_scroll.viewport-y = -max(
                                    0px,
                                    min(
                                        metadata_scroll.viewport-height - metadata_scroll.visible-height,
                                        self.mouse-y * metadata_scroll.viewport-height / parent.height - metadata_scroll.visible-height / 2
                                    )
                                );
                            }
                        }
                    }

                    moved => {
                        if (self.pressed && metadata_scroll.viewport-height > metadata_scroll.visible-height) {
                            metadata_scroll.viewport-y = -max(
                                0px,
                                min(
                                    metadata_scroll.viewport-height - metadata_scroll.visible-height,
                                    self.mouse-y * metadata_scroll.viewport-height / parent.height - metadata_scroll.visible-height / 2
                                )
                            );
                        }
                    }

                    clicked => {
                        if (metadata_scroll.viewport-height > metadata_scroll.visible-height) {
                            metadata_scroll.viewport-y = -max(
                                0px,
                                min(
                                    metadata_scroll.viewport-height - metadata_scroll.visible-height,
                                    self.mouse-y * metadata_scroll.viewport-height / parent.height - metadata_scroll.visible-height / 2
                                )
                            );
                        }
                    }
                }

                metadata_thumb := Rectangle {
                    x: 2px;
                    y: metadata_scroll.viewport-height <= metadata_scroll.visible-height
                        ? 4px
                        : 4px + (-metadata_scroll.viewport-y)
                            * (parent.height - 8px - self.height)
                            / (metadata_scroll.viewport-height - metadata_scroll.visible-height);
                    width: 8px;
                    height: metadata_scroll.viewport-height <= metadata_scroll.visible-height
                        ? parent.height - 8px
                        : max(28px, (parent.height - 8px) * metadata_scroll.visible-height / metadata_scroll.viewport-height);
                    border-radius: 4px;
                    background: #9aa8b2;
                }
            }
        }
    }
}
