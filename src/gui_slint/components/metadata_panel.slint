import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { SectionHeader, EditableInfoRow, ExifAvailabilityRow, CreateExifRow } from "info_row.slint";
import { FontSettings } from "../theme.slint";

component ToolButton inherits Rectangle {
    in property <string> title;
    callback clicked();

    width: 78px;
    height: 24px;
    background: area.has-hover ? #e8f0f5 : #ffffff;
    border-width: 1px;
    border-color: area.has-hover ? #8aa8ba : #b8c6cf;
    border-radius: 2px;

    Text {
        x: 9px;
        width: parent.width - 24px;
        height: 100%;
        text: root.title;
        font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt);
        color: #1f3440;
        font-weight: 700;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 18px;
        width: 14px;
        height: 100%;
        text: "v";
        font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
        color: #52626d;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component MenuRow inherits Rectangle {
    in property <string> title;
    in property <bool> danger: false;
    callback clicked();

    x: 1px;
    width: 278px;
    height: 31px;
    background: area.has-hover ? (danger ? #fff1f1 : #eaf4ff) : #ffffff;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text: root.title;
        font-size: FontSettings.font_size_pt * 1pt;
        color: root.danger ? #b42318 : #1f2933;
        vertical-alignment: center;
        overflow: elide;
    }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    callback clicked();

    width: 96px;
    height: 30px;
    background: !enabled ? #f6f7f8 : area.has-hover ? #eef4f8 : #ffffff;
    border-width: 1px;
    border-color: !enabled ? #d9dee2 : area.has-hover ? #8aa8ba : #9aa5ad;
    border-radius: 3px;

    Text {
        width: 100%;
        height: 100%;
        text: root.title;
        font-size: FontSettings.font_size_pt * 1pt;
        color: root.enabled ? #34434c : #9aa1a6;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    area := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component MetadataPanel inherits Rectangle {
    in-out property <string> selected_name;
    in-out property <string> selected_created;
    in-out property <string> selected_modified;
    in-out property <string> taken_date;
    in-out property <string> camera_make;
    in-out property <string> camera_model;
    in-out property <string> lens_model;
    in-out property <string> software;
    in-out property <string> artist;
    in-out property <string> shutter_speed;
    in-out property <string> aperture;
    in-out property <string> iso_speed;
    in-out property <string> focal_length;
    in-out property <string> flash_fired;
    in-out property <string> metering_mode;
    in-out property <string> image_width;
    in-out property <string> image_height;
    in-out property <string> orientation;
    in-out property <string> color_space;
    in-out property <string> gps_latitude;
    in-out property <string> gps_longitude;
    in-out property <string> gps_altitude;
    in-out property <string> selected_name_status;
    in-out property <string> selected_created_status;
    in-out property <string> selected_modified_status;
    in-out property <string> taken_date_status;
    in-out property <string> camera_make_status;
    in-out property <string> camera_model_status;
    in-out property <string> lens_model_status;
    in-out property <string> software_status;
    in-out property <string> artist_status;
    in-out property <string> shutter_speed_status;
    in-out property <string> aperture_status;
    in-out property <string> iso_speed_status;
    in-out property <string> focal_length_status;
    in-out property <string> flash_fired_status;
    in-out property <string> metering_mode_status;
    in-out property <string> image_width_status;
    in-out property <string> image_height_status;
    in-out property <string> orientation_status;
    in-out property <string> color_space_status;
    in-out property <string> gps_latitude_status;
    in-out property <string> gps_longitude_status;
    in-out property <string> gps_altitude_status;
    in-out property <bool> exif_available: false;
    in-out property <bool> has_pending_changes: false;
    in-out property <bool> selected_name_dirty: false;
    in-out property <bool> selected_created_dirty: false;
    in-out property <bool> selected_modified_dirty: false;
    in-out property <bool> taken_date_dirty: false;
    in-out property <bool> camera_make_dirty: false;
    in-out property <bool> camera_model_dirty: false;
    in-out property <bool> lens_model_dirty: false;
    in-out property <bool> software_dirty: false;
    in-out property <bool> artist_dirty: false;
    in-out property <bool> shutter_speed_dirty: false;
    in-out property <bool> aperture_dirty: false;
    in-out property <bool> iso_speed_dirty: false;
    in-out property <bool> focal_length_dirty: false;
    in-out property <bool> flash_fired_dirty: false;
    in-out property <bool> metering_mode_dirty: false;
    in-out property <bool> image_width_dirty: false;
    in-out property <bool> image_height_dirty: false;
    in-out property <bool> orientation_dirty: false;
    in-out property <bool> color_space_dirty: false;
    in-out property <bool> gps_latitude_dirty: false;
    in-out property <bool> gps_longitude_dirty: false;
    in-out property <bool> gps_altitude_dirty: false;

    callback apply_changes();
    callback revert_changes();
    callback fill_taken_date_from_filename();
    callback fill_taken_date_from_created_date();
    callback set_modified_date_from_created_date();
    callback remove_exif_tags();
    callback remove_gps_information();
    callback create_exif_structure();
    callback metadata_edited();
    callback shortcut_requested(string);

    property <bool> tools_menu_visible: false;

    public function focus_file_name() {
        file_name_row.focus_input();
    }

    public function clear_editor_focus() {
        focus_sink.focus();
    }

    background: #fcfcfc;

    focus_sink := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;
    }

    VerticalBox {
        width: 100%;
        height: 100%;
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: 32px;
            background: #edf3f7;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: #cfdbe2;
            }

            Text {
                x: 12px;
                width: parent.width - 104px;
                height: 100%;
                text: "Metadata";
                font-size: max(10pt, FontSettings.font_size_pt * 1pt);
                font-weight: 800;
                color: #203d4e;
                vertical-alignment: center;
                overflow: elide;
            }

            ToolButton {
                x: parent.width - 90px;
                y: 4px;
                title: "Tools";
                clicked => {
                    root.tools_menu_visible = !root.tools_menu_visible;
                    focus_sink.focus();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: #fcfcfc;

            ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    width: parent.viewport-width;
                    padding-top: 10px;
                    padding-bottom: 18px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 0px;

                    SectionHeader { title: "FILE"; }
                    file_name_row := EditableInfoRow { label: "File Name"; value <=> root.selected_name; status <=> root.selected_name_status; dirty <=> root.selected_name_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "File Created"; value <=> root.selected_created; status <=> root.selected_created_status; dirty <=> root.selected_created_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    EditableInfoRow { label: "File Modified"; value <=> root.selected_modified; status <=> root.selected_modified_status; dirty <=> root.selected_modified_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    ExifAvailabilityRow {
                        label: "EXIF Tag Available";
                        available: root.exif_available;
                    }

                    if !root.exif_available: CreateExifRow {
                        create_requested => { root.create_exif_structure(); }
                    }

                    if root.exif_available: SectionHeader { title: "CAMERA"; }
                    if root.exif_available: EditableInfoRow { label: "Taken Date"; value <=> root.taken_date; status <=> root.taken_date_status; dirty <=> root.taken_date_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Camera Make"; value <=> root.camera_make; status <=> root.camera_make_status; dirty <=> root.camera_make_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Camera Model"; value <=> root.camera_model; status <=> root.camera_model_status; dirty <=> root.camera_model_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Lens Model"; value <=> root.lens_model; status <=> root.lens_model_status; dirty <=> root.lens_model_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Software"; value <=> root.software; status <=> root.software_status; dirty <=> root.software_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Artist"; value <=> root.artist; status <=> root.artist_status; dirty <=> root.artist_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }

                    if root.exif_available: SectionHeader { title: "EXPOSURE"; }
                    if root.exif_available: EditableInfoRow { label: "Shutter Speed"; value <=> root.shutter_speed; status <=> root.shutter_speed_status; dirty <=> root.shutter_speed_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Aperture"; value <=> root.aperture; status <=> root.aperture_status; dirty <=> root.aperture_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "ISO Speed"; value <=> root.iso_speed; status <=> root.iso_speed_status; dirty <=> root.iso_speed_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Focal Length"; value <=> root.focal_length; status <=> root.focal_length_status; dirty <=> root.focal_length_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Flash Fired"; value <=> root.flash_fired; status <=> root.flash_fired_status; dirty <=> root.flash_fired_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Metering Mode"; value <=> root.metering_mode; status <=> root.metering_mode_status; dirty <=> root.metering_mode_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }

                    if root.exif_available: SectionHeader { title: "IMAGE"; }
                    if root.exif_available: EditableInfoRow { label: "Image Width"; value <=> root.image_width; status <=> root.image_width_status; dirty <=> root.image_width_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Image Height"; value <=> root.image_height; status <=> root.image_height_status; dirty <=> root.image_height_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Orientation"; value <=> root.orientation; status <=> root.orientation_status; dirty <=> root.orientation_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "Color Space"; value <=> root.color_space; status <=> root.color_space_status; dirty <=> root.color_space_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }

                    if root.exif_available: SectionHeader {
                        title: "LOCATION";
                        action_title: "Remove GPS";
                        action_enabled: root.gps_latitude != "" || root.gps_longitude != "" || root.gps_altitude != "" || root.gps_latitude_status == "Mixed" || root.gps_longitude_status == "Mixed" || root.gps_altitude_status == "Mixed";
                        action_clicked => { root.remove_gps_information(); }
                    }
                    if root.exif_available: EditableInfoRow { label: "GPS Latitude"; value <=> root.gps_latitude; status <=> root.gps_latitude_status; dirty <=> root.gps_latitude_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "GPS Longitude"; value <=> root.gps_longitude; status <=> root.gps_longitude_status; dirty <=> root.gps_longitude_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                    if root.exif_available: EditableInfoRow { label: "GPS Altitude"; value <=> root.gps_altitude; status <=> root.gps_altitude_status; dirty <=> root.gps_altitude_dirty; value_edited => { root.metadata_edited(); } shortcut_requested(action) => { root.shortcut_requested(action); } }
                }
            }
        }

        Rectangle {
            height: 48px;
            background: #ffffff;

            ActionButton {
                x: parent.width - 212px;
                y: 9px;
                width: 96px;
                height: 30px;
                title: "Revert";
                enabled: root.has_pending_changes;
                clicked => { root.revert_changes(); }
            }

            ActionButton {
                x: parent.width - 108px;
                y: 9px;
                width: 96px;
                height: 30px;
                title: "Save";
                enabled: root.has_pending_changes;
                clicked => {
                    focus_sink.focus();
                    root.apply_changes();
                }
            }
        }
    }

    if tools_menu_visible: TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.tools_menu_visible = false;
        }
    }

    if tools_menu_visible: Rectangle {
        x: parent.width - 292px;
        y: 30px;
        width: 280px;
        height: 129px;
        background: #ffffff;
        border-width: 1px;
        border-color: #cfd8dc;
        border-radius: 3px;

        MenuRow { y: 1px; title: "Set Taken Date from Filename"; clicked => { root.tools_menu_visible = false; root.fill_taken_date_from_filename(); } }
        Rectangle { y: 32px; width: 100%; height: 1px; background: #edf0f2; }
        MenuRow { y: 33px; title: "Set Taken Date from File Timestamp"; clicked => { root.tools_menu_visible = false; root.fill_taken_date_from_created_date(); } }
        Rectangle { y: 64px; width: 100%; height: 1px; background: #edf0f2; }
        MenuRow { y: 65px; title: "Set Modified Date from Created Date"; clicked => { root.tools_menu_visible = false; root.set_modified_date_from_created_date(); } }
        Rectangle { y: 96px; width: 100%; height: 1px; background: #edf0f2; }
        MenuRow { y: 97px; title: "Remove EXIF Tags"; danger: true; clicked => { root.tools_menu_visible = false; root.remove_exif_tags(); } }
    }
}
