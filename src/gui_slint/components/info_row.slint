import { CheckBox, HorizontalBox } from "std-widgets.slint";
import { HDivider } from "dividers.slint";
import { FontSettings } from "../theme.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 30px;
    background: #e7f0f5;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4px;
        height: 100%;
        background: #3d7895;
    }

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 18px;
        padding-right: 12px;
        spacing: 0px;

        Text {
            text: title;
            font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt);
            font-weight: 800;
            color: #203d4e;
            vertical-alignment: center;
        }
    }
}

export component EditableInfoRow inherits Rectangle {
    in property <string> label;
    in property <bool> dirty: false;
    in-out property <string> value;
    callback value_edited();
    callback shortcut_requested(string);

    public function focus_input() {
        input.focus();
        input.select-all();
    }

    height: 36px;
    background: #ffffff;

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        Text {
            text: label;
            width: 126px;
            color: #455a64;
            font-size: FontSettings.font_size_pt * 1pt;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: input.has-focus ? #eaf4ff : (root.dirty ? #fff7d6 : #ffffff);
            border-width: 1px;
            border-color: input.has-focus ? #2563eb : (root.dirty ? #e5c85d : #edf0f2);
            border-radius: 3px;

            input := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                text <=> root.value;
                font-size: FontSettings.font_size_pt * 1pt;
                vertical-alignment: center;
                single-line: true;
                color: #1f2933;

                edited => {
                    root.value_edited();
                }

                key-pressed(event) => {
                    if (event.text == Key.F5) {
                        root.shortcut_requested("refresh");
                        return accept;
                    }

                    if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) {
                        root.shortcut_requested("open-folder");
                        return accept;
                    }

                    if ((event.text == "S" || event.text == "s") && event.modifiers.control) {
                        root.shortcut_requested("save");
                        return accept;
                    }

                    if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) {
                        root.shortcut_requested("open-explorer");
                        return accept;
                    }

                    if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) {
                        root.shortcut_requested("revert");
                        return accept;
                    }

                    if ((event.text == "W" || event.text == "w") && event.modifiers.control) {
                        root.shortcut_requested("exit");
                        return accept;
                    }

                    reject
                }
            }
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}

export component ReadOnlyCheckRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked;

    height: 36px;
    background: #ffffff;

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        Text {
            text: label;
            width: 126px;
            color: #455a64;
            font-size: FontSettings.font_size_pt * 1pt;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalBox {
            horizontal-stretch: 1;
            spacing: 8px;

            CheckBox {
                checked: root.checked;
                enabled: false;
            }
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}
