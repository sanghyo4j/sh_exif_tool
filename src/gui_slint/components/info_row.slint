import { HorizontalBox } from "std-widgets.slint";
import { HDivider } from "dividers.slint";
import { FontSettings } from "../theme.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> metadata_section: "";
    in property <string> action_title: "";
    in property <bool> action_enabled: true;
    callback action_clicked();
    callback section_right_clicked(string);

    height: 30px;
    background: #e7f0f5;

    section_touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.metadata_section != "") {
                root.section_right_clicked(root.metadata_section);
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4px;
        height: 100%;
        background: #3d7895;
    }

    Text {
        x: 18px;
        width: root.action_title == "" ? parent.width - 30px : parent.width - 124px;
        height: 100%;
        text: title;
        font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt);
        font-weight: 800;
        color: #203d4e;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.action_title != "": Rectangle {
        x: parent.width - 100px;
        y: 5px;
        width: 88px;
        height: 20px;
        background: !root.action_enabled ? #e9eff3 : action_area.has-hover ? #fff1f1 : #f7fbfd;
        border-width: 1px;
        border-color: !root.action_enabled ? #cfd8dc : action_area.has-hover ? #d6a0a0 : #b9c8d1;
        border-radius: 2px;

        Text {
            width: 100%;
            height: 100%;
            text: root.action_title;
            font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt);
            font-weight: 700;
            color: !root.action_enabled ? #9aa1a6 : action_area.has-hover ? #9a3412 : #203d4e;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        action_area := TouchArea {
            enabled: root.action_enabled;
            width: 100%;
            height: 100%;
            clicked => { root.action_clicked(); }
        }
    }
}

export component EditableInfoRow inherits Rectangle {
    in property <string> label;
    in property <string> metadata_key: "";
    in property <bool> dirty: false;
    in property <string> status: "";
    in-out property <string> value;
    callback value_edited();
    callback shortcut_requested(string);
    callback metadata_right_clicked(string, string);

    public function focus_input() {
        input.focus();
        input.select-all();
    }

    height: 36px;
    background: #ffffff;

    tag_touch := TouchArea {
        width: 154px;
        height: 100%;
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.metadata_key != "") {
                root.metadata_right_clicked(root.metadata_key, root.value);
            }
        }
    }

    Text {
        x: 14px;
        width: 126px;
        height: 100%;
        text: label;
        color: #455a64;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 154px;
        y: 4px;
        width: max(40px, parent.width - 168px);
        height: 28px;
        background: input.has-focus ? #eaf4ff : (root.dirty ? #fff7d6 : (root.status == "Mixed" ? #f6f7f8 : #00000000));
        border-width: input.has-focus || root.dirty || root.status == "Mixed" ? 1px : 0px;
        border-color: input.has-focus ? #2563eb : (root.dirty ? #e5c85d : (root.status == "Mixed" ? #d9dee2 : #edf0f2));
        border-radius: 3px;

        input := TextInput {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            text <=> root.value;
            font-size: FontSettings.font_size_pt * 1pt;
            vertical-alignment: center;
            single-line: true;
            color: #1f2933;

            edited => {
                root.value_edited();
            }

            key-pressed(event) => {
                if (event.text == Key.F5) {
                    root.shortcut_requested("refresh");
                    return accept;
                }

                if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) {
                    root.shortcut_requested("open-folder");
                    return accept;
                }

                if ((event.text == "S" || event.text == "s") && event.modifiers.control) {
                    root.shortcut_requested("save");
                    return accept;
                }

                if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) {
                    root.shortcut_requested("open-explorer");
                    return accept;
                }

                if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) {
                    root.shortcut_requested("revert");
                    return accept;
                }

                if ((event.text == "W" || event.text == "w") && event.modifiers.control) {
                    root.shortcut_requested("exit");
                    return accept;
                }

                reject
            }
        }

        if root.status == "Mixed" && root.value == "" && !input.has-focus: Text {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            text: "<Multiple values>";
            color: #7b858c;
            font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
            vertical-alignment: center;
            overflow: elide;
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}

component InlineButton inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    callback clicked();

    width: 96px;
    height: 24px;
    background: !enabled ? #f6f7f8 : area.has-hover ? #eef4f8 : #ffffff;
    border-width: 1px;
    border-color: !enabled ? #d9dee2 : area.has-hover ? #8aa8ba : #b8c2cc;
    border-radius: 3px;

    Text {
        width: 100%;
        height: 100%;
        text: root.title;
        color: root.enabled ? #34434c : #9aa1a6;
        font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    area := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component ReadOnlyInfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;

    height: 36px;
    background: #ffffff;

    Text {
        x: 14px;
        width: 126px;
        height: 100%;
        text: label;
        color: #455a64;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 154px;
        width: max(40px, parent.width - 168px);
        height: 100%;
        text: root.value;
        color: #1f2933;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}

export component ExifAvailabilityRow inherits Rectangle {
    in property <string> label;
    in property <bool> available;

    height: 36px;
    background: #ffffff;

    Text {
        x: 14px;
        width: 126px;
        height: 100%;
        text: root.label;
        color: #455a64;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 154px;
        y: 7px;
        width: 46px;
        height: 22px;
        background: root.available ? #e8f6ee : #fff1f1;
        border-width: 1px;
        border-color: root.available ? #b9dcc7 : #e2b4b4;
        border-radius: 3px;

        Text {
            width: 100%;
            height: 100%;
            text: root.available ? "YES" : "NO";
            color: root.available ? #1f6f43 : #8a3b3b;
            font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}

export component CreateExifRow inherits Rectangle {
    callback create_requested();

    height: 48px;
    background: #ffffff;

    InlineButton {
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: 180px;
        height: 28px;
        title: "Create EXIF Structure";
        clicked => { root.create_requested(); }
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}
