import { HorizontalBox } from "std-widgets.slint";
import { LineEdit } from "std-widgets.slint";
import { HDivider } from "dividers.slint";
import { FontSettings, MetadataContextMenuState, NativeColors } from "../theme.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <string> secondary_text: "";
    in property <string> metadata_section: "";
    in property <string> action_title: "";
    in property <bool> action_enabled: true;
    callback action_clicked();
    callback section_right_clicked(string);

    height: 30px;
    background: root.metadata_section != "" && section_touch.has-hover
        ? NativeColors.hover
        : NativeColors.subtle_surface;

    section_touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.section_right_clicked("");
            } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.metadata_section != "") {
                MetadataContextMenuState.x = section_touch.absolute-position.x + section_touch.mouse-x;
                MetadataContextMenuState.y = section_touch.absolute-position.y + section_touch.mouse-y;
                root.section_right_clicked(root.metadata_section);
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4px;
        height: 100%;
        background: NativeColors.accent;
    }

    Text {
        x: 18px;
        width: root.action_title != "" ? parent.width - 124px
            : root.secondary_text != "" ? max(48px, parent.width - 178px)
            : parent.width - 30px;
        height: 100%;
        text: title;
        font-family: FontSettings.details_font_family;
        font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt);
        font-weight: 600;
        color: NativeColors.text;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.secondary_text != "" && root.action_title == "": Text {
        x: max(82px, parent.width - 152px);
        width: min(140px, parent.width - 94px);
        height: 100%;
        text: root.secondary_text;
        font-family: FontSettings.details_font_family;
        font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
        color: NativeColors.secondary_text;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.action_title != "": Rectangle {
        x: parent.width - 100px;
        y: 5px;
        width: 88px;
        height: 20px;
        background: !root.action_enabled ? NativeColors.subtle_surface : action_area.has-hover ? NativeColors.danger_soft : NativeColors.surface;
        border-width: 1px;
        border-color: !root.action_enabled ? NativeColors.border : action_area.has-hover ? NativeColors.danger : NativeColors.border;
        border-radius: 2px;

        Text {
            width: 100%;
            height: 100%;
            text: root.action_title;
            font-family: FontSettings.details_font_family;
            font-size: max(9pt, (FontSettings.font_size_pt - 1) * 1pt);
            font-weight: 600;
            color: !root.action_enabled ? NativeColors.disabled_text : action_area.has-hover ? NativeColors.danger : NativeColors.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        action_area := TouchArea {
            enabled: root.action_enabled;
            width: 100%;
            height: 100%;
            clicked => { root.action_clicked(); }
        }
    }
}

export component ActionValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    background: NativeColors.surface;

    Text {
        x: 14px;
        width: 126px;
        height: 100%;
        text: root.label;
        font-family: FontSettings.details_font_family;
        color: NativeColors.secondary_text;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 154px;
        y: 3px;
        width: max(40px, parent.width - 168px);
        height: 24px;
        background: !root.enabled ? NativeColors.subtle_surface
            : value_area.has-hover ? NativeColors.hover
            : NativeColors.surface;
        border-width: 1px;
        border-color: value_area.has-hover && root.enabled ? NativeColors.accent : NativeColors.border;
        border-radius: 3px;

        Text {
            x: 8px;
            width: parent.width - 30px;
            height: 100%;
            text: root.value;
            font-family: FontSettings.details_font_family;
            font-size: FontSettings.font_size_pt * 1pt;
            color: root.value == "Not set" ? NativeColors.warning
                : root.enabled ? NativeColors.text
                : NativeColors.disabled_text;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - 22px;
            width: 14px;
            height: 100%;
            text: "v";
            font-family: FontSettings.details_font_family;
            font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
            color: root.enabled ? NativeColors.secondary_text : NativeColors.disabled_text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        value_area := TouchArea {
            enabled: root.enabled;
            width: 100%;
            height: 100%;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: NativeColors.divider;
    }
}

export component UtcOffsetInfoRow inherits Rectangle {
    in property <string> value: "Not set";
    in property <bool> multiple: false;
    in-out property <bool> only_missing: true;
    callback offset_selected(string, bool) -> bool;
    property <bool> custom_visible: false;
    property <string> custom_value: "+09:00";
    property <[string]> choices: [
        "PST · United States / Canada · UTC-08:00",
        "PDT · United States / Canada · UTC-07:00",
        "UTC · International · UTC+00:00",
        "CET · Germany / France / etc. · UTC+01:00",
        "CEST · Germany / France / etc. · UTC+02:00",
        "KST · South Korea · UTC+09:00",
        "Custom UTC offset..."
    ];

    height: 30px + (root.custom_visible ? 32px : 0px) + (root.multiple ? 26px : 0px);
    background: NativeColors.surface;

    Text {
        x: 14px; y: 0px; width: 126px; height: 30px;
        text: "UTC Offset";
        font-family: FontSettings.details_font_family;
        color: NativeColors.secondary_text;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    offset_combo := Rectangle {
        x: 154px; y: 3px; width: max(40px, parent.width - 168px); height: 24px;
        background: offset_area.has-hover ? NativeColors.hover : NativeColors.surface;
        border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
        Text {
            x: 8px; width: parent.width - 28px; height: 100%;
            text: root.value;
            font-family: FontSettings.details_font_family;
            font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
            color: root.value == "Not set" ? NativeColors.warning : NativeColors.text;
            vertical-alignment: center; overflow: elide;
        }
        Text {
            x: parent.width - 22px; width: 14px; height: 100%; text: "v";
            font-size: 8pt; color: NativeColors.secondary_text;
            horizontal-alignment: center; vertical-alignment: center;
        }
        offset_area := TouchArea { width: 100%; height: 100%; clicked => { offset_popup.show(); } }
    }

    offset_popup := PopupWindow {
        x: 154px; y: 29px; width: max(220px, root.width - 168px); height: root.choices.length * 27px + 2px;
        Rectangle {
            width: 100%; height: 100%;
            background: NativeColors.menu_bg; border-width: 1px; border-color: NativeColors.border;
            for choice[index] in root.choices: Rectangle {
                x: 1px; y: 1px + index * 27px; width: parent.width - 2px; height: 27px;
                background: choice_area.has-hover ? NativeColors.hover : NativeColors.menu_bg;
                Text {
                    x: 8px; width: parent.width - 16px; height: 100%; text: choice;
                    font-family: FontSettings.details_font_family;
                    font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
                    color: NativeColors.text; vertical-alignment: center; overflow: elide;
                }
                choice_area := TouchArea { width: 100%; height: 100%; clicked => {
                    offset_popup.close();
                    if (choice == "Custom UTC offset...") {
                        root.custom_visible = true;
                    } else {
                        root.custom_visible = false;
                        root.offset_selected(choice, root.only_missing);
                    }
                } }
            }
        }
    }

    if root.custom_visible: LineEdit {
        x: 154px; y: 33px; width: max(40px, parent.width - 238px); height: 26px;
        text <=> root.custom_value;
        placeholder-text: "+09:00";
    }
    if root.custom_visible: Rectangle {
        x: parent.width - 76px; y: 34px; width: 62px; height: 24px;
        background: custom_stage_area.has-hover ? NativeColors.hover : NativeColors.surface;
        border-width: 1px; border-color: NativeColors.border; border-radius: 3px;
        Text {
            width: 100%; height: 100%; text: "Stage";
            font-family: FontSettings.details_font_family;
            color: NativeColors.text;
            horizontal-alignment: center; vertical-alignment: center;
        }
        custom_stage_area := TouchArea { width: 100%; height: 100%; clicked => {
            if (root.offset_selected(root.custom_value, root.only_missing)) { root.custom_visible = false; }
        } }
        }

    if root.multiple: Rectangle {
        x: 154px; y: root.custom_visible ? 66px : 34px; width: 16px; height: 16px;
        background: NativeColors.surface;
        border-width: 1px;
        border-color: NativeColors.border;
        border-radius: 2px;
        Text { width: 100%; height: 100%; text: root.only_missing ? "✓" : ""; color: NativeColors.accent; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { width: 100%; height: 100%; clicked => { root.only_missing = !root.only_missing; } }
    }
    if root.multiple: Text {
        x: 178px; y: root.custom_visible ? 62px : 30px;
        width: max(40px, parent.width - 192px); height: 24px;
        text: "Only set missing offsets";
        font-family: FontSettings.details_font_family;
        color: NativeColors.secondary_text;
        font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
        vertical-alignment: center;
        overflow: elide;
    }

    HDivider { y: parent.height - 1px; background: NativeColors.divider; }
}

export component EditableInfoRow inherits Rectangle {
    in property <string> label;
    in property <string> metadata_key: "";
    in property <bool> dirty: false;
    in property <string> status: "";
    in property <bool> date_input: false;
    in property <string> suffix: "";
    in property <bool> suffix_double_click_enabled: false;
    property <bool> date_spinner_visible: root.date_input && root.status != "Mixed" && root.value != "";
    // Keep the last segment chosen inside the text field. Clicking a spinner
    // button moves focus away from TextInput, so reading its live cursor from
    // the button callback would otherwise fall back to the year segment.
    property <int> date_adjust_cursor: 18;
    in-out property <string> value;
    callback value_edited();
    callback date_value_edited() -> int;
    callback date_value_adjusted(string, int, int) -> string;
    callback shortcut_requested(string);
    callback metadata_right_clicked(string, string);
    callback suffix_double_clicked();

    public function focus_input() {
        input.focus();
        input.select-all();
    }

    function adjust_date_value(delta: int) {
        if (!root.date_input || root.value == "") {
            return;
        }
        let cursor = root.date_adjust_cursor;
        let adjusted = root.date_value_adjusted(root.value, cursor, delta);
        if (adjusted == root.value) {
            return;
        }
        root.value = adjusted;
        root.date_value_edited();
        root.value_edited();
        input.focus();
        if (cursor <= 4) {
            input.set-selection-offsets(0, 4);
        } else if (cursor <= 7) {
            input.set-selection-offsets(5, 7);
        } else if (cursor <= 10) {
            input.set-selection-offsets(8, 10);
        } else if (cursor <= 13) {
            input.set-selection-offsets(11, 13);
        } else if (cursor <= 16) {
            input.set-selection-offsets(14, 16);
        } else {
            input.set-selection-offsets(17, 19);
        }
    }

    height: 30px;
    background: root.metadata_key != "" && tag_touch.has-hover
        ? NativeColors.row_hover
        : NativeColors.surface;

    tag_touch := TouchArea {
        width: 154px;
        height: 100%;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.metadata_right_clicked("", "");
            } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.metadata_key != "") {
                MetadataContextMenuState.x = tag_touch.absolute-position.x + tag_touch.mouse-x;
                MetadataContextMenuState.y = tag_touch.absolute-position.y + tag_touch.mouse-y;
                root.metadata_right_clicked(root.metadata_key, root.value);
            }
        }
    }

    Text {
        x: 14px;
        width: 126px;
        height: 100%;
        text: label;
        font-family: FontSettings.details_font_family;
        color: NativeColors.secondary_text;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 154px;
        y: 3px;
        width: max(40px, parent.width - 168px);
        height: 24px;
        background: input.has-focus ? NativeColors.selection : (root.dirty ? NativeColors.pending : (root.status == "Mixed" ? NativeColors.subtle_surface : (root.date_spinner_visible ? NativeColors.surface : #00000000)));
        border-width: input.has-focus || root.dirty || root.status == "Mixed" || root.date_spinner_visible ? 1px : 0px;
        border-color: input.has-focus ? NativeColors.accent : (root.dirty ? #d6b656 : (root.status == "Mixed" ? NativeColors.border : NativeColors.divider));
        border-radius: 3px;

        input := TextInput {
            x: 8px;
            width: parent.width - 16px - (root.date_spinner_visible ? 18px : 0px) - (root.suffix != "" ? 72px : 0px);
            height: 100%;
            text <=> root.value;
            font-family: FontSettings.details_font_family;
            font-size: FontSettings.font_size_pt * 1pt;
            vertical-alignment: center;
            single-line: true;
            color: NativeColors.text;

            changed cursor-position-byte-offset => {
                if (self.has-focus) {
                    root.date_adjust_cursor = self.cursor-position-byte-offset;
                }
            }

            edited => {
                if (root.date_input) {
                    let formatted-position = root.date_value_edited();
                    if (formatted-position >= 0) {
                        input.set-selection-offsets(formatted-position, formatted-position);
                    }
                }
                root.value_edited();
            }

            key-pressed(event) => {
                if (root.date_input && event.text == Key.UpArrow) {
                    root.adjust_date_value(1);
                    return accept;
                }
                if (root.date_input && event.text == Key.DownArrow) {
                    root.adjust_date_value(-1);
                    return accept;
                }
                if (event.text == Key.F5) {
                    root.shortcut_requested("refresh");
                    return accept;
                }

                if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) {
                    root.shortcut_requested("open-folder");
                    return accept;
                }

                if ((event.text == "S" || event.text == "s") && event.modifiers.control) {
                    root.shortcut_requested("save");
                    return accept;
                }

                if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) {
                    root.shortcut_requested("open-explorer");
                    return accept;
                }

                if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) {
                    root.shortcut_requested("revert");
                    return accept;
                }

                if ((event.text == "W" || event.text == "w") && event.modifiers.control) {
                    root.shortcut_requested("exit");
                    return accept;
                }

                reject
            }
        }

        if root.suffix != "": Text {
            x: parent.width - (root.date_spinner_visible ? 90px : 72px);
            width: 66px;
            height: 100%;
            text: root.suffix;
            font-family: FontSettings.details_font_family;
            font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
            color: root.suffix == "Local?" ? NativeColors.warning : NativeColors.secondary_text;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.suffix != "": TouchArea {
            x: parent.width - (root.date_spinner_visible ? 90px : 72px);
            width: 66px;
            height: 100%;
            mouse-cursor: root.suffix == "Local?" && root.suffix_double_click_enabled ? pointer : default;
            double-clicked => {
                if (root.suffix == "Local?" && root.suffix_double_click_enabled) {
                    root.suffix_double_clicked();
                }
            }
        }

        if root.date_spinner_visible: Rectangle {
            x: parent.width - 18px;
            y: 1px;
            width: 18px;
            height: 11px;
            background: up_area.pressed ? NativeColors.pressed : (up_area.has-hover ? NativeColors.hover : NativeColors.subtle_surface);

            Text {
                width: 100%;
                height: 100%;
                text: "▲";
                font-family: "Segoe UI Symbol";
                color: NativeColors.secondary_text;
                font-size: 5pt;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            up_area := TouchArea { width: 100%; height: 100%; clicked => { root.adjust_date_value(1); } }
        }

        if root.date_spinner_visible: Rectangle {
            x: parent.width - 18px;
            y: 13px;
            width: 18px;
            height: 10px;
            background: down_area.pressed ? NativeColors.pressed : (down_area.has-hover ? NativeColors.hover : NativeColors.subtle_surface);

            Text {
                width: 100%;
                height: 100%;
                text: "▼";
                font-family: "Segoe UI Symbol";
                color: NativeColors.secondary_text;
                font-size: 5pt;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            down_area := TouchArea { width: 100%; height: 100%; clicked => { root.adjust_date_value(-1); } }
        }

        if root.date_spinner_visible: Rectangle {
            x: parent.width - 19px;
            y: 0px;
            width: 1px;
            height: 100%;
            background: NativeColors.border;
        }

        if root.date_spinner_visible: Rectangle {
            x: parent.width - 18px;
            y: 12px;
            width: 18px;
            height: 1px;
            background: NativeColors.border;
        }

        if root.status == "Mixed" && root.value == "" && !input.has-focus: Text {
            x: 8px;
            width: parent.width - 16px;
            height: 100%;
            text: "<Multiple values>";
            font-family: FontSettings.details_font_family;
            color: NativeColors.disabled_text;
            font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
            vertical-alignment: center;
            overflow: elide;
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: NativeColors.divider;
    }
}

component InlineButton inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    callback clicked();

    width: 96px;
    height: 24px;
    background: !enabled ? NativeColors.subtle_surface : area.has-hover ? NativeColors.hover : NativeColors.surface;
    border-width: 1px;
    border-color: !enabled ? NativeColors.border : area.has-hover ? #8a8a8a : NativeColors.border;
    border-radius: 3px;

    Text {
        width: 100%;
        height: 100%;
        text: root.title;
        font-family: FontSettings.details_font_family;
        color: root.enabled ? NativeColors.text : NativeColors.disabled_text;
        font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    area := TouchArea {
        enabled: root.enabled;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component ReadOnlyInfoRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> metadata_key: "";
    callback metadata_right_clicked(string, string);

    height: 30px;
    background: root.metadata_key != "" && tag_touch.has-hover
        ? NativeColors.row_hover
        : NativeColors.surface;

    tag_touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.metadata_right_clicked("", "");
            } else if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.metadata_key != "") {
                MetadataContextMenuState.x = tag_touch.absolute-position.x + tag_touch.mouse-x;
                MetadataContextMenuState.y = tag_touch.absolute-position.y + tag_touch.mouse-y;
                root.metadata_right_clicked(root.metadata_key, root.value);
            }
        }
    }

    Text {
        x: 14px;
        width: 126px;
        height: 100%;
        text: label;
        font-family: FontSettings.details_font_family;
        color: NativeColors.secondary_text;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 162px;
        width: max(40px, parent.width - 176px);
        height: 100%;
        text: root.value;
        font-family: FontSettings.details_font_family;
        color: NativeColors.text;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    HDivider {
        y: parent.height - 1px;
        background: NativeColors.divider;
    }
}

export component ExifAvailabilityRow inherits Rectangle {
    in property <string> label;
    in property <bool> available;

    height: 30px;
    background: NativeColors.surface;

    Text {
        x: 14px;
        width: 126px;
        height: 100%;
        text: root.label;
        font-family: FontSettings.details_font_family;
        color: NativeColors.secondary_text;
        font-size: FontSettings.font_size_pt * 1pt;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        x: 154px;
        y: 4px;
        width: 46px;
        height: 22px;
        background: root.available ? #e7f5ec : NativeColors.danger_soft;
        border-width: 1px;
        border-color: root.available ? #9fd0b1 : #e5a4aa;
        border-radius: 3px;

        Text {
            width: 100%;
            height: 100%;
            text: root.available ? "YES" : "NO";
            font-family: FontSettings.details_font_family;
            color: root.available ? #107c10 : NativeColors.danger;
            font-size: max(8pt, (FontSettings.font_size_pt - 1) * 1pt);
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: NativeColors.divider;
    }
}

export component CreateExifRow inherits Rectangle {
    callback create_requested();

    height: 48px;
    background: NativeColors.surface;

    InlineButton {
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: 180px;
        height: 28px;
        title: "Create EXIF Structure";
        clicked => { root.create_requested(); }
    }

    HDivider {
        y: parent.height - 1px;
        background: NativeColors.divider;
    }
}
