import { CheckBox, HorizontalBox } from "std-widgets.slint";
import { HDivider } from "dividers.slint";

export component SectionHeader inherits Rectangle {
    in property <string> title;

    height: 28px;
    background: #fcfcfc;

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;

        Text {
            text: title;
            font-size: 11px;
            font-weight: 800;
            color: #607d8b;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            background: #e8edf0;
        }
    }
}

export component EditableInfoRow inherits Rectangle {
    in property <string> label;
    in-out property <string> value;
    callback value_edited();

    height: 34px;
    background: #ffffff;

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        Text {
            text: label;
            width: 126px;
            color: #455a64;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: #ffffff;
            border-width: 1px;
            border-color: #edf0f2;
            border-radius: 3px;

            TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: 100%;
                text <=> root.value;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
                color: #1f2933;

                edited => {
                    root.value_edited();
                }
            }
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}

export component ReadOnlyCheckRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked;

    height: 34px;
    background: #ffffff;

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        Text {
            text: label;
            width: 126px;
            color: #455a64;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalBox {
            horizontal-stretch: 1;
            spacing: 8px;

            CheckBox {
                checked: root.checked;
                enabled: false;
            }
        }
    }

    HDivider {
        y: parent.height - 1px;
        background: #f3f5f6;
    }
}
