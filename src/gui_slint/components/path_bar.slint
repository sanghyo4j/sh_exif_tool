import { HorizontalBox, LineEdit } from "std-widgets.slint";
import { HDivider } from "dividers.slint";
import { FolderIcon, RefreshIcon, UpIcon } from "icons.slint";
import { FontSettings } from "../theme.slint";

component IconButton inherits Rectangle {
    in property <bool> folder_icon: false;
    in property <bool> up_icon: false;
    out property <bool> hovered: area.has-hover;
    callback clicked();

    width: 32px;
    height: 28px;
    background: area.has-hover ? #eaf4ff : #ffffff;
    border-width: 1px;
    border-color: area.has-hover ? #7aa7d9 : #cfd8dc;
    border-radius: 4px;

    if up_icon: UpIcon { x: 5px; y: 3px; }
    if folder_icon && !up_icon: FolderIcon { x: 5px; y: 3px; }
    if !folder_icon && !up_icon: RefreshIcon { x: 5px; y: 3px; }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component PathBar inherits Rectangle {
    in property <string> current_path;
    in-out property <bool> editing;

    callback change_dir(string);
    callback go_parent();
    callback open_folder();
    callback reload();

    height: 40px;
    background: #f8fafc;

    property <string> hover_text: up_button.hovered ? "Up One Level" : (open_button.hovered ? "Open Folder (Ctrl+Shift+O)" : (refresh_button.hovered ? "Refresh (F5)" : ""));

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: "Path";
            vertical-alignment: center;
            color: #5f6b75;
            font-weight: 600;
            font-size: FontSettings.font_size_pt * 1pt;
            width: 42px;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-width: 1px;
            border-color: root.editing ? #7aa7d9 : #d7dde2;
            border-radius: 4px;

            if !editing : TouchArea {
                width: 100%;
                height: 100%;

                clicked => {
                    root.editing = true;
                }

                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: 100%;
                    text: root.current_path;
                    font-size: FontSettings.font_size_pt * 1pt;
                    color: #263238;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if editing : LineEdit {
                x: 4px;
                y: 2px;
                width: parent.width - 8px;
                height: parent.height - 4px;
                text: root.current_path;
                font-size: FontSettings.font_size_pt * 1pt;

                init => {
                    self.focus();
                    self.select-all();
                }

                changed has-focus => {
                    if (!self.has-focus) {
                        root.editing = false;
                    }
                }

                accepted(new_path) => {
                    root.editing = false;
                    root.change_dir(new_path);
                }
            }
        }

        up_button := IconButton {
            up_icon: true;
            clicked => {
                root.go_parent();
            }
        }

        open_button := IconButton {
            folder_icon: true;
            clicked => {
                root.open_folder();
            }
        }

        refresh_button := IconButton {
            folder_icon: false;
            clicked => {
                root.reload();
            }
        }
    }

    if hover_text != "": Rectangle {
        x: parent.width - 286px;
        y: 8px;
        width: 164px;
        height: 24px;
        background: #263238;
        border-radius: 3px;

        Text {
            width: 100%;
            height: 100%;
            text: root.hover_text;
            color: #ffffff;
            font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    HDivider { y: parent.height - self.height; }
}
