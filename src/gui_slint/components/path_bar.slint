import { HorizontalBox, LineEdit } from "std-widgets.slint";
import { HDivider } from "dividers.slint";

export component PathBar inherits Rectangle {
    in-out property <string> current_path;
    in-out property <bool> editing;

    callback change_dir(string);

    height: 40px;
    background: #f8fafc;

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: "경로";
            vertical-alignment: center;
            color: #5f6b75;
            font-weight: 700;
            font-size: 12px;
            width: 42px;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            y: (parent.height - self.height) / 2;
            background: #ffffff;
            border-width: 1px;
            border-color: root.editing ? #7aa7d9 : #d7dde2;
            border-radius: 4px;

            if !editing : TouchArea {
                width: 100%;
                height: 100%;

                clicked => {
                    root.editing = true;
                }

                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: 100%;
                    text: root.current_path;
                    font-size: 13px;
                    color: #263238;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if editing : LineEdit {
                x: 4px;
                y: 2px;
                width: parent.width - 8px;
                height: parent.height - 4px;
                text: root.current_path;
                font-size: 13px;

                init => {
                    self.focus();
                }

                changed has-focus => {
                    if (!self.has-focus) {
                        root.editing = false;
                    }
                }

                accepted(new_path) => {
                    root.current_path = new_path;
                    root.editing = false;
                    root.change_dir(new_path);
                }
            }
        }
    }

    HDivider { y: parent.height - self.height; }
}
