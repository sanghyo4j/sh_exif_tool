import { HorizontalBox } from "std-widgets.slint";
import { HDivider } from "dividers.slint";
import { UpIcon } from "icons.slint";
import { FontSettings, NativeColors } from "../theme.slint";

component IconButton inherits Rectangle {
    out property <bool> hovered: area.has-hover;
    callback clicked();

    width: 32px;
    height: 28px;
    background: area.has-hover ? NativeColors.hover : NativeColors.surface;
    border-width: 1px;
    border-color: area.has-hover ? #8a8a8a : NativeColors.border;
    border-radius: 4px;

    UpIcon { x: 5px; y: 3px; }

    area := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component PathBar inherits Rectangle {
    in property <string> current_path;
    in-out property <bool> editing;
    private property <string> edit_text: "";

    callback change_dir(string);
    callback go_parent();

    height: 40px;
    background: NativeColors.subtle_surface;

    property <string> hover_text: up_button.hovered ? "Up One Level" : "";

    changed editing => {
        if (root.editing) {
            root.edit_text = root.current_path;
        }
    }

    HorizontalBox {
        width: 100%;
        height: 100%;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: "Path";
            vertical-alignment: center;
            color: NativeColors.secondary_text;
            font-weight: 600;
            font-size: FontSettings.font_size_pt * 1pt;
            width: 42px;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 28px;
            y: (parent.height - self.height) / 2;
            background: NativeColors.surface;
            border-width: 1px;
            border-color: root.editing ? NativeColors.accent : NativeColors.border;
            border-radius: 4px;

            if !editing : TouchArea {
                width: 100%;
                height: 100%;

                clicked => {
                    root.edit_text = root.current_path;
                    root.editing = true;
                }

                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: 100%;
                    text: root.current_path;
                    font-size: FontSettings.font_size_pt * 1pt;
                    color: NativeColors.text;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            if editing : TextInput {
                x: 4px;
                y: 2px;
                width: parent.width - 8px;
                height: parent.height - 4px;
                text <=> root.edit_text;
                single-line: true;
                font-size: FontSettings.font_size_pt * 1pt;
                color: NativeColors.text;
                vertical-alignment: center;

                init => {
                    self.focus();
                    self.select-all();
                }

                changed has-focus => {
                    if (!self.has-focus) {
                        root.editing = false;
                    }
                }

                accepted => {
                    root.editing = false;
                    root.change_dir(root.edit_text);
                }

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.editing = false;
                        return accept;
                    }
                    reject
                }
            }
        }

        up_button := IconButton {
            clicked => {
                root.go_parent();
            }
        }
    }

    if hover_text != "": Rectangle {
        x: parent.width - 204px;
        y: 8px;
        width: 164px;
        height: 24px;
        background: #202020;
        border-radius: 3px;

        Text {
            width: 100%;
            height: 100%;
            text: root.hover_text;
            color: NativeColors.surface;
            font-size: max(8pt, (FontSettings.font_size_pt - 2) * 1pt);
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    HDivider { y: parent.height - self.height; }
}
