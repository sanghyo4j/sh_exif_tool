import { ListView } from "std-widgets.slint";
import { FileEntry } from "../types.slint";
import { HDivider } from "dividers.slint";

export component CustomFileTable inherits Rectangle {
    in property <[FileEntry]> files;
    in-out property <int> selected_index;

    callback row_selected(int);
    callback row_clicked(int);
    callback row_activated(int);
    callback rename_requested(int);
    callback reload_requested();
    callback open_folder_requested();
    callback open_in_file_manager_requested();
    callback apply_requested();
    callback revert_requested();
    callback exit_requested();

    horizontal-stretch: 0;
    height: 100%;
    background: #ffffff;
    forward-focus: focus_scope;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        header := Rectangle {
            height: 28px;
            background: #f7f9fb;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 0px;

                Text {
                    width: parent.width - size_header.width - modified_header.width - 20px;
                    text: "Name";
                    color: #37474f;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }

                size_header := Text {
                    width: 92px;
                    text: "Size";
                    color: #37474f;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }

                modified_header := Text {
                    width: 156px;
                    text: "Modified";
                    color: #37474f;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }

            HDivider { y: parent.height - 1px; }
        }

        list := ListView {
            vertical-stretch: 1;
            width: 100%;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.as-needed;

            for entry[i] in files : Rectangle {
                height: 28px;
                background: i == root.selected_index ? #dbeafe : #ffffff;

                TouchArea {
                    width: 100%;
                    height: 100%;

                    clicked => {
                        root.focus();
                        root.selected_index = i;
                        root.row_selected(i);
                        root.row_clicked(i);
                    }
                }

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 0px;

                    Text {
                        width: parent.width - size_cell.width - modified_cell.width - 20px;
                        text: entry.is_dir && entry.name != "[..]" ? "[" + entry.name + "]" : entry.name;
                        color: i == root.selected_index ? #0f172a : #1f2933;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    size_cell := Text {
                        width: 92px;
                        text: entry.size;
                        color: #4b5563;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }

                    modified_cell := Text {
                        width: 156px;
                        text: entry.modified;
                        color: #4b5563;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                HDivider { y: parent.height - 1px; background: #eef2f5; }
            }
        }
    }

    focus_scope := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                if (root.selected_index > 0) {
                    root.selected_index -= 1;
                    root.row_selected(root.selected_index);
                }
                return accept;
            }

            if (event.text == Key.DownArrow) {
                if (root.selected_index < root.files.length - 1) {
                    root.selected_index += 1;
                    root.row_selected(root.selected_index);
                }
                return accept;
            }

            if (event.text == Key.Return) {
                if (root.selected_index >= 0 && root.selected_index < root.files.length) {
                    root.row_activated(root.selected_index);
                }
                return accept;
            }

            if (event.text == Key.F2) {
                if (root.selected_index > 0 && root.selected_index < root.files.length) {
                    root.rename_requested(root.selected_index);
                }
                return accept;
            }

            if (event.text == Key.F5) {
                root.reload_requested();
                return accept;
            }

            if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) {
                root.open_folder_requested();
                return accept;
            }

            if ((event.text == "S" || event.text == "s") && event.modifiers.control) {
                root.apply_requested();
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) {
                root.open_in_file_manager_requested();
                return accept;
            }

            if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) {
                root.revert_requested();
                return accept;
            }

            if ((event.text == "W" || event.text == "w") && event.modifiers.control) {
                root.exit_requested();
                return accept;
            }

            reject
        }
    }
}
