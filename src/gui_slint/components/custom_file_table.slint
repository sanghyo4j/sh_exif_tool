import { ListView } from "std-widgets.slint";
import { FileEntry } from "../types.slint";
import { HDivider } from "dividers.slint";
import { FileIcon, FolderIcon, ImageFileIcon, VideoFileIcon } from "icons.slint";
import { FontSettings, NativeColors } from "../theme.slint";

component IconCell inherits Rectangle {
    in property <bool> is_dir;
    in property <string> media_kind;

    width: 22px;
    height: 100%;

    if is_dir: FolderIcon { y: 4px; }
    if !is_dir && (media_kind == "jpeg" || media_kind == "png"): ImageFileIcon { y: 4px; }
    if !is_dir && (media_kind == "mp4" || media_kind == "mts"): VideoFileIcon { y: 4px; }
    if !is_dir && media_kind != "jpeg" && media_kind != "png" && media_kind != "mp4" && media_kind != "mts": FileIcon { y: 4px; }
}

component MenuRow inherits Rectangle {
    in property <string> title;
    in property <bool> danger;
    in property <bool> enabled;
    callback clicked();

    x: 1px;
    width: 190px;
    height: 28px;
    background: touch.has-hover && enabled ? NativeColors.hover : NativeColors.menu_bg;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text: root.title;
        font-size: FontSettings.font_size_pt * 1pt;
        color: !root.enabled ? NativeColors.disabled_text : NativeColors.text;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

component SortHeader inherits Rectangle {
    in property <string> title;
    in property <int> column;
    in property <int> active_column;
    in property <int> sort_direction;
    in property <bool> centered: false;
    callback clicked(int);

    background: touch.has-hover ? NativeColors.hover : transparent;

    Text {
        width: 100%;
        height: 100%;
        text: root.title
            + (root.active_column == root.column && root.sort_direction == 1 ? " ▲"
            : root.active_column == root.column && root.sort_direction == 2 ? " ▼" : "");
        color: NativeColors.text;
        font-size: FontSettings.font_size_pt * 1pt;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: root.centered ? center : left;
        overflow: elide;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(root.column); }
    }
}

export component CustomFileTable inherits Rectangle {
    in property <[FileEntry]> files;
    in-out property <int> selected_index;
    in property <int> selected_file_count: 0;
    in property <int> selected_recyclable_count: 0;
    in property <int> copied_file_count: 0;
    in property <bool> mark_file_date_mismatches: false;
    in property <int> sort_column: 0;
    in property <int> sort_direction: 0;
    in-out property <bool> context_menu_visible: false;
    in-out property <int> rename_edit_index: -1;
    in-out property <string> rename_text: "";
    in property <bool> rename_pending: false;

    callback row_selected(int, bool, bool) -> bool;
    callback row_clicked(int);
    callback row_activated(int);
    callback select_all_requested();
    callback rename_requested(int);
    callback rename_value_edited();
    callback rename_finished();
    callback rename_cancelled();
    callback reload_requested();
    callback copy_requested();
    callback paste_requested();
    callback delete_requested();
    callback open_folder_requested();
    callback open_in_file_manager_requested(int);
    callback apply_requested();
    callback revert_requested();
    callback exit_requested();
    callback sort_requested(int);
    callback type_ahead_requested(string) -> int;
    callback visible_range_changed(int, int);

    property <length> menu_x: 0px;
    property <length> menu_y: 0px;
    property <length> menu_width: 192px;
    property <bool> context_target_is_dir: root.selected_index >= 0 && root.selected_index < root.files.length && root.files[root.selected_index].is_dir;
    property <length> menu_height: 198px;
    property <int> first_visible_index: max(0, floor(-list.viewport-y / 30px));
    property <int> last_visible_index: min(root.files.length - 1, ceil((-list.viewport-y + list.visible-height) / 30px));

    background: NativeColors.surface;
    forward-focus: focus_scope;

    public function reveal_selected_row() {
        if (root.selected_index < 0 || root.selected_index >= root.files.length) {
            return;
        }
        if (list.viewport-y + root.selected_index * 30px < 0px) {
            list.viewport-y += -(list.viewport-y + root.selected_index * 30px);
        }
        if (list.viewport-y + (root.selected_index + 1) * 30px > list.visible-height) {
            list.viewport-y -= list.viewport-y
                + (root.selected_index + 1) * 30px
                - list.visible-height
                + 2px;
        }
    }

    public function report_visible_range() {
        visible_range_timer.restart();
    }

    selection_scroll_timer := Timer {
        interval: 16ms;
        running: false;

        triggered => {
            self.running = false;
            root.reveal_selected_row();
        }
    }

    visible_range_timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.visible_range_changed(root.first_visible_index, root.last_visible_index);
        }
    }

    changed first_visible_index => { visible_range_timer.restart(); }
    changed last_visible_index => { visible_range_timer.restart(); }

    background_close_area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (root.context_menu_visible && event.kind == PointerEventKind.down) {
                root.context_menu_visible = false;
            }
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        Rectangle {
            height: 30px;
            background: NativeColors.subtle_surface;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 0px;

                Rectangle { width: 22px; }
                SortHeader { width: parent.width - 22px - media_date_header.width - size_header.width - modified_header.width - metadata_header.width - 20px; title: "Filename"; column: 1; active_column: root.sort_column; sort_direction: root.sort_direction; clicked(column) => { root.sort_requested(column); } }
                size_header := SortHeader { width: 78px; title: "Size"; column: 2; active_column: root.sort_column; sort_direction: root.sort_direction; clicked(column) => { root.sort_requested(column); } }
                modified_header := SortHeader { width: 146px; title: "Modified"; column: 3; active_column: root.sort_column; sort_direction: root.sort_direction; clicked(column) => { root.sort_requested(column); } }
                media_date_header := SortHeader { width: 150px; title: "Media Date"; column: 4; active_column: root.sort_column; sort_direction: root.sort_direction; clicked(column) => { root.sort_requested(column); } }
                metadata_header := SortHeader { width: 68px; title: "Metadata"; column: 5; active_column: root.sort_column; sort_direction: root.sort_direction; centered: true; clicked(column) => { root.sort_requested(column); } }
            }

            HDivider { y: parent.height - 1px; }
        }

        list := ListView {
            width: 100%;
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            for entry[i] in files: Rectangle {
                height: 30px;
                background: entry.selected
                    ? (row_touch.has-hover ? NativeColors.selection_hover : NativeColors.selection)
                    : (row_touch.has-hover ? NativeColors.row_hover : NativeColors.surface);

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 0px;

                    IconCell { is_dir: entry.is_dir; media_kind: entry.media_kind; }
                    filename_cell := Rectangle {
                        width: parent.width - 22px - media_date_cell.width - size_cell.width - modified_cell.width - metadata_cell.width - 20px;

                        if root.rename_edit_index != i: Text {
                            width: 100%;
                            height: 100%;
                            text: entry.selected && root.rename_pending
                                ? root.rename_text
                                : (entry.is_dir && entry.name != "[..]" ? "[" + entry.name + "]" : entry.name);
                            color: entry.duplicate_name ? NativeColors.duplicate : NativeColors.text;
                            font-weight: entry.duplicate_name ? 600 : 400;
                            font-size: FontSettings.font_size_pt * 1pt;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if root.rename_edit_index == i: Rectangle {
                            y: 2px;
                            width: 100%;
                            height: 26px;
                            background: NativeColors.surface;
                            border-width: 1px;
                            border-color: NativeColors.accent;
                            border-radius: 2px;

                            rename_input := TextInput {
                                x: 4px;
                                width: parent.width - 8px;
                                height: 100%;
                                text <=> root.rename_text;
                                single-line: true;
                                font-family: FontSettings.font_family;
                                font-size: FontSettings.font_size_pt * 1pt;
                                color: NativeColors.text;
                                vertical-alignment: center;

                                init => {
                                    self.focus();
                                    self.select-all();
                                }
                                edited => { root.rename_value_edited(); }
                                accepted => { root.rename_finished(); }
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        root.rename_cancelled();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                        }
                    }
                    size_cell := Text { width: 78px; text: entry.size; color: entry.duplicate_size ? NativeColors.duplicate : NativeColors.secondary_text; font-weight: entry.duplicate_size ? 600 : 400; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; overflow: elide; }
                    modified_cell := Rectangle {
                        width: 146px;
                        property <bool> has_date_mismatch: root.mark_file_date_mismatches && !entry.is_dir && entry.created != "-" && entry.modified != "-" && entry.created != entry.modified;

                        Text {
                            width: modified_cell.has_date_mismatch ? parent.width - 28px : parent.width;
                            height: 100%;
                            text: entry.modified;
                            color: entry.duplicate_modified ? NativeColors.duplicate : NativeColors.secondary_text;
                            font-weight: entry.duplicate_modified ? 600 : 400;
                            font-size: FontSettings.font_size_pt * 1pt;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if modified_cell.has_date_mismatch: Text {
                            x: parent.width - 27px;
                            width: 27px;
                            height: 100%;
                            text: "(!)";
                            color: NativeColors.warning;
                            font-size: FontSettings.font_size_pt * 1pt;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    media_date_cell := Text { width: 150px; text: entry.media_date; color: entry.duplicate_media_date ? NativeColors.duplicate : NativeColors.secondary_text; font-weight: entry.duplicate_media_date ? 600 : 400; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; overflow: elide; }
                    metadata_cell := Text { width: 68px; text: entry.metadata_status; color: entry.metadata_status == "!" ? NativeColors.danger : NativeColors.secondary_text; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                }

                row_touch := TouchArea {
                    enabled: root.rename_edit_index != i;
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.context_menu_visible = false;
                            root.focus();
                            if (root.row_selected(i, event.modifiers.control, event.modifiers.shift)) {
                                root.selected_index = i;
                                root.row_clicked(i);
                            }
                        }

                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                            root.focus();
                            if (entry.selected || root.row_selected(i, false, false)) {
                                root.selected_index = i;
                                root.menu_x = min(root.width - root.menu_width - 1px, max(1px, self.absolute-position.x - root.absolute-position.x + self.mouse-x + 1px));
                                root.menu_y = min(root.height - root.menu_height - 1px, max(1px, self.absolute-position.y - root.absolute-position.y + self.mouse-y + 1px));
                                root.context_menu_visible = true;
                            }
                        }
                    }
                }

                HDivider { y: parent.height - 1px; background: NativeColors.divider; }
            }
        }
    }

    if list.viewport-height > list.visible-height: Rectangle {
        x: parent.width - 12px;
        y: 30px;
        width: 12px;
        height: parent.height - 30px;
        background: #eef2f5;

        scroll_area := TouchArea {
            width: 100%;
            height: 100%;

            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    list.viewport-y = -max(
                        0px,
                        min(
                            list.viewport-height - list.visible-height,
                            self.mouse-y * list.viewport-height / parent.height - list.visible-height / 2
                        )
                    );
                }
            }

            moved => {
                if (self.pressed) {
                    list.viewport-y = -max(
                        0px,
                        min(
                            list.viewport-height - list.visible-height,
                            self.mouse-y * list.viewport-height / parent.height - list.visible-height / 2
                        )
                    );
                }
            }
        }

        Rectangle {
            x: 2px;
            y: 4px + (-list.viewport-y)
                * (parent.height - 8px - self.height)
                / (list.viewport-height - list.visible-height);
            width: 8px;
            height: max(28px, (parent.height - 8px) * list.visible-height / list.viewport-height);
            border-radius: 4px;
            background: scroll_area.has-hover ? #7f8f9a : #9aa8b2;
        }
    }

    if context_menu_visible: Rectangle {
        x: root.menu_x;
        y: root.menu_y;
        width: root.menu_width;
        height: root.menu_height;
        background: NativeColors.menu_bg;
        border-width: 1px;
        border-color: #a0a0a0;
        border-radius: 0px;

        MenuRow { y: 1px; title: "Open (O)"; danger: false; enabled: root.selected_recyclable_count == 1; clicked => { root.context_menu_visible = false; if (root.selected_recyclable_count == 1) { root.row_activated(root.selected_index); } } }
        MenuRow { y: 29px; title: "Open in Explorer (X)"; danger: false; enabled: true; clicked => { root.context_menu_visible = false; root.open_in_file_manager_requested(root.selected_index); } }
        MenuRow { y: 57px; title: "Refresh (E)"; danger: false; enabled: true; clicked => { root.context_menu_visible = false; root.reload_requested(); } }
        MenuRow { y: 85px; title: "Rename (M)"; danger: false; enabled: root.selected_recyclable_count == 1; clicked => { root.context_menu_visible = false; if (root.selected_recyclable_count == 1) { root.rename_requested(root.selected_index); } } }
        MenuRow { y: 113px; title: "Copy (C)"; danger: false; enabled: root.selected_recyclable_count > 0; clicked => { root.context_menu_visible = false; if (root.selected_recyclable_count > 0) { root.copy_requested(); } } }
        MenuRow { y: 141px; title: "Paste (P)"; danger: false; enabled: root.copied_file_count > 0; clicked => { root.context_menu_visible = false; if (root.copied_file_count > 0) { root.paste_requested(); } } }
        MenuRow { y: 169px; title: "Delete (D)"; danger: false; enabled: root.selected_recyclable_count > 0; clicked => { root.context_menu_visible = false; if (root.selected_recyclable_count > 0) { root.delete_requested(); } } }
    }

    focus_scope := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == Key.Escape && root.context_menu_visible) {
                root.context_menu_visible = false;
                return accept;
            }
            if (event.text == Key.Escape) {
                root.type_ahead_requested("");
                return accept;
            }
            if (root.context_menu_visible && (event.text == "O" || event.text == "o") && !event.modifiers.control && root.selected_recyclable_count == 1) {
                root.context_menu_visible = false;
                root.row_activated(root.selected_index);
                return accept;
            }
            if (root.context_menu_visible && (event.text == "X" || event.text == "x") && !event.modifiers.control) {
                root.context_menu_visible = false;
                root.open_in_file_manager_requested(root.selected_index);
                return accept;
            }
            if (root.context_menu_visible && (event.text == "E" || event.text == "e") && !event.modifiers.control) {
                root.context_menu_visible = false;
                root.reload_requested();
                return accept;
            }
            if (root.context_menu_visible && (event.text == "M" || event.text == "m") && !event.modifiers.control && root.selected_recyclable_count == 1) {
                root.context_menu_visible = false;
                root.rename_requested(root.selected_index);
                return accept;
            }
            if (root.context_menu_visible && (event.text == "C" || event.text == "c") && !event.modifiers.control && root.selected_recyclable_count > 0) {
                root.context_menu_visible = false;
                root.copy_requested();
                return accept;
            }
            if (root.context_menu_visible && (event.text == "P" || event.text == "p") && !event.modifiers.control && root.copied_file_count > 0) {
                root.context_menu_visible = false;
                root.paste_requested();
                return accept;
            }
            if (root.context_menu_visible && (event.text == "D" || event.text == "d") && !event.modifiers.control && root.selected_recyclable_count > 0) {
                root.context_menu_visible = false;
                root.delete_requested();
                return accept;
            }
            if ((event.text == "A" || event.text == "a") && event.modifiers.control) {
                root.context_menu_visible = false;
                root.select_all_requested();
                return accept;
            }
            if ((event.text == "D" || event.text == "d") && event.modifiers.control) {
                root.context_menu_visible = false;
                if (root.selected_recyclable_count > 0) {
                    root.delete_requested();
                }
                return accept;
            }
            if (event.text == Key.Delete) {
                root.context_menu_visible = false;
                if (root.selected_recyclable_count > 0) {
                    root.delete_requested();
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.selected_index > 0) { let next = root.selected_index - 1; if (root.row_selected(next, false, false)) { root.selected_index = next; root.reveal_selected_row(); selection_scroll_timer.restart(); } }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.selected_index < root.files.length - 1) { let next = root.selected_index + 1; if (root.row_selected(next, false, false)) { root.selected_index = next; root.reveal_selected_row(); selection_scroll_timer.restart(); } }
                return accept;
            }
            if (event.text == Key.Home) {
                if (root.files.length > 0 && root.row_selected(0, false, false)) { root.selected_index = 0; root.reveal_selected_row(); selection_scroll_timer.restart(); }
                return accept;
            }
            if (event.text == Key.End) {
                if (root.files.length > 0) { let next = root.files.length - 1; if (root.row_selected(next, false, false)) { root.selected_index = next; root.reveal_selected_row(); selection_scroll_timer.restart(); } }
                return accept;
            }
            if (event.text == Key.PageUp) {
                if (root.files.length > 0) { let next = max(0, root.selected_index - max(1, floor(list.visible-height / 30px) - 1)); if (root.row_selected(next, false, false)) { root.selected_index = next; root.reveal_selected_row(); selection_scroll_timer.restart(); } }
                return accept;
            }
            if (event.text == Key.PageDown) {
                if (root.files.length > 0) { let next = min(root.files.length - 1, root.selected_index + max(1, floor(list.visible-height / 30px) - 1)); if (root.row_selected(next, false, false)) { root.selected_index = next; root.reveal_selected_row(); selection_scroll_timer.restart(); } }
                return accept;
            }
            if (event.text == Key.Return) { if (root.selected_index >= 0 && root.selected_index < root.files.length) { root.row_activated(root.selected_index); } return accept; }
            if (event.text == Key.F2) { if (root.selected_recyclable_count == 1 && root.selected_index >= 0 && root.selected_index < root.files.length) { root.rename_requested(root.selected_index); } return accept; }
            if (event.text == Key.F5) { root.reload_requested(); return accept; }
            if ((event.text == "C" || event.text == "c") && event.modifiers.control) { root.copy_requested(); return accept; }
            if ((event.text == "V" || event.text == "v") && event.modifiers.control) { root.paste_requested(); return accept; }
            if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) { root.open_folder_requested(); return accept; }
            if ((event.text == "S" || event.text == "s") && event.modifiers.control) { root.apply_requested(); return accept; }
            if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) { root.open_in_file_manager_requested(root.selected_index); return accept; }
            if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) { root.revert_requested(); return accept; }
            if ((event.text == "W" || event.text == "w") && event.modifiers.control) { root.exit_requested(); return accept; }
            if (event.text != "" && !event.modifiers.control && !event.modifiers.alt) {
                let match_index = root.type_ahead_requested(event.text);
                if (match_index >= 0 && match_index < root.files.length) {
                    if (root.row_selected(match_index, false, false)) {
                        root.selected_index = match_index;
                        selection_scroll_timer.restart();
                    }
                }
                return accept;
            }
            reject
        }
    }
}
