import { ListView } from "std-widgets.slint";
import { FileEntry } from "../types.slint";
import { HDivider } from "dividers.slint";
import { FileIcon, FolderIcon, ImageFileIcon, VideoFileIcon } from "icons.slint";
import { FontSettings } from "../theme.slint";

component IconCell inherits Rectangle {
    in property <bool> is_dir;
    in property <string> media_kind;

    width: 22px;
    height: 100%;

    if is_dir: FolderIcon { y: 4px; }
    if !is_dir && (media_kind == "jpeg" || media_kind == "png"): ImageFileIcon { y: 4px; }
    if !is_dir && media_kind == "mp4": VideoFileIcon { y: 4px; }
    if !is_dir && media_kind != "jpeg" && media_kind != "png" && media_kind != "mp4": FileIcon { y: 4px; }
}

component MenuRow inherits Rectangle {
    in property <string> title;
    in property <bool> danger;
    in property <bool> enabled;
    callback clicked();

    x: 1px;
    width: 150px;
    height: 28px;
    background: touch.has-hover && enabled ? #d9eaf7 : #f2f2f2;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text: root.title;
        font-size: FontSettings.font_size_pt * 1pt;
        color: !root.enabled ? #929292 : #202020;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component CustomFileTable inherits Rectangle {
    in property <[FileEntry]> files;
    in-out property <int> selected_index;
    in property <int> selected_file_count: 0;
    in property <int> selected_recyclable_count: 0;
    in property <int> copied_file_count: 0;
    in property <bool> mark_file_date_mismatches: false;
    in-out property <bool> context_menu_visible: false;

    callback row_selected(int, bool, bool);
    callback row_clicked(int);
    callback row_activated(int);
    callback select_all_requested();
    callback rename_requested(int);
    callback reload_requested();
    callback copy_requested();
    callback paste_requested();
    callback delete_requested();
    callback open_folder_requested();
    callback open_in_file_manager_requested();
    callback apply_requested();
    callback revert_requested();
    callback exit_requested();

    property <length> menu_x: 0px;
    property <length> menu_y: 0px;
    property <length> menu_width: 152px;
    property <bool> context_target_is_dir: root.selected_index >= 0 && root.selected_index < root.files.length && root.files[root.selected_index].is_dir;
    property <length> menu_height: root.context_target_is_dir ? 170px : 142px;

    background: #ffffff;
    forward-focus: focus_scope;

    end_scroll_timer := Timer {
        interval: 1ms;
        running: false;

        triggered => {
            self.running = false;
            list.viewport-y = min(0px, list.visible-height - list.viewport-height - 2px);
        }
    }

    background_close_area := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (root.context_menu_visible && event.kind == PointerEventKind.down) {
                root.context_menu_visible = false;
            }
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        Rectangle {
            height: 30px;
            background: #f7f9fb;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 0px;

                Rectangle { width: 22px; }
                Text { width: parent.width - 22px - media_date_header.width - size_header.width - modified_header.width - metadata_header.width - 20px; text: "Filename"; color: #37474f; font-size: FontSettings.font_size_pt * 1pt; font-weight: 600; vertical-alignment: center; overflow: elide; }
                size_header := Text { width: 78px; text: "Size"; color: #37474f; font-size: FontSettings.font_size_pt * 1pt; font-weight: 600; vertical-alignment: center; }
                modified_header := Text { width: 146px; text: "Modified"; color: #37474f; font-size: FontSettings.font_size_pt * 1pt; font-weight: 600; vertical-alignment: center; }
                media_date_header := Text { width: 150px; text: "Media Date"; color: #37474f; font-size: FontSettings.font_size_pt * 1pt; font-weight: 600; vertical-alignment: center; overflow: elide; }
                metadata_header := Text { width: 68px; text: "Metadata"; color: #37474f; font-size: FontSettings.font_size_pt * 1pt; font-weight: 600; vertical-alignment: center; horizontal-alignment: center; }
            }

            HDivider { y: parent.height - 1px; }
        }

        list := ListView {
            width: 100%;
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

            for entry[i] in files: Rectangle {
                height: 30px;
                background: entry.selected ? #dbeafe : #ffffff;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 0px;

                    IconCell { is_dir: entry.is_dir; media_kind: entry.media_kind; }
                    Text { width: parent.width - 22px - media_date_cell.width - size_cell.width - modified_cell.width - metadata_cell.width - 20px; text: entry.is_dir && entry.name != "[..]" ? "[" + entry.name + "]" : entry.name; color: entry.selected ? #0f172a : #1f2933; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; overflow: elide; }
                    size_cell := Text { width: 78px; text: entry.size; color: #4b5563; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; overflow: elide; }
                    modified_cell := Rectangle {
                        width: 146px;
                        property <bool> has_date_mismatch: root.mark_file_date_mismatches && !entry.is_dir && entry.created != "-" && entry.modified != "-" && entry.created != entry.modified;

                        Text {
                            width: modified_cell.has_date_mismatch ? parent.width - 28px : parent.width;
                            height: 100%;
                            text: entry.modified;
                            color: #4b5563;
                            font-size: FontSettings.font_size_pt * 1pt;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if modified_cell.has_date_mismatch: Text {
                            x: parent.width - 27px;
                            width: 27px;
                            height: 100%;
                            text: "(!)";
                            color: #c2410c;
                            font-size: FontSettings.font_size_pt * 1pt;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                    media_date_cell := Text { width: 150px; text: entry.media_date; color: #4b5563; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; overflow: elide; }
                    metadata_cell := Text { width: 68px; text: entry.metadata_status; color: entry.metadata_status == "!" ? #b42318 : #4b5563; font-size: FontSettings.font_size_pt * 1pt; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
                }

                TouchArea {
                    width: 100%;
                    height: 100%;

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.context_menu_visible = false;
                            root.focus();
                            root.selected_index = i;
                            root.row_selected(i, event.modifiers.control, event.modifiers.shift);
                            root.row_clicked(i);
                        }

                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                            root.focus();
                            root.selected_index = i;
                            if (!entry.selected) {
                                root.row_selected(i, false, false);
                            }
                            root.menu_x = min(root.width - root.menu_width - 1px, max(1px, self.absolute-position.x - root.absolute-position.x + self.mouse-x + 1px));
                            root.menu_y = min(root.height - root.menu_height - 1px, max(1px, self.absolute-position.y - root.absolute-position.y + self.mouse-y + 1px));
                            root.context_menu_visible = true;
                        }
                    }
                }

                HDivider { y: parent.height - 1px; background: #eef2f5; }
            }
        }
    }

    if context_menu_visible: Rectangle {
        x: root.menu_x;
        y: root.menu_y;
        width: root.menu_width;
        height: root.menu_height;
        background: #f2f2f2;
        border-width: 1px;
        border-color: #a0a0a0;
        border-radius: 0px;

        if root.context_target_is_dir: MenuRow { y: 1px; title: "Open (O)"; danger: false; enabled: true; clicked => { root.context_menu_visible = false; root.row_activated(root.selected_index); } }
        MenuRow { y: root.context_target_is_dir ? 29px : 1px; title: "Refresh (E)"; danger: false; enabled: true; clicked => { root.context_menu_visible = false; root.reload_requested(); } }
        MenuRow { y: root.context_target_is_dir ? 57px : 29px; title: "Rename (M)"; danger: false; enabled: root.selected_recyclable_count == 1; clicked => { root.context_menu_visible = false; if (root.selected_recyclable_count == 1) { root.rename_requested(root.selected_index); } } }
        MenuRow { y: root.context_target_is_dir ? 85px : 57px; title: "Copy (C)"; danger: false; enabled: root.selected_recyclable_count > 0; clicked => { root.context_menu_visible = false; if (root.selected_recyclable_count > 0) { root.copy_requested(); } } }
        MenuRow { y: root.context_target_is_dir ? 113px : 85px; title: "Paste (P)"; danger: false; enabled: root.copied_file_count > 0; clicked => { root.context_menu_visible = false; if (root.copied_file_count > 0) { root.paste_requested(); } } }
        MenuRow { y: root.context_target_is_dir ? 141px : 113px; title: "Delete (D)"; danger: false; enabled: root.selected_recyclable_count > 0; clicked => { root.context_menu_visible = false; if (root.selected_recyclable_count > 0) { root.delete_requested(); } } }
    }

    focus_scope := FocusScope {
        x: 0px;
        y: 0px;
        width: 0px;
        height: 0px;

        key-pressed(event) => {
            if (event.text == Key.Escape && root.context_menu_visible) {
                root.context_menu_visible = false;
                return accept;
            }
            if (root.context_menu_visible && (event.text == "O" || event.text == "o") && !event.modifiers.control && root.context_target_is_dir) {
                root.context_menu_visible = false;
                root.row_activated(root.selected_index);
                return accept;
            }
            if (root.context_menu_visible && (event.text == "E" || event.text == "e") && !event.modifiers.control) {
                root.context_menu_visible = false;
                root.reload_requested();
                return accept;
            }
            if (root.context_menu_visible && (event.text == "M" || event.text == "m") && !event.modifiers.control && root.selected_recyclable_count == 1) {
                root.context_menu_visible = false;
                root.rename_requested(root.selected_index);
                return accept;
            }
            if (root.context_menu_visible && (event.text == "C" || event.text == "c") && !event.modifiers.control && root.selected_recyclable_count > 0) {
                root.context_menu_visible = false;
                root.copy_requested();
                return accept;
            }
            if (root.context_menu_visible && (event.text == "P" || event.text == "p") && !event.modifiers.control && root.copied_file_count > 0) {
                root.context_menu_visible = false;
                root.paste_requested();
                return accept;
            }
            if (root.context_menu_visible && (event.text == "D" || event.text == "d") && !event.modifiers.control && root.selected_recyclable_count > 0) {
                root.context_menu_visible = false;
                root.delete_requested();
                return accept;
            }
            if ((event.text == "A" || event.text == "a") && event.modifiers.control) {
                root.context_menu_visible = false;
                root.select_all_requested();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.selected_index > 0) { root.selected_index -= 1; root.row_selected(root.selected_index, false, false); }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.selected_index < root.files.length - 1) { root.selected_index += 1; root.row_selected(root.selected_index, false, false); }
                return accept;
            }
            if (event.text == Key.Home) {
                if (root.files.length > 0) { root.selected_index = 0; root.row_selected(root.selected_index, false, false); list.viewport-y = 0px; }
                return accept;
            }
            if (event.text == Key.End) {
                if (root.files.length > 0) { root.selected_index = root.files.length - 1; root.row_selected(root.selected_index, false, false); end_scroll_timer.restart(); }
                return accept;
            }
            if (event.text == Key.PageUp) {
                if (root.files.length > 0) { root.selected_index = max(0, root.selected_index - max(1, floor(list.visible-height / 30px) - 1)); root.row_selected(root.selected_index, false, false); list.viewport-y = max(list.visible-height - list.viewport-height, min(0px, -root.selected_index * 30px)); }
                return accept;
            }
            if (event.text == Key.PageDown) {
                if (root.files.length > 0) { root.selected_index = min(root.files.length - 1, root.selected_index + max(1, floor(list.visible-height / 30px) - 1)); root.row_selected(root.selected_index, false, false); list.viewport-y = max(list.visible-height - list.viewport-height, -(root.selected_index + 1) * 30px + list.visible-height); }
                return accept;
            }
            if (event.text == Key.Return) { if (root.selected_index >= 0 && root.selected_index < root.files.length) { root.row_activated(root.selected_index); } return accept; }
            if (event.text == Key.F2) { if (root.selected_index > 0 && root.selected_index < root.files.length) { root.rename_requested(root.selected_index); } return accept; }
            if (event.text == Key.F5) { root.reload_requested(); return accept; }
            if ((event.text == "C" || event.text == "c") && event.modifiers.control) { root.copy_requested(); return accept; }
            if ((event.text == "V" || event.text == "v") && event.modifiers.control) { root.paste_requested(); return accept; }
            if ((event.text == "O" || event.text == "o") && event.modifiers.control && event.modifiers.shift) { root.open_folder_requested(); return accept; }
            if ((event.text == "S" || event.text == "s") && event.modifiers.control) { root.apply_requested(); return accept; }
            if ((event.text == "R" || event.text == "r") && event.modifiers.alt && event.modifiers.shift) { root.open_in_file_manager_requested(); return accept; }
            if ((event.text == "R" || event.text == "r") && event.modifiers.control && !event.modifiers.shift) { root.revert_requested(); return accept; }
            if ((event.text == "W" || event.text == "w") && event.modifiers.control) { root.exit_requested(); return accept; }
            reject
        }
    }
}
